<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ir_actions_report_form_inherit_iot_copies" model="ir.ui.view">
        <field name="name">ir.actions.report.form.inherit.iot.copies</field>
        <field name="model">ir.actions.report</field>
        <field name="inherit_id" ref="base.act_report_xml_view"/>
        <field name="arch" type="xml">
            
            <!-- Fügt das Feld unter dem Papierformat ein -->
            <xpath expr="//field[@name='paperformat_id']" position="after">
                <field name="iot_print_copies" />
            </xpath>
            
        </field>
    </record>
</odoo>
