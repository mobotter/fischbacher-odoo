<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_order_tree_internal_demand" model="ir.ui.view">
        <field name="name">sale.order.list.internal.demand</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="is_internal_demand" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_internal_demand" model="ir.ui.view">
        <field name="name">sale.order.form.internal.demand</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">
                <field name="is_internal_demand" invisible="1"/>

                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="not is_internal_demand"
                >
                    <strong>Monatsregel:</strong>
                    Für den Eigenbedarf bitte ein Angebot pro Monat erstellen.
                </div>
            </xpath>

            <xpath
                expr="//page[@name='order_lines']//field[@name='order_line']/list"
                position="attributes"
            >
                <attribute name="limit">20</attribute>
            </xpath>

        </field>
    </record>

    <record id="action_internal_demand" model="ir.actions.act_window">
        <field name="name">Eigenbedarf</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_internal_demand', '=', True)]</field>
        <field name="context">{'default_is_internal_demand': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Eigenbedarfsbeleg anlegen
            </p>
            <p>
                Eigenbedarf ist ein Kennzeichen auf einem bestehenden
                Verkaufsbeleg. Preise, Mengen, Positionen und Kalkulationen
                folgen der normalen Odoo-Logik.
            </p>
        </field>
    </record>

    <record id="action_internal_demand_tree_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_order_tree_internal_demand"/>
        <field name="act_window_id" ref="action_internal_demand"/>
    </record>

    <record id="action_internal_demand_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_order_form_internal_demand"/>
        <field name="act_window_id" ref="action_internal_demand"/>
    </record>

    <menuitem
        id="menu_internal_demand"
        name="Eigenbedarf"
        parent="sale.sale_order_menu"
        action="action_internal_demand"
        sequence="25"
    />

    <record id="action_convert_to_internal_demand" model="ir.actions.server">
        <field name="name">In Eigenbedarf umwandeln</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">
action = records.action_convert_to_internal_demand()
        </field>
    </record>

    <record id="action_convert_to_quotation" model="ir.actions.server">
        <field name="name">Zurück in Angebot umwandeln</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">
action = records.action_convert_to_quotation()
        </field>
    </record>

</odoo>
