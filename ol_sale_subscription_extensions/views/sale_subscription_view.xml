<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_subscription_form_inherit" model="ir.ui.view">
        <field name="name">sale.subscription.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="priority">99</field>
        <field name="arch" type="xml">
        
        <!-- 1. WICHTIG: Das Feld in die View laden, sonst funktioniert die Bedingung nicht -->
            <xpath expr="//sheet" position="inside">
                <field name="is_subscription" invisible="1"/>
            </xpath>

            <!-- ==============================================
                 1. DATUM-AUSBLENDUNG (aus deiner sale_order.xml)
                 ============================================== -->
            <xpath expr="//field[@name='date_order']" position="attributes">
                <attribute name="invisible">state in ["sale", "cancel", "accept"]</attribute>
            </xpath>
            <xpath expr="//div[hasclass('o_td_label')]/label[@for='date_order']" position="attributes">
                <attribute name="invisible">state in ["sale", "cancel", "accept"]</attribute>
            </xpath>

            <!-- ==============================================
                 2. HEADER BUTTONS - Nur in Subscriptions
                 ============================================== -->
            <xpath expr="//header" position="inside">
                <!-- Confirm Button: Nur bei Status 'accept' UND nur im Abo -->
                <button name="action_confirm" data-hotkey="q"
                    string="Confirm" type="object" context="{'validate_analytic': True}"
                    invisible="state != 'accept' or not is_subscription"/>
                
                <!-- Accepted by Client Button: Nur bei draft/sent UND nur im Abo -->
                <button
                    name="action_accept_by_client"
                    type="object"
                    string="Accepted by Client"
                    class="btn-primary"
                    invisible="state not in ('draft', 'sent') or not is_subscription" 
                />
                
                <!-- Reset Button: Nur bei Status 'accept' UND nur im Abo -->
                <button
                    name="action_reset_to_quotation"
                    type="object"
                    string="Reset to Quotation"
                    class="btn-primary"
                    invisible="state != 'accept' or not is_subscription"
                />
                
                <!-- Mail Button: Nur bei sent/sale/draft UND nur im Abo -->
                <button 
                    name="action_quotation_send_subscription" 
                    id="send_by_email_subscription" 
                    string="Quotation send by email" 
                    class="btn-primary"
                    type="object" 
                    invisible="state not in ('sent', 'sale', 'draft') or not is_subscription" 
                    data-hotkey="g" 
                    context="{'validate_analytic': True, 'check_document_layout': True}"/>
            </xpath>

            <!-- ==============================================
                 3. QUOTATION LINES TAB - Nur in Subscriptions
                 ============================================== -->
             <xpath expr="//page[@name='order_lines']" position="before">
                <page name="quatation_page" string="Angebotspositionen" invisible="not is_subscription">
                    <!-- Dein restlicher Code für quotation_line_ids -->
                    <field name="quotation_line_ids" widget="section_and_note_one2many" mode="list,kanban" readonly="state == 'cancel' or locked">
                        <list editable="bottom" limit="200">
                            <control>
                                <create name="add_product_control" string="Add a product"/>
                                <create name="add_section_control" string="Add a section" context="{'default_display_type': 'line_section'}"/>
                                <create name="add_note_control" string="Add a note" context="{'default_display_type': 'line_note'}"/>
                            </control>
                            <field name="sequence" widget="handle"/>
                            <field name="display_type" column_invisible="True"/>
                            <field name="product_id" required="not display_type" options="{'no_open': True}" force_save="1" widget="many2one"/>
                            <field name="name"/>
                            <field name="product_uom_qty"/>
                            <field name="product_uom"/>
                            <field name="price_unit"/>
                            <field name="discount"/>
                            <field name="tax_id" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="price_subtotal" readonly="1"/>
                        </list>
                    </field>
                </page>
            </xpath>


            
        </field>
    </record>
</odoo>
