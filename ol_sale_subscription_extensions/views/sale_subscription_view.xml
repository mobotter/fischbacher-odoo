<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================== -->
    <!-- 1. ANPASSUNG DER FORMULARANSICHT (FORM VIEW)   -->
    <!-- ============================================== -->
    <record id="sale_subscription_form_inherit" model="ir.ui.view">
        <field name="name">sale.subscription.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="priority">99</field>
        <field name="arch" type="xml">
            
            <!-- Feld laden, damit die invisible-Bedingungen auf "is_subscription" reagieren können -->
            <xpath expr="//sheet" position="inside">
                <field name="is_subscription" invisible="1"/>
            </xpath>

            <!-- ================= HEADER BUTTONS ================= -->
            <xpath expr="//header" position="inside">
                <!-- Confirm Button: Sichtbar, wenn das Abo akzeptiert wurde UND es ein Abo ist -->
                <button name="action_confirm" data-hotkey="q"
                    string="Confirm" type="object" context="{'validate_analytic': True}"
                    invisible="subscription_state != '5_accepted' or not is_subscription"/>
                
                <!-- Accept Button: Sichtbar im Draft/Renewal Status UND wenn es ein Abo ist -->
                <button
                    name="action_accept_by_client"
                    type="object"
                    string="Accepted by Client"
                    class="btn-primary"
                    invisible="subscription_state not in ('1_draft', '2_renewal') or not is_subscription" 
                />
                
                <!-- Reset Button: Sichtbar, wenn das Abo akzeptiert wurde UND es ein Abo ist -->
                <button
                    name="action_reset_to_quotation"
                    type="object"
                    string="Reset to Quotation"
                    class="btn-primary"
                    invisible="subscription_state != '5_accepted' or not is_subscription"
                />
                
                <!-- Mail Button -->
                <button 
                    name="action_quotation_send_subscription" 
                    id="send_by_email_subscription" 
                    string="Quotation send by email" 
                    class="btn-primary"
                    type="object" 
                    invisible="state not in ('sent', 'sale', 'draft') or not is_subscription" 
                    data-hotkey="g" 
                    context="{'validate_analytic': True, 'check_document_layout': True}"/>
            </xpath>

            <!-- ================= NOTEBOOK TAB ================= -->
            <xpath expr="//page[@name='order_lines']" position="before">
                <!-- Verstecke den Tab komplett in normalen Sales Orders -->
                <page name="quatation_page" string="Angebotspositionen" invisible="not is_subscription">
                    <field name="quotation_line_ids" widget="section_and_note_one2many" mode="list,kanban" readonly="state == 'cancel' or locked">
                        <list editable="bottom" limit="200">
                            <control>
                                <create name="add_product_control" string="Add a product"/>
                                <create name="add_section_control" string="Add a section" context="{'default_display_type': 'line_section'}"/>
                                <create name="add_note_control" string="Add a note" context="{'default_display_type': 'line_note'}"/>
                            </control>
                            <field name="sequence" widget="handle"/>
                            <field name="display_type" column_invisible="True"/>
                            <field name="product_id" required="not display_type" options="{'no_open': True}" force_save="1" widget="many2one"/>
                            <field name="name"/>
                            <field name="product_uom_qty"/>
                            <field name="product_uom"/>
                            <field name="price_unit"/>
                            <field name="discount"/>
                            <field name="tax_id" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="price_subtotal" readonly="1"/>
                        </list>
                    </field>
                    <group name="note_group" col="6" class="mt-2 mt-md-0">
                        <group colspan="4" class="order-1 order-lg-0" col="6">
                            <field colspan="2" name="note" nolabel="1" placeholder="Terms and conditions..."/>
                        </group>
                        <group col="6">
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

        <!-- ============================================== -->
    <!-- 2. ANPASSUNG DER LISTENANSICHT (TREE VIEW)     -->
    <!-- ============================================== -->
    <record id="sale_subscription_tree_inherit" model="ir.ui.view">
        <field name="name">sale.subscription.tree.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_view_tree"/>
        <field name="arch" type="xml">
            
            <!-- Badge-Widget mit Colors konfigurieren -->
            <xpath expr="//field[@name='subscription_state']" position="attributes">
                <!-- Die bestehenden Attribute bleiben (widget="badge"), aber wir fügen die options hinzu -->
                <attribute name="options">{'color_field': 'color', 'custom_colors': {'5_accepted': 'success', '3_progress': 'success', '4_paused': 'warning', '6_churn': 'danger', '1_draft': 'info'}}</attribute>
            </xpath>

        </field>
    </record>

</odoo>
