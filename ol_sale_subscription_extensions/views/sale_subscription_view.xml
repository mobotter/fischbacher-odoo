<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_subscription_form_inherit_v2" model="ir.ui.view">
        <field name="name">sale.subscription.form.inherit_v2</field>
        <field name="model">sale.order</field>
        <!-- Wir erben direkt vom Standard-Verkaufsauftrag -->
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <!-- Stellt sicher, dass das Feld für die invisible-Bedingung geladen ist -->
            <xpath expr="//sheet" position="inside">
                <field name="is_subscription" invisible="1"/>
            </xpath>

            <!-- ==============================================
                 1. DATUM-AUSBLENDUNG (aus deiner sale_order.xml)
                 ============================================== -->
            <xpath expr="//field[@name='date_order']" position="attributes">
                <attribute name="invisible">state in ["sale", "cancel", "accept"]</attribute>
            </xpath>
            <xpath expr="//div[hasclass('o_td_label')]/label[@for='date_order']" position="attributes">
                <attribute name="invisible">state in ["sale", "cancel", "accept"]</attribute>
            </xpath>

            <!-- ==============================================
                 2. HEADER BUTTONS - Nur in Subscriptions
                 ============================================== -->
            <!-- Wir setzen unsere Buttons exakt VOR den ersten Odoo Confirm Button -->
            <xpath expr="//header/button[@name='action_confirm'][1]" position="before">
                
                <!-- Durch das "or not is_subscription" wird der Button im normalen Verkauf versteckt -->
                <button name="action_accept_by_client" 
                        type="object"
                        string="Accepted by Client" 
                        class="btn-primary"
                        invisible="state not in ('draft', 'sent') or not is_subscription" />
                
                <button name="action_reset_to_quotation" 
                        type="object"
                        string="Reset to Quotation" 
                        invisible="state != 'accept' or not is_subscription"/>
                        
                <button name="action_confirm" 
                        data-hotkey="q"
                        string="Confirm" 
                        type="object" 
                        context="{'validate_analytic': True}"
                        invisible="state != 'accept' or not is_subscription"/>
                
                <button name="action_quotation_send_subscription" 
                        id="send_by_email_subscription" 
                        string="Quotation send by email" 
                        class="btn-primary"
                        type="object" 
                        invisible="state not in ('sent', 'sale', 'draft') or not is_subscription" 
                        data-hotkey="g" 
                        context="{'validate_analytic': True, 'check_document_layout': True}"/>
            </xpath>

            <!-- ==============================================
                 3. QUOTATION LINES TAB - Nur in Subscriptions
                 ============================================== -->
                        <!-- 1. Wir platzieren den Tab ganz normal im Notebook und geben ihm die allererste Sequenz -->
            <xpath expr="//notebook" position="inside">
                <page name="quatation_page" string="Angebotspositionen" sequence="1">
                    <field name="quotation_line_ids" widget="section_and_note_one2many" mode="list,kanban" readonly="state == 'cancel' or locked">
                        <list editable="bottom" limit="200">
                            <control>
                                <create name="add_product_control" string="Add a product"/>
                                <create name="add_section_control" string="Add a section" context="{'default_display_type': 'line_section'}"/>
                                <create name="add_note_control" string="Add a note" context="{'default_display_type': 'line_note'}"/>
                            </control>
                            <field name="sequence" widget="handle"/>
                            <field name="display_type" column_invisible="True"/>
                            <field name="product_id" required="not display_type" options="{'no_open': True}" force_save="1" widget="many2one"/>
                            <field name="name"/>
                            <field name="product_uom_qty"/>
                            <field name="product_uom"/>
                            <field name="price_unit"/>
                            <field name="discount"/>
                            <field name="tax_id" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="price_subtotal" readonly="1"/>
                        </list>
                    </field>
                    <group name="note_group" col="6" class="mt-2 mt-md-0">
                        <group colspan="4" class="order-1 order-lg-0" col="6">
                            <field colspan="2" name="note" nolabel="1" placeholder="Terms and conditions..."/>
                        </group>
                        <group col="6">
                        </group>
                    </group>
                </page>
            </xpath>

            <!-- 2. Wir schieben die Standard-Auftragspositionen (Order Lines) auf Sequenz 20 (also nach rechts) -->
            <xpath expr="//notebook/page[@name='order_lines']" position="attributes">
                <attribute name="sequence">20</attribute>
            </xpath>
            
            <!-- 3. (Optional) Falls die anderen Tabs immer noch dazwischen grätschen, zwingen wir sie nach hinten -->
            <xpath expr="//notebook/page[@name='other_information']" position="attributes">
                <attribute name="sequence">30</attribute>
            </xpath>
            <xpath expr="//notebook/page[@name='customer_signature']" position="attributes">
                <attribute name="sequence">40</attribute>
            </xpath>

            
        </field>
    </record>
</odoo>
