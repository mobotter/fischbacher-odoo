<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_template_view_form_inherit_price_unit" model="ir.ui.view">
        <field name="name">sale.order.template.form.inherit.price.unit</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_order_template_line_ids']/list/field[@name='product_uom_qty']" position="after">
                <field name="price_unit"/>
            </xpath>
        </field>
    </record>
</odoo>
