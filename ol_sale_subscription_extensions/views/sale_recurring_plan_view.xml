<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_subscription_plan_form_inherit_billing_timing" model="ir.ui.view">
        <field name="name">sale.subscription.plan.form.inherit.billing.timing</field>
        <field name="model">sale.subscription.plan</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_plan_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='billing_period_value']" position="after">
                <field name="billing_timing"/>
            </xpath>
        </field>
    </record>
</odoo>
