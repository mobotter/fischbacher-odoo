<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_subscription_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.subscription.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//form[1]/sheet[1]/group[@name='sale_header']/group[@name='order_details']/field[@name='date_order']" position="attributes">
                <attribute name="invisible">state in ["sale", "cancel", "accept"]</attribute>
            </xpath>
            <xpath expr="//form[1]/sheet[1]/group[@name='sale_header']/group[@name='order_details']/div[@class='o_td_label']" position="attributes">
                <attribute name="invisible">state in ["sale", "cancel", "accept"]</attribute>
            </xpath>
        </field>
    </record>
</odoo>