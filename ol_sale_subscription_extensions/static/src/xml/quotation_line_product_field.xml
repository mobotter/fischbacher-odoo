<t t-name="ol_sale_subscription_extensions.QuotationLineProductField">
    <div class="o_field_product_label_section_and_note_cell">
        <div class="d-flex align-items-center gap-1">
            <div class="o_many2one w-100">
                <t t-call="web.Many2OneField"/>
            </div>
        </div>

        <textarea
            t-if="!props.record.data.display_type"
            class="o_input d-print-none border-0 fst-italic"
            placeholder="Eine Beschreibung eingeben"
            rows="1"
            t-att-value="props.record.data.name or ''"
            t-on-input="onDescriptionInput"
        />
    </div>
</t>
