        <div class="d-flex align-items-center gap-1 w-100">
            <div class="flex-grow-1 min-w-0">
                <t t-call="web.Many2OneField"/>
            </div>

            <button
                t-if="hasDescriptionButton"
                type="button"
                class="btn btn-link p-0 lh-1 flex-shrink-0"
