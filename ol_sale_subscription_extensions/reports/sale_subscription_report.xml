<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_subscription_report_new">
        <t t-foreach="docs" t-as="doc">
            <t t-call="ol_invoice_report_changes.external_layout_for_invoice">
                <main>
                    <div class="page">

                        <table style="width:100%; border-collapse:collapse; border:none; margin-top:10mm;">
                            <tr style="border:none;">
                                <td style="border:none; width:50%;vertical-align:top;height:45mm;max-height:45mm;overflow:hidden;font-size:13px;">
                                    <div style="margin-top:5mm;">
                                        <div style="font-size:10.5px; margin-bottom:4px; border-bottom:1px solid #ccc;">
                                            <span t-field="doc.company_id.name"/> |
                                            <span t-field="doc.company_id.street"/> |
                                            <span t-field="doc.company_id.zip"/>
                                            <span t-field="doc.company_id.city"/>
                                        </div>
                                        <strong>
                                            <span t-field="doc.partner_id.name"/>
                                        </strong><br/>
                                        <span t-field="doc.partner_id.street"/><br/>
                                        <t t-if="doc.partner_id.street2">
                                            <span t-field="doc.partner_id.street2"/><br/>
                                        </t>
                                        <span t-field="doc.partner_id.zip"/>
                                        <span t-field="doc.partner_id.city"/><br/>
                                        <span t-field="doc.partner_id.country_id.name"/>
                                    </div>
                                </td>

                                <td style="border:none; width:45%;vertical-align:top;padding-left:15mm;line-height:1.5;">
                                    <table style="width:100%; border-collapse:collapse; border:none;">
                                        <t t-if="doc.name">
                                            <tr style="border:none;">
                                                <td style="border:none; width:55%;font-size:13px;">Order Number:</td>
                                                <td style="border:none; font-size:13px;padding-left:3px;"><span t-field="doc.name"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.date_order">
                                            <tr style="border:none;">
                                                <td style="border:none; font-size:13px;">Order Date:</td>
                                                <td style="border:none; font-size:13px;padding-left:3px;">
                                                    <span t-field="doc.date_order" t-options="{'widget': 'date', 'format': 'dd.MM.yyyy'}"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.validity_date">
                                            <tr style="border:none;">
                                                <td style="border:none; font-size:13px;">Validity Date:</td>
                                                <td style="border:none; font-size:13px;padding-left:3px;">
                                                    <span t-field="doc.validity_date" t-options="{'widget': 'date', 'format': 'dd.MM.yyyy'}"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.partner_id.ref">
                                            <tr style="border:none;">
                                                <td style="border:none; font-size:13px;">Client Number:</td>
                                                <td style="border:none; font-size:13px;padding-left:3px;"><span t-field="doc.partner_id.ref"/></td>
                                            </tr>
                                        </t>
                                        <t t-else="">
                                            <tr style="border:none;">
                                                <td style="border:none; font-size:13px;">Client Number:</td>
                                                <td style="border:none; font-size:13px;padding-left:3px;"><span t-field="doc.partner_id.id"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.client_order_name">
                                            <tr style="border:none;">
                                                <td style="border:none; font-size:13px;">Ordered By:</td>
                                                <td style="border:none; font-size:13px;padding-left:3px;"><span t-field="doc.client_order_name"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.client_order_number">
                                            <tr style="border:none;">
                                                <td style="border:none; font-size:13px;">Your Order Number:</td>
                                                <td style="border:none; font-size:13px;padding-left:3px;"><span t-field="doc.client_order_number"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.lease_agreement_no">
                                            <tr style="border:none;">
                                                <td style="border:none; font-size:13px;">Lease Agreement No.:</td>
                                                <td style="border:none; font-size:13px;padding-left:3px;"><span t-field="doc.lease_agreement_no"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.carrier_id">
                                            <tr style="border:none;">
                                                <td style="border:none; font-size:13px;">Shipping Method:</td>
                                                <td style="border:none; font-size:13px;padding-left:3px;"><span t-field="doc.carrier_id.name"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.incoterm">
                                            <tr style="border:none;">
                                                <td style="border:none; font-size:13px;">Delivery Terms:</td>
                                                <td style="border:none; font-size:13px;padding-left:3px;"><span t-field="doc.incoterm.name"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.user_id.name">
                                            <tr style="border:none;">
                                                <td style="border:none; font-size:13px;">Salesperson:</td>
                                                <td style="border:none; font-size:13px;padding-left:3px;"><span t-field="doc.user_id.name"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.user_id.phone">
                                            <tr style="border:none;">
                                                <td style="border:none; font-size:13px;">Phone:</td>
                                                <td style="border:none; font-size:13px;padding-left:3px;"><span t-field="doc.user_id.phone"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.user_id.login">
                                            <tr style="border:none;">
                                                <td style="border:none; font-size:13px;">Email:</td>
                                                <td style="border:none; font-size:13px;padding-left:3px;"><span t-field="doc.user_id.login"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.client_order_ref">
                                            <tr style="border:none;">
                                                <td style="border:none; font-size:13px;vertical-align:top;">Project:</td>
                                                <td style="border:none; font-size:13px;padding-left:3px;white-space:normal;word-wrap:break-word;word-break:break-word;vertical-align:top;">
                                                    <span t-field="doc.client_order_ref"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- Titel: immer Rental, State entscheidet Quote vs Order -->
                        <h2 style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">
                            <t t-if="doc.state in ('draft', 'sent')">Rental Quote</t>
                            <t t-else="">Rental Order</t>
                        </h2>

                        <t t-set="display_discount" t-value="any(l.discount > 0 for l in doc.quotation_line_ids)"/>

                        <table style="width:100%; border-collapse:collapse; border:none; font-size:12px;">
                            <thead>
                                <tr style="border:none;">
                                    <th colspan="3" style="border:none; text-align:left; font-size:12px; font-weight:600; padding:6px 0;">
                                        <t t-if="doc.plan_id">
                                            Rental price / <span t-field="doc.plan_id.name"/>
                                        </t>
                                    </th>
                                    <th colspan="4" style="border:none; text-align:right; font-size:12px; font-weight:600;">
                                        Order Number: <span t-field="doc.name"/>
                                    </th>
                                </tr>
                                <tr style="border:none; border-bottom:1px solid #ccc;">
                                    <th style="border:none; width:5%; text-align:left;font-size:14px;">Pos.</th>
                                    <th style="border:none; width:45%; text-align:left;font-size:14px;">Description</th>
                                    <th style="border:none; width:15%; text-align:right;font-size:14px;">Quantity</th>
                                    <th style="border:none; width:12%; text-align:right;font-size:14px;">Unit Price</th>
                                    <th style="border:none; width:10%; text-align:right;font-size:14px;" t-if="display_discount">Disc.%</th>
                                    <th style="border:none; width:13%; text-align:right;font-size:14px;">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="pos" t-value="0"/>
                                <t t-foreach="doc.quotation_line_ids" t-as="line">
                                    <tr style="border:none; border-bottom:1px solid #e0e0e0;">
                                        <t t-if="not line.display_type">
                                            <t t-set="pos" t-value="pos + 1"/>
                                            <td style="border:none; font-size:14px;"><t t-out="pos"/></td>
                                            <td style="border:none; white-space:normal;font-size:14px;word-wrap:break-word;word-break:break-word;max-width:20px;padding-top:7px;padding-bottom:7px;">
                                                <span t-field="line.product_id.display_name"/><br/>
                                                <span t-field="line.product_id.description"/>
                                            </td>
                                            <td style="border:none; text-align:right;font-size:14px;">
                                                <span t-field="line.product_uom_qty"/>
                                                <span t-field="line.product_uom.name"/>
                                            </td>
                                            <td style="border:none; text-align:right;font-size:14px;">
                                                <span t-field="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                            </td>
                                            <td t-if="display_discount" style="border:none; text-align:right;font-size:14px;">
                                                <span t-field="line.discount"/>%
                                            </td>
                                            <td style="border:none; text-align:right;font-size:14px;">
                                                <span t-field="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                            </td>
                                        </t>
                                        <t t-elif="line.display_type == 'line_section'">
                                            <td colspan="99" style="border:none; background-color:#D3D3D3;font-weight:bold;white-space:normal;font-size:14px;word-wrap:break-word;word-break:break-word;max-width:20px;padding-top:7px;padding-bottom:7px;">
                                                <span t-field="line.name"/>
                                            </td>
                                        </t>
                                        <t t-elif="line.display_type == 'line_note'">
                                            <td colspan="99" style="border:none; font-style:italic;white-space:normal;font-size:14px;word-wrap:break-word;word-break:break-word;max-width:20px;padding-top:7px;padding-bottom:7px;">
                                                <span t-field="line.name"/>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <table style="margin-top:4mm;font-size:12px;line-height:1.2;width:100%;border:none;page-break-inside:avoid;">
                            <tr style="border:none;">
                                <td style="border:none; width:60%;vertical-align:top;">
                                    <div style="white-space:normal;font-size:12px;word-wrap:break-word;word-break:break-word;max-width:100%;">
                                        <div>Ex works, conditions as described above, subject to prior sale, plus statutory VAT.</div>
                                        <div>Agreements exist that may result in subsequent reductions of the final price.</div>
                                    </div>
                                    <br/>
                                    <div style="font-size:12px;">
                                        Payment Terms:
                                        <div><span t-field="doc.payment_term_id.name"/></div>
                                    </div>
                                    <div style="font-size:12px;">
                                        <t t-if="doc.note">
                                            <span t-field="doc.note"/>
                                        </t>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <div class="oe_structure" style="page-break-inside:avoid;"> </div>

                    </div>
                </main>
            </t>
        </t>
    </template>
</odoo>
