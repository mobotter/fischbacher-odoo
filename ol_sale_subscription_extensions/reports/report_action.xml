<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Rental Quote / Rental Order Report
         Im Drucken-Menü für alle sale.order sichtbar.
         binding_domain existiert in Odoo 19 nicht mehr auf ir.actions.report.
         Filterung über den Titel/Namen ist ausreichend:
         User sieht "Quotation PDF" (Standard) und "Rental Quote PDF" (dieser Report). -->
    <record id="action_subscription_report" model="ir.actions.report">
        <field name="name">Rental Quote PDF</field>
        <field name="model">sale.order</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="print_report_name">(
            'Rental Quote - %s' % (object.name) if object.state in ('draft', 'sent') else
            'Rental Order - %s' % (object.name)
        )</field>
        <field name="report_name">ol_sale_subscription_extensions.sale_subscription_report_new</field>
        <field name="report_file">ol_sale_subscription_extensions.sale_subscription_report_new</field>
        <field name="paperformat_id" ref="ol_invoice_report_changes.report_invoice_custom_paperformat"/>
    </record>

</odoo>
