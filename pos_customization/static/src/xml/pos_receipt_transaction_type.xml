<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_customization.OrderReceiptFooter"
       t-inherit="point_of_sale.OrderReceipt"
       t-inherit-mode="extension">

        <xpath expr="//div[hasclass('footer-powered-by')]" position="replace">

            <div class="pos-receipt-transaction-type">
                <t t-if="order.has_rental">
                    MIETE
                </t>
                <t t-else="">
                    VERKAUF
                </t>
            </div>

        </xpath>

    </t>

</templates>
