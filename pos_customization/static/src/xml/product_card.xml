<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
<!-- TASK ID: 51581 -->
    <t t-name="pos_customization.ProductCard"
       t-inherit="point_of_sale.ProductCard"
       t-inherit-mode="extension">

        <!-- Neuer, robuster XPath für Odoo POS -->
        <xpath expr="//div[hasclass('product-name')]" position="after">
      
            <!--  Add product default code -->
            <div t-if="props.product.default_code" class="mt-1 text-muted" style="font-size: 0.9em; text-align:center;">
                <t t-esc="props.product.default_code"/>
            </div>
        </xpath>

    </t>
