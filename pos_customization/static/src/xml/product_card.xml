<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
<!-- TASK ID: 51581 -->
    <t t-name="pos_customization.ProductCard"
       t-inherit="point_of_sale.ProductCard"
       t-inherit-mode="extension">

        <xpath expr="//div[hasclass('product-name')]" position="before">
      
            <!--  w-100 erzwingt einen Zeilenumbruch, d-block macht es zum Block-Element -->
            <div t-if="props.product.default_code" class="w-100 d-block text-muted px-2 pt-1" style="font-size: 0.85em; text-align: left; line-height: 1;">
                <t t-esc="props.product.default_code"/>
            </div>
            
        </xpath>

    </t>
<!-- TASK ID: 51581 -->
</templates>
