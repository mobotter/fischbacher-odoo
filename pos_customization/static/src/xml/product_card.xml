<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
<!-- TASK ID: 51581 -->
    <t t-name="pos_customization.ProductCard"
       t-inherit="point_of_sale.ProductCard"
       t-inherit-mode="extension">

        <!-- Änderung: position="before" statt "after" -->
        <xpath expr="//div[hasclass('product-name')]" position="before">
      
            <!--  Add product default code -->
            <div t-if="props.product.default_code" class="mb-1 text-muted" style="font-size: 0.85em; text-align:center; font-weight: bold;">
                <t t-esc="props.product.default_code"/>
            </div>
            
        </xpath>

    </t>
<!-- TASK ID: 51581 -->
</templates>
