<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_customization.OrderlineReceiptProductInfo"
       t-inherit="point_of_sale.Orderline"
       t-inherit-mode="extension">

        <xpath expr="//ul[hasclass('info-list')]" position="inside">

            <t t-set="product" t-value="line.product_id || line.product"/>

            <li t-if="product and product.default_code"
                class="pos-receipt-default-code">
                Artikelnr.: <t t-esc="product.default_code"/>
            </li>

            <li t-if="product and product.pos_rent_ok"
                class="pos-receipt-rental-product">
                (Mietartikel)
            </li>

        </xpath>

    </t>

</templates>
