<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_customization.ControlButtons"
       t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">

        <xpath expr="//div[hasclass('control-buttons-modal')]" position="inside">
            <button class="btn btn-secondary btn-lg py-5" t-on-click="openDrawer">
                <i class="fa fa-expand me-1" role="img"/> Kasse öffnen
            </button>
        </xpath>

    </t>
</templates>
