<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_customization.ControlButtons"
       t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">
        
        <!-- Dein existierender XPath -->
        <xpath expr="//div[contains(@class, 'control-buttons-modal')]" position="inside">
            <!-- Korrekte OWL Event-Syntax (ohne this. und als direkte Referenz) -->
            <button class="btn btn-secondary btn-lg py-5" t-on-click="openDrawer">
                <i class="fa fa-expand me-1" role="img" /> Kasse öffnen
            </button>
        </xpath>
        
    </t>
</templates>
