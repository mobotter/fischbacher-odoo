<odoo>
    <data>

        <record id="view_res_partner_search_prefix" model="ir.ui.view">
            <field name="name">res.partner.search.prefix</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_res_partner_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <field name="name" string="Unternehmen" filter_domain="[('name', '=ilike', self + '%')]"/>
                    <field name="ref" string="Referenz" filter_domain="[('ref', '=ilike', self + '%')]"/>
                    <field name="email" string="E-Mail" filter_domain="[('email', '=ilike', self + '%')]"/>
                    <field name="phone" string="Telefon" filter_domain="[('phone', '=ilike', self + '%')]"/>
                    <field name="mobile" string="Mobil" filter_domain="[('mobile', '=ilike', self + '%')]"/>
                </xpath>
            </field>
        </record>

        <record id="view_product_template_search_prefix" model="ir.ui.view">
            <field name="name">product.template.search.prefix</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_search_view"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <field name="name" string="Produkt" filter_domain="[('name', '=ilike', self + '%')]"/>
                    <field name="default_code" string="Interne Referenz" filter_domain="[('default_code', '=ilike', self + '%')]"/>
                    <field name="barcode" string="Barcode" filter_domain="[('barcode', '=ilike', self + '%')]"/>
                    <field name="description_sale" string="Verkaufsbeschreibung" filter_domain="[('description_sale', '=ilike', self + '%')]"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
