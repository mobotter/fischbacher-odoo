<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Partner-Suche (global): unverändert – alle Partner durchsuchbar -->
        <record id="view_res_partner_search_contains" model="ir.ui.view">
            <field name="name">res.partner.search.contains</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_res_partner_filter"/>
            <field name="priority" eval="100"/>
            <field name="arch" type="xml">
                <xpath expr="//search/field[@name='name'][1]" position="replace">
                    <field name="name"
                           string="Unternehmen"
                           filter_domain="[('name', '=ilike', '%' + self + '%')]"/>
                </xpath>

                <xpath expr="//search" position="inside">
                    <field name="ref"
                           string="Referenz"
                           filter_domain="[('ref', '=ilike', '%' + self + '%')]"/>
                    <field name="short_term"
                           string="Kurzbegriff"
                           filter_domain="[('short_term', '=ilike', '%' + self + '%')]"/>
                    <field name="street"
                           string="Straße"
                           filter_domain="[('street', '=ilike', '%' + self + '%')]"/>
                    <field name="city"
                           string="Ort"
                           filter_domain="[('city', '=ilike', '%' + self + '%')]"/>
                </xpath>
            </field>
        </record>

        <!-- Verkaufsauftrag Formular: partner_id nur auf Hauptpartner (parent_id = False) -->
        <record id="view_order_form_partner_parent_filter" model="ir.ui.view">
            <field name="name">sale.order.form.partner.parent.filter</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="domain">[('parent_id', '=', False)]</attribute>
                </xpath>
            </field>
        </record>

        <!-- Verkaufsauftrag Liste: partner_id nur auf Hauptpartner (parent_id = False) -->
        <record id="view_order_tree_partner_parent_filter" model="ir.ui.view">
            <field name="name">sale.order.tree.partner.parent.filter</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="domain">[('parent_id', '=', False)]</attribute>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
