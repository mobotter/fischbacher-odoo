<odoo>
    <data>

        <record id="view_res_partner_search_prefix" model="ir.ui.view">
            <field name="name">res.partner.search.prefix</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_res_partner_filter"/>
            <field name="priority" eval="100"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <field name="name" string="Unternehmen" filter_domain="[('name', '=ilike', self + '%')]"/>
                    <field name="ref" string="Referenz" filter_domain="[('ref', '=ilike', self + '%')]"/>
                    <field name="short_term" string="Kurzbegriff" filter_domain="[('short_term', '=ilike', self + '%')]"/>
                    <field name="street" string="Straße" filter_domain="[('street', '=ilike', self + '%')]"/>
                    <field name="city" string="Ort" filter_domain="[('city', '=ilike', self + '%')]"/>
                </xpath>
            </field>
        </record>

        <record id="view_product_template_search_prefix" model="ir.ui.view">
            <field name="name">product.template.search.prefix</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_search_view"/>
            <field name="priority" eval="100"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <field name="name" string="Produkt" filter_domain="['|', '|', '|', ('default_code', '=ilike', self + '%'), ('name', '=ilike', self + '%'), ('barcode', '=ilike', self + '%'), ('description_sale', '=ilike', self + '%')]"/>
                </xpath>
            </field>
        </record>

        <record id="view_product_product_search_prefix" model="ir.ui.view">
            <field name="name">product.product.search.prefix</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_search_form_view"/>
            <field name="priority" eval="100"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <field name="name" string="Produktvariante" filter_domain="['|', '|', '|', '|', '|', ('default_code', '=ilike', self + '%'), ('name', '=ilike', self + '%'), ('barcode', '=ilike', self + '%'), ('description_sale', '=ilike', self + '%'), ('search_term', '=ilike', self + '%'), ('short_term', '=ilike', self + '%')]"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
