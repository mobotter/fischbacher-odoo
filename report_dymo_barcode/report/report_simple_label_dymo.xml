<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         EINSTIEGSPUNKT-TEMPLATES
         KEIN web.html_container – stattdessen vollständiges HTML-Gerüst
         selbst geschrieben, damit @page CSS nicht von Odoo überschrieben
         wird. Das ist die einzig zuverlässige Methode auf Odoo.sh für
         Querformat-Etiketten.

         Formate:
           dymo_price           → 89x36mm  Landscape
           dymo_without_price   → 89x36mm  Landscape
           dymo_artikel_barcode → 24x54mm  Landscape
           dymo_price_small     → 54x70mm  Landscape
           dymo_small           → 54x70mm  Landscape
    ============================================================ -->

    <!-- ─── DYMO 89x36mm – MIT PREIS ─────────────────────────── -->
    <template id="dymo_price">
        <html>
            <head>
                <meta charset="utf-8"/>
                <style>
                    @page {
                        size: 89mm 36mm;
                        margin: 0mm;
                    }
                    html, body {
                        margin: 0;
                        padding: 0;
                        width: 89mm;
                        height: 36mm;
                        overflow: hidden;
                    }
                </style>
            </head>
            <body>
                <t t-foreach="quantity.items()" t-as="product_barcode_info">
                    <t t-set="product" t-value="product_barcode_info[0]"/>
                    <t t-foreach="product_barcode_info[1]" t-as="barcode_qty">
                        <t t-set="barcode" t-value="barcode_qty[0]"/>
                        <t t-set="qty" t-value="barcode_qty[1]"/>
                        <t t-foreach="range(qty)" t-as="i">
                            <t t-call="report_dymo_barcode.report_simple_label_dymo_price">
                                <t t-set="product" t-value="product"/>
                                <t t-set="barcode" t-value="barcode"/>
                                <t t-set="pricelist" t-value="pricelist"/>
                            </t>
                        </t>
                    </t>
                </t>
            </body>
        </html>
    </template>


