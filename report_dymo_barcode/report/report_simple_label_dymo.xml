<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="dymo_label_common_styles">
        <style>
            @page {
                margin: 0mm;
            }

            .page {
                margin: 0 !important;
                padding: 0 !important;
            }

            .dymo-label {
                box-sizing: border-box;
                overflow: hidden;
                font-family: Arial, sans-serif;
                color: #000;
            }

            .dymo-89x36 {
                width: 89mm;
                height: 36mm;
                padding: 1mm 2mm;
            }

            .dymo-54x25 {
                width: 54mm;
                height: 25mm;
                padding: 1mm 2mm;
            }

            .dymo-54x24 {
                width: 54mm;
                height: 24mm;
                padding: 1mm;
            }

            .dymo-row {
                display: flex;
                justify-content: space-between;
                align-items: baseline;
                width: 100%;
            }

            .dymo-nowrap {
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .dymo-center {
                text-align: center;
            }

            .dymo-barcode {
                line-height: 0;
                padding: 0;
            }
        </style>
    </template>


    <!-- ENTRY: 89x36 MIT PREIS -->
    <template id="dymo_price">
        <t t-call="web.html_container">
            <t t-call="report_dymo_barcode.dymo_label_common_styles"/>
            <meta charset="utf-8"/>
            <t t-foreach="quantity.items()" t-as="product_barcode_info">
                <t t-set="product" t-value="product_barcode_info[0]"/>
                <t t-foreach="product_barcode_info[1]" t-as="barcode_qty">
                    <t t-set="barcode" t-value="barcode_qty[0]"/>
                    <t t-set="qty" t-value="barcode_qty[1]"/>
                    <t t-foreach="range(qty)" t-as="i">
                        <div class="page">
                            <t t-call="report_dymo_barcode.report_simple_label_dymo_price">
                                <t t-set="product" t-value="product"/>
                                <t t-set="barcode" t-value="barcode"/>
                                <t t-set="pricelist" t-value="pricelist"/>
                            </t>
                        </div>
                    </t>
                </t>
            </t>
        </t>
    </template>

