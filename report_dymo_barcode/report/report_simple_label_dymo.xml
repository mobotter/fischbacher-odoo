<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         EINSTIEGSPUNKT-TEMPLATES
         Werden von dymo_barcode_report.xml über report_name aufgerufen.
         web.html_container liefert den <main>-Tag den Odoo 19 benötigt.

         Formate:
           dymo_price          → 89x36mm
           dymo_without_price  → 89x36mm
           dymo_artikel_barcode→ 24x54mm (schmal)
           dymo_price_small    → 54x70mm
           dymo_small          → 54x70mm
    ============================================================ -->

    <template id="dymo_price">
        <t t-call="web.html_container">
            <t t-foreach="quantity.items()" t-as="product_barcode_info">
                <t t-set="product" t-value="product_barcode_info[0]"/>
                <t t-foreach="product_barcode_info[1]" t-as="barcode_qty">
                    <t t-set="barcode" t-value="barcode_qty[0]"/>
                    <t t-set="qty" t-value="barcode_qty[1]"/>
                    <t t-foreach="range(qty)" t-as="i">
                        <t t-call="report_dymo_barcode.report_simple_label_dymo_price">
                            <t t-set="product" t-value="product"/>
                            <t t-set="barcode" t-value="barcode"/>
                            <t t-set="pricelist" t-value="pricelist"/>
                        </t>
                    </t>
                </t>
            </t>
        </t>
    </template>

    <template id="dymo_without_price">
