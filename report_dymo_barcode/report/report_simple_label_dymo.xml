    <!-- ============================================================
         LAYOUT-TEMPLATES
         Nur das visuelle Design – kein HTML-Gerüst hier.
         89x36mm  → wrapper: width:88mm; height:35mm
         54x70mm  → wrapper: width:69mm; height:53mm
         24x54mm  → wrapper: width:53mm; height:23mm
    ============================================================ -->

    <!-- ─── LAYOUT: 89x36mm MIT PREIS ────────────────────────── -->
    <template id="report_simple_label_dymo_price">
        <t t-set="barcode_size"  t-value="'width:78mm;height:8mm'"/>
        <t t-set="table_style"   t-value="'width:88mm;height:35mm;padding:0;font-family:Open Sans;box-sizing:border-box;overflow:hidden;'"/>
        <t t-set="padding_page"  t-value="'padding:1mm 2mm;'"/>

        <div style="page-break-after:always;">
            <div id="o_label_sheet" class="o_label_dymo" t-att-style="padding_page">
                <div class="o_label_full" t-att-style="table_style">

                    <div style="font-size:13px;line-height:100%;background-color:transparent;display:flex;justify-content:space-between;">
                        <strong style="font-size:13px;"
                                t-if="product.is_product_variant" t-field="product.default_code"/>
                        <strong t-else="" t-field="product.default_code"/>
                        <span style="font-size:9px;"
                              t-esc="datetime.datetime.now().strftime('%d.%m.%Y')"/>
                    </div>

                    <div style="font-size:12px;line-height:95%;background-color:transparent;padding:2px 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                        <span t-if="product.is_product_variant" t-field="product.display_name"/>
                        <span t-else="" t-field="product.name"/>
                    </div>

                    <div style="width:100%;line-height:100%;padding:1px 0;display:flex;justify-content:space-between;align-items:baseline;">
                        <span>
                            <strong style="font-size:13px;font-weight:bold;"
                                    t-out="pricelist._get_product_price(product, 1, currency=pricelist.currency_id or product.currency_id)"
                                    t-options="{'widget': 'monetary', 'display_currency': pricelist.currency_id or product.currency_id, 'label_price': True}"/>
                            <span style="font-size:8px;"> zzgl 19% MwSt</span>
                        </span>
                        <span style="text-align:right;">
                            <strong style="font-size:9px;"
                                    t-out="pricelist._get_product_price(product, 1, currency=pricelist.currency_id or product.currency_id) * 1.19"
                                    t-options="{'widget': 'monetary', 'display_currency': pricelist.currency_id or product.currency_id, 'label_price': True}"/>
                            <span style="font-size:8px;"> inkl 19% MwSt</span>
                        </span>
                    </div>

                    <div style="padding:1px 0 0 0;">
                        <t t-if="barcode">
                            <div t-out="barcode" style="padding:0;line-height:0;"
                                 t-options="{'widget': 'barcode', 'quiet': 0, 'symbology': 'auto', 'img_style': barcode_size}"/>
                            <div style="font-size:8px;height:1.3em;background-color:transparent;text-align:center;">
                                <span t-out="barcode"/>
                            </div>
                        </t>
                    </div>

                </div>
            </div>
        </div>
    </template>


