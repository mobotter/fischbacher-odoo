    <!-- BODY: 89x36 MIT PREIS -->
    <template id="report_simple_label_dymo_price">
        <t t-set="barcode_size" t-value="'width:78mm;height:8mm'"/>
        <t t-set="currency" t-value="pricelist.currency_id or product.currency_id"/>
        <t t-set="net_price" t-value="pricelist._get_product_price(product, 1, currency=currency)"/>
        <t t-set="gross_price" t-value="net_price * 1.19"/>

        <div class="dymo-label dymo-89x36">
            <div class="dymo-row" style="font-size:13px; line-height:100%;">
                <strong style="font-size:13px;" t-if="product.is_product_variant" t-field="product.default_code"/>
                <strong t-else="" t-field="product.default_code"/>
                <span style="font-size:9px; text-align:right;" t-esc="datetime.datetime.now().strftime('%d.%m.%Y')"/>
            </div>

            <div class="dymo-nowrap" style="font-size:12px; line-height:95%; padding:2px 0;">
                <span t-if="product.is_product_variant" t-field="product.display_name"/>
                <span t-else="" t-field="product.name"/>
            </div>

            <div class="dymo-row" style="line-height:100%; padding:1px 0;">
                <span>
                    <strong style="font-size:13px;">
                        <t t-esc="('%.2f' % net_price).replace('.', ',')"/>
                    </strong>
                    <span style="font-size:8px;"> <i class="fa fa-eur" role="img" aria-label="Euro"></i> zzgl. 19% MwSt.</span>
                </span>
                <span style="text-align:right;">
                    <strong style="font-size:9px;">
                        <t t-esc="('%.2f' % gross_price).replace('.', ',')"/>
                    </strong>
                    <span style="font-size:8px;"> <i class="fa fa-eur" role="img" aria-label="Euro"></i> inkl. 19% MwSt.</span>
                </span>
            </div>

            <div style="padding-top:1px;">
                <t t-if="barcode">
                    <div t-out="barcode"
                         class="dymo-barcode"
                         t-options="{'widget': 'barcode', 'quiet': 0, 'symbology': 'auto', 'img_style': barcode_size}"/>
                    <div style="font-size:11px; font-weight:bold; height:1.3em; text-align:left;">
                        <span t-out="barcode"/>
                    </div>
                </t>
            </div>
        </div>
    </template>


