    <!-- ============================================================
         LAYOUT-TEMPLATES
         89x36mm  → page_width:88mm; height:35mm (1mm Puffer)
         54x70mm  → page_width:69mm; height:53mm (1mm Puffer)
         24x54mm  → page_width:53mm; height:23mm (1mm Puffer)
    ============================================================ -->

    <!-- ─── DYMO 89x36mm – MIT PREIS ─────────────────────────── -->
    <template id="report_simple_label_dymo_price">
        <t t-set="barcode_size"  t-value="'width:78mm;height:8mm'"/>
        <t t-set="table_style"   t-value="'width:88mm;height:35mm;padding:0;font-family:Open Sans;'"/>
        <t t-set="padding_page"  t-value="'padding:1mm 2mm'"/>

        <div id="o_label_sheet" class="o_label_dymo" t-att-style="padding_page">
            <div class="o_label_full" t-att-style="table_style">

                <!-- Zeile 1: Artikelnummer + Datum -->
                <div class="text-start o_label_name"
                     style="font-size:13px;line-height:100%;background-color:transparent;">
                    <strong style="font-size:13px;line-height:100%;background-color:transparent;"
                            t-if="product.is_product_variant" t-field="product.default_code"/>
                    <strong t-else="" t-field="product.default_code"/>
                    <span class="float-end" style="font-size:9px;"
                          t-esc="datetime.datetime.now().strftime('%d.%m.%Y')"/>
                </div>

                <!-- Zeile 2: Produktname -->
                <div class="o_label_name text-nowrap"
                     style="font-size:12px;line-height:95%;background-color:transparent;padding:2px 0;">
                    <span t-if="product.is_product_variant" t-field="product.display_name"/>
                    <span t-else="" t-field="product.name"/>
                </div>

                <!-- Zeile 3: Preise (Netto + Brutto) -->
                <div class="align-bottom" style="width:100%;line-height:100%;padding:1px 0;">
                    <span class="text-start netto">
                        <strong class="text-nowrap o_label_price_small"
                                style="font-size:14px!important;padding:1px 0;"
                                t-out="pricelist._get_product_price(product, 1, currency=pricelist.currency_id or product.currency_id)"
                                t-options="{'widget': 'monetary', 'display_currency': pricelist.currency_id or product.currency_id, 'label_price': True}"/>
                        <span style="font-size:9px;">zzgl 19% MwSt</span>
                    </span>
                    <span class="float-end brutto">
                        <strong class="o_label_price_small"
                                style="font-size:9px!important;padding:1px 0;"
                                t-out="pricelist._get_product_price(product, 1, currency=pricelist.currency_id or product.currency_id) * 1.19"
                                t-options="{'widget': 'monetary', 'display_currency': pricelist.currency_id or product.currency_id, 'label_price': True}"/>
                        <span style="font-size:9px;">inkl 19% MwSt</span>
                    </span>
                </div>

                <!-- Zeile 4: Barcode -->
                <div class="o_label_small_barcode" style="padding:1px 0 0 0;">
                    <t t-if="barcode">
                        <div t-out="barcode" style="padding:0"
                             t-options="{'widget': 'barcode', 'quiet': 0, 'symbology': 'auto', 'img_style': barcode_size}"/>
                        <div class="o_label_name"
                             style="font-size:9px;height:1.3em;background-color:transparent;">
                            <span class="text-center" t-out="barcode"/>
                        </div>
                    </t>
                </div>

                <div class="o_label_clear"/>
            </div>
        </div>
    </template>


