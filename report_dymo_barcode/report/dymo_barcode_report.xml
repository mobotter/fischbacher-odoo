    <!-- PDF REPORTS: product.template -->
    <record id="report_product_template_label_dymo_price" model="ir.actions.report">
        <field name="name">Product Label Price (PDF)</field>
        <field name="model">product.template</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">report_dymo_barcode.dymo_price</field>
        <field name="report_file">report_dymo_barcode.dymo_price</field>
        <field name="paperformat_id" ref="report_dymo_barcode.paperformat_label_sheet_dymo"/>
        <field name="print_report_name">'Etikett_Preis_%s' % ((object.display_name or object.name or 'Produkt').replace(' ', '_').replace('/', '_'))</field>
        <field name="binding_type">report</field>
    </record>

