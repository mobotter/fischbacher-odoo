                            <t t-if="price_included">
                            ^CF0,30
                            <t t-if="currency_id.position == 'after'">
                            ^FO110,25^FD<t t-esc="pricelist._get_product_price(product, 1, currency=currency_id)" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/><t t-esc="currency_id.symbol"/>^FS
                            </t>
