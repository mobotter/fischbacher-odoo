    <!-- Button für Produktvarianten (product.product) -->
    <record id="view_product_variant_form_add_print_labels_button" model="ir.ui.view">
        <field name="name">product.product.form.print.labels.button.19</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <!-- 1. Versuch: Falls Odoo 19 das image_1920 anzeigt (wie beim Template) -->
            <xpath expr="//field[@name='image_1920']" position="before">
                <button name="%(report_dymo_barcode.action_open_product_label_layout_wizard)d"
                        type="action"
                        string="Etiketten drucken"
                        class="btn btn-primary float-end me-4 mt-2"
                        icon="fa-print"
                        invisible="not id"
                        context="{'active_model': 'product.product', 'default_product_variant_ids': [id]}"/>
            </xpath>
        </field>
    </record>

    <!-- Zweiter Fallback für Varianten-Formulare ohne sichtbares image_1920 -->
    <record id="view_product_variant_form_add_print_labels_header_button" model="ir.ui.view">
        <field name="name">product.product.form.print.labels.header.button</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(report_dymo_barcode.action_open_product_label_layout_wizard)d"
                        type="action"
                        string="Etiketten drucken"
                        class="btn btn-secondary"
                        icon="fa-print"
                        invisible="not id"
                        context="{'active_model': 'product.product', 'default_product_variant_ids': [id]}"/>
            </xpath>
        </field>
    </record>
