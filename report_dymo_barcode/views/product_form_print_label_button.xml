<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_form_add_print_labels_button" model="ir.ui.view">
        <field name="name">product.template.form.print.labels.button</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            
            <!-- Wir zielen auf das Bild-Feld ab und platzieren den Button direkt davor -->
            <xpath expr="//field[@name='image_1920']" position="before">
                <!-- Ein div-Container, um den Button rechtsbündig über oder neben dem Bild auszurichten -->
                <div class="d-inline-block float-end me-3 mb-2">
                    <button name="%(report_dymo_barcode.action_open_product_label_layout_wizard)d"
                            type="action"
                            string="Etiketten drucken"
                            class="btn btn-primary"
                            icon="fa-print"
                            context="{'active_model': 'product.template', 'default_product_tmpl_ids': [id]}"/>
                </div>
            </xpath>
            
        </field>
    </record>
</odoo>
