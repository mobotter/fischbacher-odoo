<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_form_add_print_labels_button" model="ir.ui.view">
        <field name="name">product.template.form.print.labels.button</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_product_label_layout_wizard"
                        type="action"
                        string="Etiketten drucken"
                        class="oe_stat_button"
                        icon="fa-tags"
                        context="{'active_model': 'product.template', 'active_ids': active_ids, 'default_product_tmpl_ids': active_ids}"/>
            </xpath>
        </field>
    </record>
</odoo>
