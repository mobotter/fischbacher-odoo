<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="action_fb_dashboard_products" model="ir.actions.act_window">
            <field name="name">Produkte</field>
            <field name="res_model">product.template</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Lege dein erstes Produkt an!
                </p>
            </field>
        </record>

        <record id="menu_fb_dashboard_products" model="ir.ui.menu">
            <field name="name">Produkte</field>
            <field name="sequence">15</field>
            <field name="parent_id" eval="False"/>
            <field name="action" ref="action_fb_dashboard_products"/>
            <field name="web_icon">fb_modul_icons,static/description/products_icon.png</field>
        </record>

    </data>
</odoo>
