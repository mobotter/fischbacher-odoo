<odoo>

    <record id="product_website_attribute_view_form" model="ir.ui.view">
        <field name="name">product.website.attribute.view.form</field>
        <field name="model">product.website.attribute</field>
        <field name="arch" type="xml">
            <form>
                <h3>
                    <field name="name"/>
                </h3>
                <group>
                    <field name="sequence" readonly="1"/>
                    <field name="external_id"/>
                    <field name="visible"/>
                    <field name="option_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="external_id"/>
                        </list>
                    </field>
                </group>
            </form>
        </field>
    </record>
    <record id="product_website_attribute_view_tree" model="ir.ui.view">
        <field name="name">product.website.attribute.view.tree</field>
        <field name="model">product.website.attribute</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="external_id"/>
                    <field name="visible"/>
                    <field name="option_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="product_website_attribute_view_tree" model="ir.ui.view">
        <field name="name">product.website.attribute.value.view.tree</field>
        <field name="model">product.website.attribute.value</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                    <field name="name"/>
                    <field name="attribute_id"/>
            </list>
        </field>
    </record>
</odoo>