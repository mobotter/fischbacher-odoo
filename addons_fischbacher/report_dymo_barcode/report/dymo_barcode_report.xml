<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="paperformat_label_sheet_dymo_small" model="report.paperformat">
            <field name="name">Dymo Label Sheet Small</field>
            <field name="default" eval="True" />
            <field name="format">custom</field>
            <field name="page_height">54</field>
            <field name="page_width">70</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">0</field>
            <field name="margin_bottom">0</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="disable_shrinking" eval="True"/>
            <field name="dpi">96</field>
        </record>
    
    <!-- Task id 34092 JC  -->
    <record id="paperformat_label_sheet_dymo_artikel_barcode" model="report.paperformat">
