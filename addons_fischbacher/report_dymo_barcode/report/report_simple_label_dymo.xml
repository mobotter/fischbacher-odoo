<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_simple_label_dymo" inherit_id="product.report_simple_label_dymo">
    <xpath expr="//t" position="replace">

    <t t-name="report_simple_label_dymo_full">
        <t t-set="barcode_size" t-value="'width:70mm;height:8mm'"/>
        <t t-set="table_style" t-value="'width:79mm;height:30.2mm;padding:0px;font-family: Open Sans'"/>
        <t t-set="padding_page" t-value="'padding: 2mm 4mm'"/>
        <div id="o_label_sheet" class="o_label_dymo" t-att-style="padding_page">
        
            <div class="o_label_full" t-att-style="table_style">
                <div class="text-start o_label_name" style="font-size: 10px; line-height: 100%;background-color: transparent; padding-top: 1px;">
                    <strong style="font-size: 16px; line-height: 100%;background-color: transparent;" t-if="product.is_product_variant" t-field="product.default_code"/><strong t-else="" t-field="product.default_code"/>
                    <span class="float-end" style="font-size: 10px;" t-esc="datetime.datetime.now().strftime('%d.%m.%Y')"/>
                </div>
                <!--<div class="text-nowrap" style="font-size: 16px; line-height: 90%; background-color: transparent; padding: 8px 0;"0>-->
                <div class="o_label_name text-nowrap" style="font-size: 14px; line-height: 90%; background-color: transparent; padding: 8px 0;">
                    <span t-if="product.is_product_variant" t-field="product.display_name"/><span t-else="" t-field="product.name"/>
                </div>
                    
                <div class="o_label_small_barcode" style="padding:0px;">
                    <t t-if="barcode">
                        <!-- `quiet=0` to remove the left and right margins on the barcode -->
                        <div t-out="barcode" style="padding:0" t-options="{'widget': 'barcode', 'quiet': 0, 'symbology': 'auto', 'img_style': barcode_size}"/>
                            <div class="o_label_name" style="font-size: 10px; height:1.4em;background-color: transparent;">
                                <span class="text-center" t-out="barcode"/>
                        </div>
                    </t>
                </div>
                <div class="o_label_clear"/>
            </div>
        </div>
    </t>
    </xpath>
    </template>


    <template id="report_productlabel_dymo_price">
        <t t-call="web.html_container">
            <t t-set="barcode_size" t-value="'width:65mm;height:8mm'"/>
            <t t-set="table_style" t-value="'width:69mm;height:30.2mm;padding:0;font-family: Open Sans;'"/>
            <t t-set="padding_page" t-value="'padding: 2mm'"/>
            <t t-foreach="quantity.items()" t-as="barcode_and_qty_by_product">
                <t t-set="product" t-value="barcode_and_qty_by_product[0]"/>
                <t t-foreach="barcode_and_qty_by_product[1]" t-as="barcode_and_qty">
                    <t t-set="barcode" t-value="barcode_and_qty[0]"/>
                    <t t-foreach="range(barcode_and_qty[1])" t-as="qty">
                        <t t-call="report_dymo_barcode.report_simple_label_dymo_price"/>
                    </t>
                </t>
            </t>
        </t>
    </template>

    <template id="dymo_price">
        <t t-call="web.basic_layout">
            <div class="page">    
                <t t-call="report_dymo_barcode.report_productlabel_dymo_price"/>
            </div>
        </t>
    </template>

    <template id="report_simple_label_dymo_price">

   <t t-name="report_simple_label_dymo_full_price">
        
        <div id="o_label_sheet" class="o_label_dymo" t-att-style="padding_page">
        
            <div class="o_label_full" t-att-style="table_style">
                <div class="text-start o_label_name" style="font-size: 16px; line-height: 100%;background-color: transparent;">
                    <strong style="font-size: 16px; line-height: 100%;background-color: transparent;" t-if="product.is_product_variant" t-field="product.default_code"/><strong t-else="" t-field="product.default_code"/>
                    <span class="float-end" style="font-size: 10px;" t-esc="datetime.datetime.now().strftime('%d.%m.%Y')"/>
                </div>
                <!--<div class="text-nowrap" style="font-size: 16px; line-height: 90%; background-color: transparent; padding: 8px 0;"0>-->
                <div class="o_label_name text-nowrap" style="font-size: 14px; line-height: 90%; background-color: transparent; padding: 4px 0;">
                    <span t-if="product.is_product_variant" t-field="product.display_name"/><span t-else="" t-field="product.name"/>
                </div>
                        
                <div class="align-bottom" style="width: 100%; line-height: 100%; padding:0;">
                    <!-- <small class="text-nowrap" t-field="product.default_code"/>-->
                    <span class="text-start netto"><strong class="text-nowrap o_label_price_small" style="font-size: 16px!important; padding: 2px 0 1px 0;" t-out="pricelist._get_product_price(product, 1, pricelist.currency_id or product.currency_id)" t-options="{'widget': 'monetary', 'display_currency': pricelist.currency_id or product.currency_id, 'label_price': True}"/> <span style="font-size: 10px;">zzgl 19% MwSt</span></span>
                    <span class="float-end brutto"><strong class="o_label_price_small" style="font-size: 10px!important; padding: 2px 0 1px 0;" t-out="pricelist._get_product_price(product, 1, pricelist.currency_id or product.currency_id) * 1.19" t-options="{'widget': 'monetary', 'display_currency': pricelist.currency_id or product.currency_id, 'label_price': True}"/> <span style="font-size: 10px;">inkl 19% MwSt</span></span>
                </div>
                <div class="o_label_small_barcode" style="padding: 2px">
                    <t t-if="barcode">
                        <!-- `quiet=0` to remove the left and right margins on the barcode -->
                        <div t-out="barcode" style="padding:0" t-options="{'widget': 'barcode', 'quiet': 0, 'symbology': 'auto', 'img_style': barcode_size}"/>
                            <div class="o_label_name" style="font-size: 10px; height:1.4em;background-color: transparent;">
                                <span class="text-center" t-out="barcode"/>
                        </div>
                    </t>
                </div>
                <div class="o_label_clear"/>
            </div>
        </div>
    </t>

    </template>




