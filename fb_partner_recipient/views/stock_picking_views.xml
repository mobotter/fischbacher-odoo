<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_partner_recipient" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.partner.recipient</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//field[@name='partner_id'])[1]" position="after">
                <field name="partner_recipient_id"
                       invisible="picking_type_code != 'outgoing'"
                       readonly="state in ('done', 'cancel')"
                       context="{'default_type': 'recipient', 'default_parent_id': partner_id, 'show_address': 1}"
                       options="{'always_reload': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
