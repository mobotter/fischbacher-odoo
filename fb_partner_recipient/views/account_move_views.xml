<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_partner_recipient" model="ir.ui.view">
        <field name="name">account.move.form.inherit.partner.recipient</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <field name="partner_recipient_id"
                       invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt')"
                       readonly="state != 'draft'"
                       context="{'default_type': 'recipient', 'default_parent_id': partner_id, 'show_address': 1, 'show_vat': True}"
                       options="{'always_reload': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
