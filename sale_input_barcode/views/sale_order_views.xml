<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_sale_input_barcode" model="ir.ui.view">
        <field name="name">sale.order.form.sale.input.barcode</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']" position="before">
                <group string="Barcode Scan" invisible="state not in ('draft', 'sent')">
                    <field name="barcode_scan" placeholder="Barcode scannen"/>
                    <button name="action_process_barcode_scan"
                            type="object"
                            string="Scan übernehmen"
                            class="btn-primary"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
