<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_sale_input_barcode" model="ir.ui.view">
        <field name="name">sale.order.form.sale.input.barcode</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="class">o_sale_input_barcode_order_line</attribute>
            </xpath>
        </field>
    </record>
</odoo>
