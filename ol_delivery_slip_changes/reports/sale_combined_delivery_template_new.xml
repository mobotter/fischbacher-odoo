<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_combined_delivery_template_new">
        <t t-foreach="docs" t-as="doc">
            <t t-call="ol_invoice_report_changes.external_layout_for_invoice">
                <t t-set="o" t-value="doc.with_context(lang=doc.partner_id.lang or doc.env.lang)"/>
                <t t-set="sale_order" t-value="o"/>
                <t t-set="invoice_partner" t-value="o.partner_invoice_id or o.partner_id"/>
                <t t-set="shipping_partner" t-value="o.partner_shipping_id or o.partner_id"/>

                <!-- Lieferadresse nur verwenden, wenn Straße bzw. Straße 2 gepflegt ist.
                     Andernfalls auf die Rechnungsadresse zurückfallen. -->
                <t t-set="delivery_address_partner"
                   t-value="shipping_partner
                            if shipping_partner and (shipping_partner.street or shipping_partner.street2)
                            else (invoice_partner or shipping_partner)"/>

                <t t-set="customer_partner"
                   t-value="(invoice_partner.parent_id or invoice_partner)
                            if invoice_partner
                            else (shipping_partner.parent_id or shipping_partner)"/>

                <!-- Leistungsempfänger (Modul fb_partner_recipient, optional) -->
                <t t-set="recipient_partner"
                   t-value="'partner_recipient_id' in o._fields and o.partner_recipient_id"/>

                <!-- Leistungsempfänger nur drucken, wenn er vom Kunden, von der
                     Rechnungsadresse und von der links gedruckten Anschrift abweicht. -->
                <t t-set="show_recipient"
                   t-value="bool(
                       recipient_partner
                       and recipient_partner != o.partner_id
                       and recipient_partner != invoice_partner
                       and recipient_partner != customer_partner
                       and recipient_partner != delivery_address_partner
                   )"/>

                <t t-set="inv"
                   t-value="o.invoice_ids.filtered(lambda i: i.invoice_date).sorted('invoice_date', reverse=True)[:1] or False"/>

                <!-- Positionen vor dem Informationsblock laden. -->
                <t t-set="all_lines"
                   t-value="o.get_all_order_lines_with_status()"/>

                <!-- Lieferschein-Referenzen sammeln, deduplizieren und sortieren. -->
                <t t-set="delivery_references"
                   t-value="sorted(set(
                       picking_name
                       for line in all_lines
                       for picking_name in (line.get('picking_names') or [])
                       if picking_name
                   ))"/>

                <main>
                    <div class="page">
                        <style>
                            .page {
                                position: relative;
                                border: 1px solid #ffffff;
                            }

                            .page table,
                            .page tr,
                            .page td,
                            .page th {
                                border: 0 !important;
                                border-width: 0 !important;
                                border-style: none !important;
                                border-color: transparent !important;
                                border-collapse: collapse !important;
                                box-shadow: none !important;
                                outline: none !important;
                                background-image: none !important;
                            }

                            .page table {
                                border-spacing: 0 !important;
                                background: transparent !important;
                            }

                            .page pre {
                                border: 0 !important;
                                border-style: none !important;
                                background: transparent !important;
                                margin: 0 !important;
                                padding: 0 !important;
                                white-space: pre-wrap !important;
                            }

                            .page .layout-table,
                            .page .layout-table td,
                            .page .layout-table th {
                                border: 0 !important;
                            }

                            .page .layout-table {
                                width: 100%;
                                border-collapse: collapse;
                            }

                            .page .head-bottom th {
                                border-bottom: 1px solid #cccccc !important;
                            }

                            .page .line-bottom td,
                            .page .line-bottom th {
                                border-bottom: 1px solid #e0e0e0 !important;
                            }

                            .page .fb_delivery_address_window {
                                border: 1px solid #ffffff;
                                position: absolute;
                                top: 0;
                                left: 0;
                                width: 85mm;
                                height: 40mm;
                                overflow: hidden;
                                font-size: 10pt;
                                line-height: 4.5mm;
                            }

                            .page .fb_delivery_return_address {
                                height: 5mm;
                                margin-bottom: 1.5mm;
                                overflow: hidden;
                                white-space: nowrap;
                                font-size: 8pt;
                                line-height: 3.5mm;
                                border-bottom: 2px solid #bfbfbf !important;
                            }

                            .page .fb_delivery_recipient_address {
                                padding-top: 1.5mm;
                                white-space: normal;
                                word-wrap: break-word;
                                word-break: break-word;
                            }

                            .page .fb_delivery_information_block {
                                border: 1px solid #ffffff;
                                width: 85mm;
                                min-height: 40mm;
                                margin: 0 0 10mm auto;
                                padding: 0;
                                font-size: 13px;
                                line-height: 1.35;
                            }

                            .page .fb_delivery_information_block table {
                                width: 100%;
                                border-collapse: collapse;
                            }

                            .page .fb_delivery_information_block td {
                                vertical-align: top;
                                padding: 0 0 1.2mm 0 !important;
                            }

                            .page .fb_delivery_information_block .label {
                                width: 46%;
                                padding-right: 3mm !important;
                                white-space: nowrap;
                            }

                            .page .title-blue {
                                color: #1f6fd2;
                                font-weight: 500;
                                font-size: 26px;
                                line-height: 1.2;
                                margin: 0 0 5mm 0;
                            }

                            .page .center {
                                text-align: center;
                            }

                            .page .left {
                                text-align: left;
                            }

                            .page .text-end {
                                text-align: right;
                            }

                            .page .cell-sm {
                                font-size: 13px;
                            }

                            .page .line-cell {
                                font-size: 12px;
                                padding-top: 6px !important;
                                padding-bottom: 6px !important;
                                vertical-align: top;
                            }

                            .page .line-pos {
                                width: 4%;
                            }

                            .page .line-product {
                                width: 37%;
                            }

                            .page .line-qty-order {
                                width: 12%;
                            }

                            .page .line-qty-delivery {
                                width: 12%;
                            }

                            .page .line-status {
                                width: 10%;
                            }

                            .page .line-type {
                                width: 10%;
                            }

                            .page .line-comment {
                                width: 15%;
                            }

                            .page .spacer-row td {
                                height: 20px !important;
                                padding: 0 !important;
                                border: none !important;
                            }

                            .page .product-code,
                            .page .line-detail {
                                font-size: 10px;
                                color: #555555;
                            }

                            .page .project-cell {
                                white-space: normal;
                                word-wrap: break-word;
                                word-break: break-word;
                                vertical-align: top;
                            }

                            .page .signature-wrap {
                                margin-top: 50px;
                                page-break-inside: avoid;
                            }

                            .page .signature-note {
                                margin-bottom: 10px;
                            }

                            .page .signature-table {
                                width: 100%;
                                max-width: 600px;
                                margin: auto;
                                border-collapse: collapse;
                            }

                            .page .signature-sign-col {
                                width: 35%;
                                padding-bottom: 40px !important;
                                font-size: 14px;
                            }

                            .page .signature-line {
                                border-bottom: 2px solid #000000 !important;
                                height: 35px;
                            }

                            .page .footer,
                            .page .footer p,
                            .page .footer span,
                            .page .footer td,
                            .page .footer div {
                                font-size: 6px !important;
                            }
                        </style>

                        <!-- Linker Anschriftenblock -->
                        <div class="fb_delivery_address_window">
                            <div class="fb_delivery_return_address">
                                <t t-if="o.company_id.name">
                                    <span t-field="o.company_id.name"/>
                                </t>

                                <t t-if="o.company_id.street">
                                    <span> · </span>
                                    <span t-field="o.company_id.street"/>
                                </t>

                                <t t-if="o.company_id.zip or o.company_id.city">
                                    <span> · </span>
                                    <span t-field="o.company_id.zip"/>
                                    <t t-if="o.company_id.zip and o.company_id.city">
                                        <span> </span>
                                    </t>
                                    <span t-field="o.company_id.city"/>
                                </t>
                            </div>

                            <div class="fb_delivery_recipient_address">
                                <t t-if="delivery_address_partner">
                                    <strong t-esc="delivery_address_partner.display_name or ''"/>
                                    <br/>

                                    <t t-if="delivery_address_partner.street">
                                        <t t-esc="delivery_address_partner.street"/>
                                        <br/>
                                    </t>

                                    <t t-if="delivery_address_partner.street2">
                                        <t t-esc="delivery_address_partner.street2"/>
                                        <br/>
                                    </t>

                                    <t t-if="delivery_address_partner.zip or delivery_address_partner.city">
                                        <t t-esc="delivery_address_partner.zip or ''"/>
                                        <t t-if="delivery_address_partner.zip and delivery_address_partner.city">
                                            <span> </span>
                                        </t>
                                        <t t-esc="delivery_address_partner.city or ''"/>
                                        <br/>
                                    </t>

                                    <t t-if="delivery_address_partner.country_id">
                                        <t t-esc="delivery_address_partner.country_id.name"/>
                                    </t>
                                </t>
                            </div>
                        </div>

                        <!-- Rechter Informationsblock -->
                        <div class="fb_delivery_information_block">
                            <table>
                                <tbody>
                                    <t t-if="inv">
                                        <tr>
                                            <td class="label">Rechnungsnummer:</td>
                                            <td t-esc="inv.name"/>
                                        </tr>
                                    </t>

                                    <t t-if="inv and inv.invoice_date">
                                        <tr>
                                            <td class="label">Rechnungsdatum:</td>
                                            <td>
                                                <span t-field="inv.invoice_date"
                                                      t-options="{'widget': 'date', 'format': 'dd.MM.yyyy'}"/>
                                            </td>
                                        </tr>
                                    </t>

                                    <t t-if="o.name">
                                        <tr>
                                            <td class="label">Bestellnummer:</td>
                                            <td t-esc="o.name"/>
                                        </tr>
                                    </t>

                                    <t t-if="o.date_order">
                                        <tr>
                                            <td class="label">Bestelldatum:</td>
                                            <td>
                                                <span t-field="o.date_order"
                                                      t-options="{'widget': 'date', 'format': 'dd.MM.yyyy'}"/>
                                            </td>
                                        </tr>
                                    </t>

                                    <t t-if="customer_partner">
                                        <tr>
                                            <td class="label">Kundennummer:</td>
                                            <td t-esc="customer_partner.ref or customer_partner.id"/>
                                        </tr>
                                    </t>

                                    <t t-if="o.client_order_name">
                                        <tr>
                                            <td class="label">Bestellt durch:</td>
                                            <td t-esc="o.client_order_name"/>
                                        </tr>
                                    </t>

                                    <t t-if="o.client_order_number">
                                        <tr>
                                            <td class="label">Ihre Bestellnummer:</td>
                                            <td t-esc="o.client_order_number"/>
                                        </tr>
                                    </t>

                                    <t t-if="'lease_agreement_no' in o._fields and o.lease_agreement_no">
                                        <tr>
                                            <td class="label">Mietvertragsnummer:</td>
                                            <td t-esc="o.lease_agreement_no"/>
                                        </tr>
                                    </t>

                                    <t t-if="o.carrier_id">
                                        <tr>
                                            <td class="label">Versandart:</td>
                                            <td t-esc="o.carrier_id.name"/>
                                        </tr>
                                    </t>

                                    <t t-if="o.incoterm">
                                        <tr>
                                            <td class="label">Lieferbedingung:</td>
                                            <td t-esc="o.incoterm.name"/>
                                        </tr>
                                    </t>

                                    <t t-if="o.user_id and o.user_id.name">
                                        <tr>
                                            <td class="label">Vertriebsmitarbeiter:</td>
                                            <td t-esc="o.user_id.name"/>
                                        </tr>
                                    </t>

                                    <t t-if="o.user_id and o.user_id.phone">
                                        <tr>
                                            <td class="label">Telefon:</td>
                                            <td t-esc="o.user_id.phone"/>
                                        </tr>
                                    </t>

                                    <t t-if="o.user_id and o.user_id.email">
                                        <tr>
                                            <td class="label">E-Mail:</td>
                                            <td t-esc="o.user_id.email"/>
                                        </tr>
                                    </t>

                                    <t t-if="o.client_order_ref">
                                        <tr>
                                            <td class="label" style="vertical-align: top;">Projekt:</td>
                                            <td class="project-cell" t-esc="o.client_order_ref"/>
                                        </tr>
                                    </t>

                                    <!-- Leistungsempfänger -->
                                    <t t-if="show_recipient">
                                        <tr>
                                            <td class="label" style="vertical-align: top;">Leistungsempfänger:</td>
                                            <td class="project-cell">
                                                <t t-if="recipient_partner.name">
                                                    <t t-esc="recipient_partner.name"/>
                                                    <br/>
                                                </t>

                                                <t t-if="'department_name' in recipient_partner._fields and recipient_partner.department_name">
                                                    <t t-esc="recipient_partner.department_name"/>
                                                    <br/>
                                                </t>

                                                <t t-if="recipient_partner.street">
                                                    <t t-esc="recipient_partner.street"/>
                                                    <br/>
                                                </t>

                                                <t t-if="recipient_partner.street2">
                                                    <t t-esc="recipient_partner.street2"/>
                                                    <br/>
                                                </t>

                                                <t t-if="recipient_partner.zip or recipient_partner.city">
                                                    <t t-esc="recipient_partner.zip or ''"/>
                                                    <t t-if="recipient_partner.zip and recipient_partner.city">
                                                        <span> </span>
                                                    </t>
                                                    <t t-esc="recipient_partner.city or ''"/>
                                                    <br/>
                                                </t>

                                                <t t-if="recipient_partner.country_id">
                                                    <t t-esc="recipient_partner.country_id.name"/>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>

                                    <!-- Lieferschein-Referenzen:
                                         unabhängig vom Leistungsempfänger anzeigen. -->
                                    <t t-if="delivery_references">
                                        <tr>
                                            <td class="label" style="vertical-align: top;">
                                                Lieferschein-Referenzen:
                                            </td>
                                            <td class="project-cell">
                                                <t t-foreach="delivery_references"
                                                   t-as="delivery_reference">
                                                    <span t-esc="delivery_reference"/>
                                                    <br t-if="not delivery_reference_last"/>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <h2 class="title-blue">Lieferschein (Gesamt)</h2>

                        <!-- Zusammengeführte Auftrags-, Lager- und Streckenpositionen -->
                        <table class="layout-table table-borderless"
                               name="combined_delivery_table"
                               style="font-size: 12px; width: 100%; border-collapse: collapse; border: none !important;">
                            <thead>
                                <tr class="spacer-row">
                                    <td colspan="7"/>
                                </tr>

                                <tr class="head-bottom">
                                    <th class="line-pos left cell-sm">Pos.</th>
                                    <th class="line-product left cell-sm">Produkt</th>
                                    <th class="line-qty-order text-end cell-sm">Bestellmenge</th>
                                    <th class="line-qty-delivery text-end cell-sm">Geliefert</th>
                                    <th class="line-status left cell-sm">Status</th>
                                    <th class="line-type left cell-sm">Typ</th>
                                    <th class="line-comment left cell-sm">Kommentar</th>
                                </tr>
                            </thead>

                            <tbody>
                                <t t-set="pos" t-value="0"/>

                                <tr t-foreach="all_lines"
                                    t-as="line"
                                    class="line-bottom">
                                    <t t-set="pos" t-value="pos + 1"/>

                                    <td class="line-cell">
                                        <t t-esc="pos"/>
                                    </td>

                                    <td class="line-cell">
                                        <t t-if="line.get('product')">
                                            <span t-esc="line['product'].display_name"/>

                                            <t t-if="line['product'].default_code">
                                                <br/>
                                                <span class="product-code">
                                                    <t t-esc="line['product'].default_code"/>
                                                </span>
                                            </t>
                                        </t>

                                        <t t-if="line.get('lot_names')">
                                            <br/>
                                            <span class="line-detail">
                                                Charge:
                                                <t t-esc="', '.join(line['lot_names'])"/>
                                            </span>
                                        </t>

                                        <t t-if="line.get('picking_names')">
                                            <br/>
                                            <span class="line-detail">
                                                Lieferschein:
                                                <t t-esc="', '.join(line['picking_names'])"/>
                                            </span>
                                        </t>
                                    </td>

                                    <td class="line-cell text-end">
                                        <span t-esc="'{:.2f}'.format(line.get('product_uom_qty', 0.0))"/>
                                        <span t-esc="line.get('uom_name', '')"/>
                                    </td>

                                    <td class="line-cell text-end">
                                        <span t-esc="'{:.2f}'.format(line.get('qty_done', 0.0))"/>
                                        <span t-esc="line.get('uom_name', '')"/>
                                    </td>

                                    <td class="line-cell">
                                        <span t-esc="line.get('status', '')"/>
                                    </td>

                                    <td class="line-cell">
                                        <t t-if="line.get('is_dropship')">
                                            <span>Strecke</span>
                                        </t>
                                        <t t-elif="line.get('line_type') == 'Dienstleistung'">
                                            <span>Dienstleistung</span>
                                        </t>
                                        <t t-elif="line.get('line_type') == 'Lager'">
                                            <span>Lager</span>
                                        </t>
                                    </td>

                                    <td class="line-cell">
                                        <t t-if="line.get('comment')">
                                            <span t-esc="line['comment']"/>
                                        </t>
                                    </td>
                                </tr>

                                <tr t-if="not all_lines">
                                    <td colspan="7" class="line-cell">
                                        Keine Positionen vorhanden.
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="signature-wrap">
                            <p class="signature-note">
                                Der ordnungsgemäße Empfang der Ware wird hiermit bestätigt.
                            </p>

                            <table class="signature-table">
                                <tbody>
                                    <tr>
                                        <td class="signature-sign-col">
                                            <div>Unterschrift</div>
                                            <div class="signature-line"></div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </main>
            </t>
        </t>
    </template>
</odoo>
