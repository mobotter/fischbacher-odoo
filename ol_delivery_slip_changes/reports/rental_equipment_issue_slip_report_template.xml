<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Report action for Rental Equipment Issue Slip
        Available as print option for stock.picking records.
        Usage: Use this action for subscription deliveries / rental equipment issues.
    -->
    <record id="action_report_rental_equipment_issue_slip" model="ir.actions.report">
        <field name="name">Rental Equipment Issue Slip</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ol_delivery_slip_changes.rental_equipment_issue_slip_report</field>
        <field name="report_file">ol_delivery_slip_changes.rental_equipment_issue_slip_report</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Rental Equipment Issue Slip - %s' % (object.name)</field>
    </record>
</odoo>
