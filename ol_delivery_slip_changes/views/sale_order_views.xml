<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_combined_delivery_btn"
            model="ir.ui.view">
        <field name="name">sale.order.form.combined.delivery.btn</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']"
                   position="inside">
                <button name="action_print_combined_delivery_slip"
                        type="object"
                        string="Gesamt-Lieferschein"
                        icon="fa-truck"
                        class="oe_stat_button"
                        groups="stock.group_stock_user"
                        invisible="state not in ['sale', 'done']"/>
            </xpath>
        </field>
    </record>
</odoo>
