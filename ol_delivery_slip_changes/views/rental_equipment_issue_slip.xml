<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Rental equipment issue slip report
        Additional report for subscription deliveries.
        Based on the delivery slip layout with adapted title and line columns.
    -->
    <template id="rental_equipment_issue_slip_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="ol_invoice_report_changes.external_layout_for_invoice">
                    <t t-set="o" t-value="doc.with_context(lang=doc._get_report_lang())"/>
                    <t t-set="partner" t-value="o.partner_id or (o.move_ids and o.move_ids[0].partner_id) or False"/>

                    <t t-set="sale_order" t-value="o.sale_id or o.move_ids.mapped('sale_line_id.order_id')[:1]"/>
                    <t t-set="invoice_partner" t-value="sale_order and sale_order.partner_invoice_id or False"/>
                    <t t-set="shipping_partner" t-value="o.partner_id"/>
                    <t t-set="inv" t-value="sale_order and sale_order.invoice_ids.filtered(lambda i: i.invoice_date).sorted('invoice_date', reverse=True)[:1] or False"/>

                    <main>
                        <div class="page">
                            <style>
                                .page table,
                                .page tr,
                                .page td,
                                .page th {
                                    border: 0 !important;
                                    border-width: 0 !important;
                                    border-style: none !important;
                                    border-color: transparent !important;
                                    border-collapse: collapse !important;
                                    box-shadow: none !important;
                                    outline: none !important;
                                }

                                .page table {
                                    border-spacing: 0 !important;
                                    background: transparent !important;
                                }

                                .page pre {
                                    border: 0 !important;
                                    border-style: none !important;
                                    background: transparent !important;
                                    margin: 0 !important;
                                    padding: 0 !important;
                                    white-space: pre-wrap;
                                }

                                .page .head-bottom th {
                                    border-bottom: 1px solid #ccc !important;
                                }

                                .page .line-bottom td,
                                .page .line-bottom th {
                                    border-bottom: 1px solid #e0e0e0 !important;
                                }

                                .page .layout-table {
                                    width: 100%;
                                    border-collapse: collapse;
                                }

                                .page .top-table {
                                    margin-top: 10mm;
                                }

                                .page .left-col {
                                    width: 50%;
                                    vertical-align: top;
                                    height: 45mm;
                                    max-height: 45mm;
                                    overflow: hidden;
                                    font-size: 13px;
                                }

                                .page .right-col {
                                    width: 45%;
                                    vertical-align: top;
                                    padding-left: 15mm;
                                    line-height: 1.5;
                                }

                                .page .address-wrap {
                                    margin-top: 5mm;
                                }

                                .page .company-line {
                                    font-size: 10.5px;
                                    margin-bottom: 4px;
                                    border-bottom: 1px solid #ccc;
                                }

                                .page .meta-label,
                                .page .meta-value,
                                .page .cell-sm {
                                    font-size: 13px;
                                }

                                .page .meta-value {
                                    padding-left: 3px;
                                }

                                .page .meta-label-wide {
                                    width: 55%;
                                }

                                .page .title-red {
                                    color: #c9392b;
                                    font-weight: 500;
                                    margin: 10mm 0 5mm 0;
                                }

                                .page .center {
                                    text-align: center;
                                }

                                .page .left {
                                    text-align: left;
                                }

                                .page .text-end {
                                    text-align: right;
                                }

                                .page .line-cell {
                                    font-size: 14px;
                                    padding-top: 6px;
                                    padding-bottom: 6px;
                                    vertical-align: top;
                                }

                                .page .line-pos {
                                    width: 5%;
                                }

                                .page .line-product {
                                    width: 47%;
                                }

                                .page .line-qty-order {
                                    width: 16%;
                                }

                                .page .line-qty-output {
                                    width: 16%;
                                }

                                .page .line-other {
                                    width: 16%;
                                }

                                .page .spacer-row td {
                                    height: 20px;
                                    padding: 0;
                                    border: none;
                                }

                                .page .project-cell {
                                    white-space: normal;
                                    word-wrap: break-word;
                                    word-break: break-word;
                                    vertical-align: top;
                                }

                                .page .signature-wrap {
                                    margin-top: 50px;
                                    page-break-inside: avoid;
                                }

                                .page .signature-note {
                                    margin-bottom: 10px;
                                }

                                .page .signature-table {
                                    width: 100%;
                                    max-width: 760px;
                                    margin: auto;
                                    border-collapse: collapse;
                                }

                                .page .signature-date-col,
                                .page .signature-sign-col {
                                    width: 35%;
                                    padding-bottom: 40px;
                                }

                                .page .signature-gap-col {
                                    width: 30%;
                                    padding-bottom: 40px;
                                }

                                .page .signature-sign-col {
                                    font-size: 14px;
                                }

                                .page .signature-line {
                                    border-bottom: 2px solid black !important;
                                    height: 35px;
                                }
                            </style>

                            <table class="layout-table top-table">
                                <tr>
                                    <td class="left-col">
                                        <div class="address-wrap">
                                            <div class="company-line">
                                                <span t-field="o.company_id.name"/> |
                                                <span t-field="o.company_id.street"/> |
                                                <span t-field="o.company_id.zip"/>
                                                <span t-field="o.company_id.city"/>
                                            </div>

                                            <t t-if="sale_order and sale_order.print_delivery_address">
                                                <span>
                                                    <t t-out="shipping_partner.display_name or ''"/><br/>
                                                    <t t-if="shipping_partner.street or shipping_partner.street2">
                                                        <t t-out="shipping_partner.street or ''"/>
                                                        <t t-if="shipping_partner.street and shipping_partner.street2">&#160;</t>
                                                        <t t-out="shipping_partner.street2 or ''"/><br/>
                                                    </t>
                                                    <t t-if="shipping_partner.zip or shipping_partner.city">
                                                        <t t-out="shipping_partner.zip or ''"/>
                                                        <t t-if="shipping_partner.zip and shipping_partner.city">&#160;</t>
                                                        <t t-out="shipping_partner.city or ''"/><br/>
                                                    </t>
                                                    <t t-if="shipping_partner.country_id">
                                                        <t t-out="shipping_partner.country_id.name or ''"/>
                                                    </t>
                                                </span>
                                            </t>

                                            <t t-elif="invoice_partner and shipping_partner and invoice_partner.id != shipping_partner.id">
                                                <span>
                                                    <t t-out="shipping_partner.display_name or ''"/><br/>
                                                    <t t-if="shipping_partner.street or shipping_partner.street2">
                                                        <t t-out="shipping_partner.street or ''"/>
                                                        <t t-if="shipping_partner.street and shipping_partner.street2">&#160;</t>
                                                        <t t-out="shipping_partner.street2 or ''"/><br/>
                                                    </t>
                                                    <t t-if="shipping_partner.zip or shipping_partner.city">
                                                        <t t-out="shipping_partner.zip or ''"/>
                                                        <t t-if="shipping_partner.zip and shipping_partner.city">&#160;</t>
                                                        <t t-out="shipping_partner.city or ''"/><br/>
                                                    </t>
                                                    <t t-if="shipping_partner.country_id">
                                                        <t t-out="shipping_partner.country_id.name or ''"/>
                                                    </t>
                                                </span>
                                            </t>

                                            <br/>
                                            <br/>

                                            <t t-if="invoice_partner">
                                                <t t-if="shipping_partner and invoice_partner.id == shipping_partner.id">
                                                    <p style="margin-bottom:0; margin-top:6px;">
                                                        <strong>Customer &amp; Delivery Address:</strong>
                                                    </p>
                                                </t>
                                                <t t-else="">
                                                    <p style="margin-bottom:0; margin-top:6px;">
                                                        <strong>Customer Address:</strong>
                                                    </p>
                                                </t>

                                                <span>
                                                    <t t-out="invoice_partner.name or ''"/><br/>
                                                    <t t-if="invoice_partner.street or invoice_partner.street2">
                                                        <t t-out="invoice_partner.street or ''"/>
                                                        <t t-if="invoice_partner.street and invoice_partner.street2">&#160;</t>
                                                        <t t-out="invoice_partner.street2 or ''"/><br/>
                                                    </t>
                                                    <t t-if="invoice_partner.zip or invoice_partner.city">
                                                        <t t-out="invoice_partner.zip or ''"/>
                                                        <t t-if="invoice_partner.zip and invoice_partner.city">&#160;</t>
                                                        <t t-out="invoice_partner.city or ''"/><br/>
                                                    </t>
                                                    <t t-if="invoice_partner.country_id">
                                                        <t t-out="invoice_partner.country_id.name or ''"/>
                                                    </t>
                                                </span>
                                            </t>

                                            <t t-if="not invoice_partner">
                                                <span>
                                                    <t t-out="o.partner_id.name or ''"/><br/>
                                                    <t t-if="o.partner_id.street or o.partner_id.street2">
                                                        <t t-out="o.partner_id.street or ''"/>
                                                        <t t-if="o.partner_id.street and o.partner_id.street2">&#160;</t>
                                                        <t t-out="o.partner_id.street2 or ''"/><br/>
                                                    </t>
                                                    <t t-if="o.partner_id.zip or o.partner_id.city">
                                                        <t t-out="o.partner_id.zip or ''"/>
                                                        <t t-if="o.partner_id.zip and o.partner_id.city">&#160;</t>
                                                        <t t-out="o.partner_id.city or ''"/><br/>
                                                    </t>
                                                    <t t-if="o.partner_id.country_id">
                                                        <t t-out="o.partner_id.country_id.name or ''"/>
                                                    </t>
                                                </span>
                                            </t>
                                        </div>
                                    </td>

                                    <td class="right-col">
                                        <table class="layout-table">
                                            <t t-if="sale_order and sale_order.name">
                                                <tr>
                                                    <td class="meta-label meta-label-wide">Quote Number:</td>
                                                    <td class="meta-value">
                                                        <t t-esc="sale_order.name"/>
                                                    </td>
                                                </tr>
                                            </t>

                                            <t t-if="sale_order and sale_order.date_order">
                                                <tr>
                                                    <td class="meta-label">Quote Date:</td>
                                                    <td class="meta-value">
                                                        <span t-field="sale_order.date_order" t-options="{'widget': 'date', 'format': 'dd.MM.yyyy'}"/>
                                                    </td>
                                                </tr>
                                            </t>

                                            <t t-if="o.partner_id.ref">
                                                <tr>
                                                    <td class="meta-label">Client Number:</td>
                                                    <td class="meta-value">
                                                        <t t-esc="o.partner_id.ref"/>
                                                    </td>
                                                </tr>
                                            </t>
                                            <t t-else="">
                                                <tr>
                                                    <td class="meta-label">Client Number:</td>
                                                    <td class="meta-value">
                                                        <t t-esc="o.partner_id.id"/>
                                                    </td>
                                                </tr>
                                            </t>

                                            <t t-if="sale_order and sale_order.user_id and sale_order.user_id.name">
                                                <tr>
                                                    <td class="meta-label">Salesperson:</td>
                                                    <td class="meta-value">
                                                        <t t-esc="sale_order.user_id.name"/>
                                                    </td>
                                                </tr>
                                            </t>

                                            <t t-if="sale_order and sale_order.user_id and sale_order.user_id.phone">
                                                <tr>
                                                    <td class="meta-label">Phone:</td>
                                                    <td class="meta-value">
                                                        <t t-esc="sale_order.user_id.phone"/>
                                                    </td>
                                                </tr>
                                            </t>

                                            <t t-if="sale_order and sale_order.user_id and sale_order.user_id.login">
                                                <tr>
                                                    <td class="meta-label">Email:</td>
                                                    <td class="meta-value">
                                                        <t t-esc="sale_order.user_id.login"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <h2 class="title-red">
                                <span t-if="o.env.lang and o.env.lang.startswith('de')">Mietausgabeschein</span>
                                <span t-else="">Rental equipment issue slip</span>
                            </h2>

                            <table class="table table-borderless layout-table" name="rental_issue_table" style="font-size:14px;">
                                <thead>
                                    <tr style="margin-bottom:10px;">
                                        <td t-if="o.origin" colspan="1" class="center">
                                            <strong>Order</strong><br/>
                                            <span t-esc="o.origin"/>
                                        </td>

                                        <td t-if="o.state" colspan="2" class="center">
                                            <strong>Delivery Slip Date</strong><br/>
                                            <span t-if="o.state == 'done'" t-field="o.date_done" t-options="{'widget': 'date', 'format': 'dd.MM.yyyy'}"/>
                                            <span t-else="" t-field="o.scheduled_date" t-options="{'widget': 'date', 'format': 'dd.MM.yyyy'}"/>
                                        </td>

                                        <td t-if="o.name" colspan="2" class="center">
                                            <strong>Delivery Slip No.</strong><br/>
                                            <span t-field="o.name"/>
                                        </td>
                                    </tr>

                                    <tr class="spacer-row">
                                        <td colspan="5"/>
                                    </tr>

                                    <tr class="head-bottom">
                                        <th class="line-pos left cell-sm">
                                            <span t-if="o.env.lang and o.env.lang.startswith('de')">POS</span>
                                            <span t-else="">POS</span>
                                        </th>
                                        <th class="line-product left cell-sm">
                                            <span t-if="o.env.lang and o.env.lang.startswith('de')">Produkt</span>
                                            <span t-else="">Product</span>
                                        </th>
                                        <th class="line-qty-order left cell-sm">
                                            <span t-if="o.env.lang and o.env.lang.startswith('de')">Auftragsmenge</span>
                                            <span t-else="">Order Quantity</span>
                                        </th>
                                        <th class="line-qty-output left cell-sm">
                                            <span t-if="o.env.lang and o.env.lang.startswith('de')">Ausgabemenge</span>
                                            <span t-else="">Output quantity</span>
                                        </th>
                                        <th class="line-other left cell-sm">
                                            <span t-if="o.env.lang and o.env.lang.startswith('de')">Sonstiges</span>
                                            <span t-else="">Other</span>
                                        </th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <t t-set="lines" t-value="o.move_ids.filtered(lambda x: x.product_uom_qty)"/>
                                    <t t-set="pos" t-value="0"/>

                                    <tr t-foreach="lines" t-as="move" class="line-bottom">
                                        <t t-set="pos" t-value="pos + 1"/>

                                        <td class="line-cell">
                                            <t t-esc="pos"/>
                                        </td>

                                        <td class="line-cell">
                                            <span t-field="move.product_id.display_name"/>
                                            <t t-if="not o.is_description_report and move.product_id.description">
                                                <br/>
                                                <span t-field="move.product_id.description"/>
                                            </t>
                                        </td>

                                        <td class="line-cell">
                                            <span t-field="move.product_uom_qty"/>
                                            <span t-field="move.product_uom"/>
                                        </td>

                                        <td class="line-cell">
                                        </td>

                                        <td class="line-cell">
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <div class="signature-wrap">
                                <p class="signature-note">
                                    The proper receipt of the goods is hereby confirmed.
                                </p>

                                <table class="signature-table">
                                    <tr>
                                        <td class="signature-date-col">
                                            <div>Date</div>
                                            <div class="signature-line"></div>
                                        </td>

                                        <td class="signature-gap-col"></td>

                                        <td class="signature-sign-col">
                                            <div>Signature</div>
                                            <div class="signature-line"></div>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </main>
                </t>
            </t>
        </t>
    </template>
</odoo>
