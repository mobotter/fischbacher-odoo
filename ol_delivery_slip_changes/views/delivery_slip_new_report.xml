<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Delivery Slip Report Changes
        This template overrides the standard delivery slip from stock.report_deliveryslip.
    --> 
    <template id="delivery_slip_new" inherit_id="stock.report_deliveryslip">
        <xpath expr="//t" position="replace">
            <t t-foreach="docs" t-as="doc">
                <t t-call="ol_invoice_report_changes.external_layout_for_invoice">
                    <t t-set="o" t-value="doc.with_context(lang=doc._get_report_lang())"/>
                    <t t-set="partner" t-value="o.partner_id or (o.move_ids and o.move_ids[0].partner_id) or False"/>

                    <t t-set="sale_order" t-value="o.sale_id or o.move_ids.mapped('sale_line_id.order_id')[:1]"/>
                    <t t-set="invoice_partner" t-value="sale_order and sale_order.partner_invoice_id or False"/>
                    <t t-set="shipping_partner" t-value="o.partner_id"/>
                    <t t-set="inv" t-value="sale_order and sale_order.invoice_ids.filtered(lambda i: i.invoice_date).sorted('invoice_date', reverse=True)[:1] or False"/>

                    <main>
                        <div class="page">
                            <style>
                                .page table,
                                .page tr,
                                .page td,
                                .page th {
                                    border: 0 !important;
                                    border-width: 0 !important;
                                    border-style: none !important;
                                    border-color: transparent !important;
                                    border-collapse: collapse !important;
                                    box-shadow: none !important;
                                    outline: none !important;
                                }

                                .page table {
                                    border-spacing: 0 !important;
                                    background: transparent !important;
                                }

                                .page pre {
                                    border: 0 !important;
                                    border-style: none !important;
                                    background: transparent !important;
                                    margin: 0 !important;
                                    padding: 0 !important;
                                    white-space: pre-wrap;
                                }

                                .page .layout-table td, 
                                .page .layout-table th {
                                    padding-top: 2px !important;
                                    padding-bottom: 2px !important;
                                    padding-left: 0 !important;
                                    padding-right: 0 !important;
                                    line-height: 1.4 !important;
                                }

                                .page .head-bottom th {
                                    border-bottom: 1px solid #ccc !important;
                                }

                                .page .line-bottom td,
                                .page .line-bottom th {
                                    border-bottom: 1px solid #e0e0e0 !important;
                                }

                                .page .layout-table {
                                    width: 100%;
                                    border-collapse: collapse;
                                    border: none !important;
                                }

                                .page .top-table {
                                    margin-top: 10mm;
                                }

                                .page .left-col {
                                    width: 50%;
                                    vertical-align: top;
                                    height: 45mm;
                                    max-height: 45mm;
                                    overflow: hidden;
                                    font-size: 13px;
                                }

                                .page .right-col {
                                    width: 45%;
                                    vertical-align: top;
                                    padding-left: 15mm;
                                }

                                .page .address-wrap {
                                    margin-top: 5mm;
                                }

                                .page .company-line {
                                    font-size: 10.5px;
                                    margin-bottom: 4px;
                                    border-bottom: 1px solid #666 !important;
                                    margin-right: 20px;
                                }

                                .page .meta-label,
                                .page .meta-value,
                                .page .cell-sm {
                                    font-size: 13px;
                                }

                                .page .meta-value {
                                    padding-left: 3px;
                                }

                                .page .meta-label-wide {
                                    width: 55%;
                                }

                                .page .title-blue {
                                    color: #1f6fd2;
                                    font-weight: 500;
                                    margin: 10mm 0 5mm 0;
                                }

                                .page .center {
                                    text-align: center;
                                }

                                .page .left {
                                    text-align: left;
                                }

                                .page .text-end {
                                    text-align: right;
                                }

                                .page .line-cell {
                                    font-size: 14px;
                                    padding-top: 6px !important;
                                    padding-bottom: 6px !important;
                                }

                                .page .line-product {
                                    width: 48%;
                                }

                                .page .line-pos {
                                    width: 5%;
                                }

                                .page .line-qty-order {
                                    width: 15%;
                                }

                                .page .line-qty-delivery {
                                    width: 17%;
                                }

                                .page .line-backorder {
                                    width: 15%;
                                }

                                .page .spacer-row td {
                                    height: 20px !important;
                                    padding: 0 !important;
                                    border: none !important;
                                }

                                .page .project-cell {
                                    white-space: normal;
                                    word-wrap: break-word;
                                    word-break: break-word;
                                    vertical-align: top;
                                }

                                .page .signature-wrap {
                                    margin-top: 50px;
                                    page-break-inside: avoid;
                                }

                                .page .signature-note {
                                    margin-bottom: 10px;
                                }

                                .page .signature-table {
                                    width: 100%;
                                    max-width: 600px;
                                    margin: auto;
                                    border-collapse: collapse;
                                }

                                .page .signature-date-col,
                                .page .signature-sign-col {
                                    width: 35%;
                                    padding-bottom: 40px;
                                }

                                .page .signature-gap-col {
                                    width: 30%;
                                    padding-bottom: 40px;
                                }

                                .page .signature-sign-col {
                                    font-size: 14px;
                                }

                                .page .signature-line {
                                    border-bottom: 2px solid black !important;
                                    height: 35px;
                                }

                                .page .continued-header {
                                    width: 100%;
                                    margin: 0 0 6mm 0;
                                }

                                .page .continued-header td {
                                    text-align: right;
                                    padding: 0 !important;
                                    font-size: 10.5px;
                                    color: #444;
                                }

                                .page .continued-sep {
                                    padding: 0 6px;
                                }
                                .footer, 
                                .footer p, 
                                .footer span, 
                                .footer td, 
                                .footer div {
                                    font-size: 6px !important;
                                }
                            </style>

                            <table class="layout-table top-table table-borderless">
                                <tr>
                                    <td class="left-col">
                                        <div class="address-wrap">
                                            <div class="company-line">
                                                <span t-field="o.company_id.name"/> |
                                                <span t-field="o.company_id.street"/> |
                                                <span t-field="o.company_id.zip"/>
                                                <span t-field="o.company_id.city"/>
                                            </div>

                                            <t t-if="sale_order and sale_order.print_delivery_address">
                                                <span>
                                                    <t t-out="shipping_partner.display_name or ''"/><br/>
                                                    <t t-if="shipping_partner.street or shipping_partner.street2">
                                                        <t t-out="shipping_partner.street or ''"/>
                                                        <t t-if="shipping_partner.street and shipping_partner.street2">&#160;</t>
                                                        <t t-out="shipping_partner.street2 or ''"/><br/>
                                                    </t>
                                                    <t t-if="shipping_partner.zip or shipping_partner.city">
                                                        <t t-out="shipping_partner.zip or ''"/>
                                                        <t t-if="shipping_partner.zip and shipping_partner.city">&#160;</t>
                                                        <t t-out="shipping_partner.city or ''"/><br/>
                                                    </t>
                                                    <t t-if="shipping_partner.country_id">
                                                        <t t-out="shipping_partner.country_id.name or ''"/>
                                                    </t>
                                                </span>
                                            </t>

                                            <t t-elif="invoice_partner and shipping_partner and invoice_partner.id != shipping_partner.id">
                                                <span>
                                                    <t t-out="shipping_partner.display_name or ''"/><br/>
                                                    <t t-if="shipping_partner.street or shipping_partner.street2">
                                                        <t t-out="shipping_partner.street or ''"/>
                                                        <t t-if="shipping_partner.street and shipping_partner.street2">&#160;</t>
                                                        <t t-out="shipping_partner.street2 or ''"/><br/>
                                                    </t>
                                                    <t t-if="shipping_partner.zip or shipping_partner.city">
                                                        <t t-out="shipping_partner.zip or ''"/>
                                                        <t t-if="shipping_partner.zip and shipping_partner.city">&#160;</t>
                                                        <t t-out="shipping_partner.city or ''"/><br/>
                                                    </t>
                                                    <t t-if="shipping_partner.country_id">
                                                        <t t-out="shipping_partner.country_id.name or ''"/>
                                                    </t>
                                                </span>
                                            </t>

                                            <br/>
                                            <br/>

                                            <t t-if="invoice_partner">
                                                <t t-if="shipping_partner and invoice_partner.id == shipping_partner.id">
                                                    <p style="margin-bottom:0; margin-top:6px;">
                                                        <strong>Customer &amp; Delivery Address:</strong>
                                                    </p>
                                                </t>
                                                <t t-else="">
                                                    <p style="margin-bottom:0; margin-top:6px;">
                                                        <strong>Customer Address:</strong>
                                                    </p>
                                                </t>

                                                <span>
                                                    <t t-out="invoice_partner.name or ''"/><br/>
                                                    <t t-if="invoice_partner.street or invoice_partner.street2">
                                                        <t t-out="invoice_partner.street or ''"/>
                                                        <t t-if="invoice_partner.street and invoice_partner.street2">&#160;</t>
                                                        <t t-out="invoice_partner.street2 or ''"/><br/>
                                                    </t>
                                                    <t t-if="invoice_partner.zip or invoice_partner.city">
                                                        <t t-out="invoice_partner.zip or ''"/>
                                                        <t t-if="invoice_partner.zip and invoice_partner.city">&#160;</t>
                                                        <t t-out="invoice_partner.city or ''"/><br/>
                                                    </t>
                                                    <t t-if="invoice_partner.country_id">
                                                        <t t-out="invoice_partner.country_id.name or ''"/>
                                                    </t>
                                                </span>
                                            </t>

                                            <t t-if="not invoice_partner">
                                                <span>
                                                    <t t-out="o.partner_id.name or ''"/><br/>
                                                    <t t-if="o.partner_id.street or o.partner_id.street2">
                                                        <t t-out="o.partner_id.street or ''"/>
                                                        <t t-if="o.partner_id.street and o.partner_id.street2">&#160;</t>
                                                        <t t-out="o.partner_id.street2 or ''"/><br/>
                                                    </t>
                                                    <t t-if="o.partner_id.zip or o.partner_id.city">
                                                        <t t-out="o.partner_id.zip or ''"/>
                                                        <t t-if="o.partner_id.zip and o.partner_id.city">&#160;</t>
                                                        <t t-out="o.partner_id.city or ''"/><br/>
                                                    </t>
                                                    <t t-if="o.partner_id.country_id">
                                                        <t t-out="o.partner_id.country_id.name or ''"/>
                                                    </t>
                                                </span>
                                            </t>
                                        </div>
                                    </td>

                                    <td class="right-col">
                                        <table class="layout-table">
                                            <t t-if="inv">
                                                <tr>
                                                    <td class="meta-label">Invoice Number:</td>
                                                    <td class="meta-value">
                                                        <t t-esc="inv.name"/>
                                                    </td>
                                                </tr>
                                            </t>

                                            <t t-if="inv and inv.invoice_date">
                                                <tr>
                                                    <td class="meta-label">Invoice Date:</td>
                                                    <td class="meta-value">
                                                        <span t-field="inv.invoice_date" t-options="{'widget': 'date', 'format': 'dd.MM.yyyy'}"/>
                                                    </td>
                                                </tr>
                                            </t>

                                            <t t-if="sale_order and sale_order.name">
                                                <tr>
                                                    <td class="meta-label meta-label-wide">Order Number:</td>
                                                    <td class="meta-value">
                                                        <t t-esc="sale_order.name"/>
                                                    </td>
                                                </tr>
                                            </t>

                                            <t t-if="sale_order and sale_order.date_order">
                                                <tr>
                                                    <td class="meta-label">Order Date:</td>
                                                    <td class="meta-value">
                                                        <span t-field="sale_order.date_order" t-options="{'widget': 'date', 'format': 'dd.MM.yyyy'}"/>
                                                    </td>
                                                </tr>
                                            </t>

                                            <t t-if="inv and inv.invoice_date_due">
                                                <tr>
                                                    <td class="meta-label">Due Date:</td>
                                                    <td class="meta-value">
                                                        <span t-field="inv.invoice_date_due" t-options="{'widget': 'date', 'format': 'dd.MM.yyyy'}"/>
                                                    </td>
                                                </tr>
                                            </t>

                                            <t t-if="o.partner_id.ref">
                                                <tr>
                                                    <td class="meta-label">Client Number:</td>
                                                    <td class="meta-value">
                                                        <t t-esc="o.partner_id.ref"/>
                                                    </td>
                                                </tr>
                                            </t>
                                            <t t-else="">
                                                <tr>
                                                    <td class="meta-label">Client Number:</td>
                                                    <td class="meta-value">
                                                        <t t-esc="o.partner_id.id"/>
                                                    </td>
                                                </tr>
                                            </t>

                                            <t t-if="sale_order and sale_order.client_order_name">
                                                <tr>
                                                    <td class="meta-label">Ordered by:</td>
                                                    <td class="meta-value">
                                                        <t t-esc="sale_order.client_order_name"/>
                                                    </td>
                                                </tr>
                                            </t>

                                            <t t-if="sale_order and sale_order.client_order_number">
                                                <tr>
                                                    <td class="meta-label">Your Order Number:</td>
                                                    <td class="meta-value">
                                                        <t t-esc="sale_order.client_order_number"/>
                                                    </td>
                                                </tr>
                                            </t>

                                            <t t-if="sale_order and 'lease_agreement_no' in sale_order and sale_order.lease_agreement_no">
                                                <tr>
                                                    <td style="font-size:13px;">Lease Agreement No.:</td>
                                                    <td style="font-size:13px; padding-left:3px;"><t t-esc="sale_order.lease_agreement_no"/></td>
                                                </tr>
                                            </t>
                                            
                                            <t t-if="sale_order and sale_order.carrier_id">
                                                <tr>
                                                    <td class="meta-label">Shipping Method:</td>
                                                    <td class="meta-value">
                                                        <t t-esc="sale_order.carrier_id.name"/>
                                                    </td>
                                                </tr>
                                            </t>

                                            <t t-if="sale_order and sale_order.incoterm">
                                                <tr>
                                                    <td class="meta-label">Delivery Terms:</td>
                                                    <td class="meta-value">
                                                        <t t-esc="sale_order.incoterm.name"/>
                                                    </td>
                                                </tr>
                                            </t>

                                            <t t-if="sale_order and sale_order.user_id and sale_order.user_id.name">
                                                <tr>
                                                    <td class="meta-label">Salesperson:</td>
                                                    <td class="meta-value">
                                                        <t t-esc="sale_order.user_id.name"/>
                                                    </td>
                                                </tr>
                                            </t>

                                            <t t-if="sale_order and sale_order.user_id and sale_order.user_id.phone">
                                                <tr>
                                                    <td class="meta-label">Phone:</td>
                                                    <td class="meta-value">
                                                        <t t-esc="sale_order.user_id.phone"/>
                                                    </td>
                                                </tr>
                                            </t>

                                            <t t-if="sale_order and sale_order.user_id and sale_order.user_id.login">
                                                <tr>
                                                    <td class="meta-label">Email:</td>
                                                    <td class="meta-value">
                                                        <t t-esc="sale_order.user_id.login"/>
                                                    </td>
                                                </tr>
                                            </t>

                                            <t t-if="sale_order and sale_order.client_order_ref">
                                                <tr>
                                                    <td class="meta-label project-cell">Project:</td>
                                                    <td class="meta-value project-cell">
                                                        <t t-esc="sale_order.client_order_ref"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <h2 class="title-blue">
                                Delivery Slip
                            </h2>
                            <!--
                            <div class="not-first-page continued-header table-borderless">
                                <table class="layout-table">
                                    <tr>
                                        <td>
                                            <strong>Delivery Slip</strong>
                                            <span class="continued-sep">|</span>
                                            <span>No. <t t-esc="o.name"/></span>
                                            <t t-if="o.origin">
                                                <span class="continued-sep">|</span>
                                                <span>Order <t t-esc="o.origin"/></span>
                                            </t>
                                            <t t-if="o.partner_id">
                                                <span class="continued-sep">|</span>
                                                <span>Customer <t t-esc="o.partner_id.display_name"/></span>
                                            </t>
                                            <span class="continued-sep">|</span>
                                            <span>Page <span class="page"/> / <span class="topage"/></span>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            -->
                            <!-- HIER: Klasse 'table' entfernt, um ungewollte Rahmen zu vermeiden -->
                            <table class="layout-table table-borderless" name="stock_move_table" style="font-size:14px; width:100%; border-collapse:collapse; border:none !important;">
                                <thead>
                                    <tr style="margin-bottom:10px;">
                                        <td t-if="o.origin" colspan="1" class="center" style="padding-bottom:15px;">
                                            <strong>Order</strong><br/>
                                            <span t-field="o.origin"/>
                                        </td>

                                        <td t-if="o.state" colspan="2" class="center" style="padding-bottom:15px;">
                                            <strong>Delivery Slip Date</strong><br/>
                                            <span t-if="o.state == 'done'" t-field="o.date_done" t-options="{'widget': 'date', 'format': 'dd.MM.yyyy'}"/>
                                            <span t-else="" t-field="o.scheduled_date" t-options="{'widget': 'date', 'format': 'dd.MM.yyyy'}"/>
                                        </td>

                                        <td t-if="o.name" colspan="2" class="center" style="padding-bottom:15px;">
                                            <strong>Delivery Slip No.</strong><br/>
                                            <span t-field="o.name"/>
                                        </td>
                                    </tr>

                                    <tr class="spacer-row">
                                        <td colspan="5"/>
                                    </tr>

                                    <tr class="head-bottom">
                                        <th class="line-pos left cell-sm">POS</th>
                                        <th class="line-product left cell-sm">Product</th>
                                        <th class="line-qty-order left cell-sm">Order Quantity</th>
                                        <th class="line-qty-delivery left cell-sm">Delivery Quantity</th>
                                        <th class="line-backorder left cell-sm">Backorder</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <t t-set="lines" t-value="o.move_ids.filtered(lambda x: x.product_uom_qty)"/>
                                    <t t-set="pos" t-value="0"/>

                                    <tr t-foreach="lines" t-as="move" class="line-bottom">
                                        <!-- HIER: Das pos=pos+1 Konstrukt ist schon drin, fungiert als ID -->
                                        <t t-set="pos" t-value="pos + 1"/>

                                        <td class="line-cell">
                                            <t t-esc="pos"/>
                                        </td>

                                        <td class="line-cell">
                                            <span t-field="move.product_id.display_name"/>
                                            <t t-if="move.sale_line_id and move.sale_line_id.name 
                                                     and move.sale_line_id.name != move.product_id.display_name">
                                                <br/>
                                                <span t-out="move.sale_line_id.name" 
                                                      style="font-size:12px; color:#555; white-space:pre-wrap;"/>
                                            </t>
                                            <t t-elif="not o.is_description_report and move.product_id.description">
                                                <br/>
                                                <span t-field="move.product_id.description"/>
                                            </t>
                                        </td>

                                        <td class="line-cell text-end">
                                            <span t-field="move.product_uom_qty"/>
                                            <span t-field="move.product_uom"/>
                                        </td>

                                        <td class="line-cell text-end">
                                            <span t-field="move.quantity"/>
                                            <span t-field="move.product_uom"/>
                                        </td>

                                        <td class="line-cell text-end">
                                            <t t-set="backorder_qty" t-value="move.product_uom_qty - move.quantity"/>
                                            <t t-esc="'{:.2f}'.format(backorder_qty if backorder_qty > 0 else 0.0)"/>
                                            <span t-field="move.product_uom"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <div class="signature-wrap">
                                <p class="signature-note">The proper receipt of the goods is hereby confirmed.</p>

                                <table class="signature-table">
                                    <tr>
                                        <td class="signature-date-col">
                                            <div>Date</div>
                                            <div class="signature-line"></div>
                                        </td>

                                        <td class="signature-gap-col"></td>

                                        <td class="signature-sign-col">
                                            <div>Signature</div>
                                            <div class="signature-line"></div>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </main>
                </t>
            </t>
        </xpath>
    </template>
</odoo>
