                        <!--</table>-->

                        <!--<table style="width:100%; border-collapse: collapse; margin-bottom: 20px; margin-top: 20px; font-size:14px;">-->
                        <!--    <tr>-->
                                <!-- Column 1: Auftrag -->
                        <!--        <td t-if="o.origin" style="width:33%; padding: 5px;">-->
                        <!--            <strong>Auftrag</strong><br/>-->
                        <!--            <span t-field="o.origin">S0001</span>-->
                        <!--        </td>-->
                        
                                <!-- Column 2: Lieferscheindatum -->
                        <!--        <td t-if="o.state" style="width:33%; padding: 5px;">-->
                        <!--            <strong>Lieferscheindatum</strong><br/>-->
                        <!--            <span t-if="o.state == 'done'" t-field="o.date_done" t-options="{'format': 'dd.MM.yyyy'}"/>-->
                        <!--            <span t-else="" t-field="o.scheduled_date" t-options="{'format': 'dd.MM.yyyy'}"/>-->
                        <!--        </td>-->
                        
                                <!-- Column 3: Lieferschein Nr. -->
                        <!--        <td t-if="o.name" style="width:33%; padding: 5px;">-->
                        <!--            <strong>Lieferschein Nr.</strong><br/>-->
                        <!--            <span t-field="o.name"/>-->
