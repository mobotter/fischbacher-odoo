                        <!--            <strong>Bestelldatum:</strong> <span t-field="o.sale_id.date_order" t-options="{'format': 'dd.MM.yyyy'}"/>-->
                        <!--        </td>-->
                        <!--        <td style="width:70%; padding: 2px 5px;" rowspan="2">-->
                        <!--            <strong>Versandbedingungen:</strong> <span t-field="o.sale_id.carrier_id"/>-->
                        <!--        </td>-->
                        <!--    </tr>-->
                        <!--    <tr>-->
                        <!--        <td style="width:50%; padding: 2px 5px;">-->
                        <!--            <strong>Bestellt durch:</strong> <span t-field="o.sale_id.order_door"/>-->
