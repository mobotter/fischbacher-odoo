<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View Vererbung für res.partner, um den Smart-Button hinzuzufügen -->
        <record id="view_partner_form_inherit_order_lines" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.order.lines</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <!-- Smart Buttons befinden sich im div mit name="button_box" -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_sale_order_lines" 
                            type="object" 
                            class="oe_stat_button" 
                            icon="fa-list-ul">
                        <!-- Statinfo zeigt eine Zahl an (braucht ein Compute-Feld im Python-Model) 
                             oder einfach nur einen Text -->
                        <div class="o_stat_info">
                            <span class="o_stat_text">Auftrags-</span>
                            <span class="o_stat_text">zeilen</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
