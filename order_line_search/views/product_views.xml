<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Smart Button für das Product Template (Hauptprodukt) -->
        <record id="view_product_template_form_inherit_order_lines" model="ir.ui.view">
            <field name="name">product.template.form.inherit.order.lines</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_product_sale_order_lines" 
                            type="object" 
                            class="oe_stat_button" 
                            icon="fa-shopping-cart">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Auftrags-</span>
                            <span class="o_stat_text">historie</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>

        <!-- Smart Button für die Product Variant (product.product) -->
        <record id="view_product_product_form_inherit_order_lines" model="ir.ui.view">
            <field name="name">product.product.form.inherit.order.lines</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_product_sale_order_lines" 
                            type="object" 
                            class="oe_stat_button" 
                            icon="fa-shopping-cart">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Auftrags-</span>
                            <span class="o_stat_text">historie</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
