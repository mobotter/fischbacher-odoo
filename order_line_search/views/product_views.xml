<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_product_product_form_inherit_order_lines" model="ir.ui.view">
            <field name="name">product.product.form.inherit.order.lines</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <!-- Wir suchen gezielt die button_box, die Odoo standardmäßig verwendet -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_product_sale_order_lines" 
                            type="object" 
                            class="oe_stat_button" 
                            icon="fa-shopping-cart">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Auftrags-</span>
                            <span class="o_stat_text">historie</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
