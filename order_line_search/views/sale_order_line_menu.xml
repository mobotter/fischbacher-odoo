<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- 1. Aktion (Window Action) für Auftragszeilen definieren -->
        <record id="action_sale_order_line_reporting" model="ir.actions.act_window">
            <field name="name">Auftragszeilen</field>
            <field name="res_model">sale.order.line</field>
            <field name="view_mode">list,form,pivot,graph</field>
            <field name="domain">[('state', 'in', ['sale', 'done'])]</field>
            <field name="context">{'search_default_group_by_product': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Noch keine Auftragszeilen vorhanden.
                </p>
                <p>
                    Hier können Sie alle Positionen Ihrer bestätigten Aufträge durchsuchen, analysieren und nach Artikeln oder Kunden filtern.
                </p>
            </field>
        </record>

        <!-- 2. Menüpunkt unter Verkauf -> Berichtswesen einfügen -->
        <menuitem id="menu_sale_order_line_reporting"
                  name="Auftragszeilen"
                  parent="sale.menu_sale_report"
                  action="action_sale_order_line_reporting"
                  sequence="25"/>
                  
        <!-- 3. Erweiterung der Suchansicht für sale.order.line (falls nicht schon standardmäßig ausreichend) -->
        <record id="view_sales_order_line_filter_custom" model="ir.ui.view">
            <field name="name">sale.order.line.select.custom</field>
            <field name="model">sale.order.line</field>
            <field name="inherit_id" ref="sale.view_sales_order_line_filter"/>
            <field name="arch" type="xml">
                <!-- Suchfeld für Artikelnummer (Interne Referenz) -->
                <xpath expr="//field[@name='order_partner_id']" position="after">
                    <field name="product_id" string="Artikel/Artikelnummer" filter_domain="['|', ('product_id.default_code', 'ilike', self), ('product_id.name', 'ilike', self)]"/>
                </xpath>
                
                <!-- Gruppierungen für Kunden und Produkte hinzufügen -->
                <xpath expr="//group" position="inside">
                    <filter string="Kunde" name="group_by_partner" domain="[]" context="{'group_by':'order_partner_id'}"/>
                    <filter string="Produkt" name="group_by_product" domain="[]" context="{'group_by':'product_id'}"/>
                </xpath>
            </field>
        </record>

        <!-- 4. Angepasste Listenansicht zur besseren Übersicht (Odoo 19 nutzt <list>) -->
        <record id="view_order_line_tree_custom" model="ir.ui.view">
            <field name="name">sale.order.line.list.custom</field>
            <field name="model">sale.order.line</field>
            <field name="arch" type="xml">
                <list string="Auftragszeilen" create="false" edit="false" delete="false">
                    <!-- Spalten wie gewünscht -->
                    <field name="order_id" string="Auftragsreferenz" widget="many2one"/>
                    <field name="order_partner_id" string="Kunde" widget="many2one"/>
                    <!-- Das Datum holen wir uns über das related field vom Auftrag -->
                    <field name="create_date" string="Verkaufsdatum" widget="date"/>
                    <field name="name" string="Beschreibung"/>
                    <field name="salesman_id" string="Vertriebsmitarbeiter" widget="many2one_avatar_user"/>
                    <field name="product_uom_qty" string="Menge" sum="Gesamtmenge"/>
                    <field name="discount" string="Rabatt (%)"/>
                    <field name="price_unit" string="Verkaufspreis"/>
                    
                    <!-- Einkaufspreis (Setzt das Modul 'sale_margin' voraus) -->
                    <field name="purchase_price" string="Einkaufspreis" optional="show"/>
                    
                    <!-- Routen (Setzt 'sale_stock' voraus) -->
                    <field name="route_id" string="Routen" optional="show"/>
                    
                    <!-- Status ausblenden, aber für Filter bereithalten -->
                    <field name="state" invisible="1"/>

                    <!-- Action-Buttons / Links am Ende der Zeile -->
                    <button name="action_open_product" type="object" string="Produkt" icon="fa-cube" class="btn-link"/>
                    <button name="action_open_partner" type="object" string="Kunde" icon="fa-user" class="btn-link"/>
                    <!-- Den Auftrag öffnen wir direkt über die order_id per Action -->
                    <button name="action_open_order" type="object" string="Auftrag" icon="fa-file-text-o" class="btn-link"/>
                </list>
            </field>
        </record>
        
        <!-- Standard List/Form-View Referenzen zur Window-Action hinzufügen -->
        <record id="action_sale_order_line_reporting_tree" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <!-- HIER AUCH: view_mode auf 'list' ändern -->
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_order_line_tree_custom"/>
            <field name="act_window_id" ref="action_sale_order_line_reporting"/>
        </record>
    </data>
</odoo>
