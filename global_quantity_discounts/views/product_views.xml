<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Basisformular der Produktvorlage. Gilt automatisch auch für
        product_template_only_form_view und product_normal_form_view
        (Variante), da beide davon erben.
    -->
    <record id="product_template_form_view_discount_allowed" model="ir.ui.view">
        <field name="name">product.template.form.discount.allowed</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='list_price_uom']" position="after">
                <field name="discount_allowed"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_tree_view_discount_allowed" model="ir.ui.view">
        <field name="name">product.template.list.discount.allowed</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="discount_allowed" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
