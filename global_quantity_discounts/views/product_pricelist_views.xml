<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_pricelist_view_global_quantity" model="ir.ui.view">
        <field name="name">product.pricelist.form.global.quantity</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='pricelist_settings']" position="inside">
                <field name="is_global_quantity_pricelist"/>
            </xpath>
        </field>
    </record>

    <record id="product_pricelist_view_tree_global_quantity" model="ir.ui.view">
        <field name="name">product.pricelist.list.global.quantity</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="is_global_quantity_pricelist" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
