<odoo>
    <record id="sale_order_form_inherit_partner_blocked" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.partner.blocked</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('sale_blocked', '=', False), ('customer_rank', '>', 0), ('parent_id', '=', False)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
