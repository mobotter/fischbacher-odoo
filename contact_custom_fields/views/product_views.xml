<odoo>
    <record id="product_template_only_form_view_inherit_product_pricelist_only" model="ir.ui.view">
        <field name="name">product.template.only.form.view.inherit.product.pricelist.only</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="use_only_product_pricelist"/>
            </xpath>
        </field>
    </record>
</odoo>
