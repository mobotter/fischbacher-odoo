<odoo>
    <record id="product_template_only_form_view_inherit_strict_pricelist_lock" model="ir.ui.view">
        <field name="name">product.template.only.form.view.inherit.strict.pricelist.lock</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_storable']" position="after">
                <label for="strict_pricelist_lock"/>
                <div>
                    <field name="strict_pricelist_lock"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
