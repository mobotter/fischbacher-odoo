<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- Haupt-Layout-Anpassung (für alle DIN5008-Docs) -->
    <template id="external_layout_din5008_inherited" inherit_id="l10n_din5008.external_layout_din5008" priority="20">
      <xpath expr="//div[contains(@class, 'address') or contains(@class, 'o_company_layout')]" position="replace">
        <div class="address" id="din5008_report_main_address" style="font-size:9px;">
          <t t-if="company.name">
            <span t-field="company.name"/>
          </t>
          <t t-if="company.street">
            <span>|</span> <span t-field="company.street"/>
          </t>
          <t t-if="company.zip">
            <span>|</span> <span t-field="company.zip"/>
          </t>
          <t t-if="company.city">
            <span>|</span> <span t-field="company.city"/>
          </t>
          <hr class="company_invoice_line"/>
        </div>
      </xpath>
      
      <xpath expr="//table[contains(@class, 'din_company_info')]" position="after">
        <colgroup>
          <col style="width: 70%;"/>
          <col style="width: 30%;"/>
        </colgroup>
      </xpath>
      
      <xpath expr="//h2 | //h1" position="replace">
        <h3>
          <span t-if="not o and not docs" style="color:#0069b4;">Invoice</span>
          <span t-else="">
            <t t-set="o" t-value="docs[0]" t-if="not o"/>
            <t t-if="din5008_document_title">
              <t t-out="din5008_document_title" style="color:#0069b4;"/>
            </t>
            <span t-elif="'name' in o" t-field="o.name" style="color:#0069b4;"/>
          </span>
        </h3>
      </xpath>
      
      <xpath expr="//div[contains(@class, 'company_details') or contains(@class, 'o_report_footer')]" position="replace">
        <div class="page_number" style="position: absolute; bottom: 0; right: 0; font-size: 9px; color: #666;">
          Page: <span class="page"/> of <span class="topage"/>
        </div>
        <div t-attf-style="font-size: 9px; margin-bottom: 4px;">
          Kommanditgesellschaft · Sitz München, HRA 116761 · Persönlich haftende Gesellschafterin: Fischbacher GmbH · Sitz München · HRB <t t-out="company.company_registry"/>  
          <br/>
          USt-Id. <t t-out="company.vat"/> · ST-Nr. 143/518/60562 · Geschäftsführer: <t t-out="company.report_legal_reps or 'Dipl.-Ing. Marcus Mayr, Dipl.-Ing. (FH) Moritz Zwez'"/>
        </div>
        <table class="table-borderless" style="font-size: 9px; width: 100%; border-collapse: collapse;">
          <colgroup>
            <col style="width: 30%;"/>
            <col style="width: 40%;"/>
            <col style="width: 30%;"/>
          </colgroup>
          <tr>
            <td style="vertical-align: top; padding-right: 8px;">
              <ul class="list-inline text-nowrap">
                <li t-if="company.company_details">
                  <span t-field="company.company_details"/>
                </li>
              </ul>
            </td>
            <td style="vertical-align: top; padding-right: 8px;">
              <ul class="list-inline">
                <li t-if="company.report_footer">
                  <span t-field="company.report_footer"/>
                </li>
              </ul>
            </td>
            <td t-if="company.partner_id.bank_ids" style="vertical-align: top;">
              <ul class="list-inline">
                <li style="color:#0069b4;">Banken</li>
                <t t-foreach="company.partner_id.bank_ids[:2]" t-as="bank">
                  <li><span t-field="bank.bank_id.name"/></li>
                  <li>IBAN: <span t-field="bank.acc_number"/></li>
                  <li>BIC: <span t-field="bank.bank_id.bic"/></li>
                </t>
              </ul>
            </td>
          </tr>
        </table>       
      </xpath>
      
      <xpath expr="//div[contains(@class, 'text-end')]" position="replace"/>
    </template>

    <!-- CSS-Anpassung -->
    <template id="din5008_css_inherit" inherit_id="l10n_din5008.din5008_css">
      <xpath expr="//t[@t-elif]" position="before">
        <t t-elif="layout == 'l10n_din5008.external_layout_din5008'">
          &amp;.din_page {
            .page {
              [name=invoice_line_table],
              [name=stock_move_table],
              .o_main_table {
                thead {
                  border-bottom: 1px solid #d3d3d3 !important;
                  color: <t t-out="secondary"/>;
                }
                tbody tr {
                  border-bottom: 1px solid #d3d3d3 !important;
                }
              }
            }
            &amp;.invoice_note {
              h3 {
                margin-left: 5mm;
                margin-right: 10mm;
                margin-top: 8.46mm;
                color: <t t-out="primary"/>;
              }
            }
          }
        </t>
      </xpath>
    </template>

    <!-- Sale-Order-spezifisch (KOMPLETT KORRIGIERT) -->
    <template id="report_saleorder_document_inherit_fb" inherit_id="sale.report_saleorder_document" priority="20">
      <!-- FIX 1: Robuster XPath für Seitenummer -->
      <xpath expr="//div[contains(@class, 'header') or //h1 or //h2][1]" position="after">
        <div style="text-align: right; font-size: 10px; margin-top: 5px; color: #666;">
          Page: <span class="page"/> of <span class="topage"/>
        </div>
      </xpath>
      
      <!-- FIX 2: Robuster Company Details XPath -->
      <xpath expr="//div[contains(@class, 'col-auto') or contains(@class, 'company_details') or contains(@class, 'o_report_layout_standard')]" position="replace">
        <div class="company_details">
          <table class="table-borderless">
            <tr>
              <td>
                <p t-attf="Kommanditgesellschaft, Sitz München, HRA 116761 · Persönlich haftende Gesellschafterin: Fischbacher GmbH, Sitz München HRB 278787 USt-Id.-DE 355 684 446 · ST-Nr. 143/518/60562 · Geschäftsführer: {company.report_legal_reps or 'Dipl.-Ing. Marcus Mayr, Dipl.-Ing. (FH) Moritz Zwez'}"></p>
              </td>
            </tr>
          </table>
          <table class="table-borderless" style="padding-top:10px;">
            <tr>
              <td style="width:33%;">
                <ul class="list-inline text-nowrap">
                  <li style="color:#0069b4;">Hausanschrift</li>
                  <li t-if="company.company_details"><span t-field="company.company_details"/></li>
                </ul>
              </td>
              <td style="width:33%;">
                <ul class="list-inline">
                  <li style="color:#0069b4;">Kontakt</li>
                  <li><span style="color:#0069b4;">Telefon</span> <t t-esc="company.phone or '089 / 14 99 08-0'"/></li>
                  <li><span style="color:#0069b4;">Telefax</span> <t t-esc="company.fax or '089 / 14 99 08-36'"/></li>
                </ul>
              </td>
              <td t-if="company.partner_id.bank_ids" style="width:34%;">
                <ul class="list-inline">
                  <t t-foreach="company.partner_id.bank_ids[:2]" t-as="bank">
                    <li><span t-field="bank.bank_id.name"/></li>
                    <li>IBAN <span t-field="bank.acc_number"/></li>
                    <li>BIC <span t-field="bank.bank_id.bic"/></li>
                  </t>
                </ul>
              </td>
            </tr>
          </table>
        </div>
      </xpath>
      
      <!-- Tabellen-Styling (robust) -->
      <xpath expr="//table[contains(@class, 'table') or contains(@class, 'o_main_table')]/thead" position="attributes">
        <attribute name="style">border-bottom:1px solid #0069b4;</attribute>
      </xpath>
    </template>

    <!-- Invoice-Styling (wie vorher) -->
    <template id="report_invoice_document_inherit_fb" inherit_id="account.report_invoice_document">
      <xpath expr="//table[contains(@class, 'table') or contains(@class, 'o_main_table')]/thead" position="attributes">
        <attribute name="style">border-bottom:1px solid #0069b4;</attribute>
      </xpath>
    </template>
  </data>
</odoo>
