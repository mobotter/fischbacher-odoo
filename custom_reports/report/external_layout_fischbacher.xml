<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Zentrales External Layout für alle Reports, die
            l10n_din5008.external_layout_din5008 verwenden.

            WICHTIG:
            - Adresscontainer bleibt erhalten.
            - Empfängeradresse wird über die Variable "address" gerendert.
            - Keine breiten XPath-Ausdrücke auf o_company_layout,
              o_report_footer oder text-end.
        -->
        <template id="external_layout_din5008_inherited"
                  inherit_id="l10n_din5008.external_layout_din5008"
                  priority="20">

            <!--
                Nur den tatsächlichen DIN-Adresscontainer ersetzen.
                Der Rücksendeabsender steht oberhalb der Empfängeradresse.
            -->
            <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' address ')]"
                   position="replace">

                <div class="address"
                     id="din5008_report_main_address">

                    <!-- Rücksendeangabe: klein und einzeilig -->
                    <div class="din5008_return_address"
                         style="
                            font-size:8pt;
                            line-height:3.5mm;
                            white-space:nowrap;
                            overflow:hidden;
                            border-bottom:0.2mm solid #d3d3d3;
                            margin-bottom:1.5mm;
                         ">
                        <t t-if="company.name">
                            <span t-field="company.name"/>
                        </t>
                        <t t-if="company.street">
                            <span> · </span>
                            <span t-field="company.street"/>
                        </t>
                        <t t-if="company.zip or company.city">
                            <span> · </span>
                            <span t-field="company.zip"/>
                            <t t-if="company.zip and company.city">
                                <span> </span>
                            </t>
                            <span t-field="company.city"/>
                        </t>
                    </div>

                    <!--
                        Die vom Elternreport vorbereitete Empfängeradresse.
                        Nicht durch doc.partner_id ersetzen:
                        address kann Liefer-, Rechnungs- oder
                        report-spezifisch formatierte Anschriften enthalten.
                    -->
                    <t t-if="address">
                        <t t-out="address"/>
                    </t>
                </div>
            </xpath>

            <!--
                Nur dann verwenden, wenn die Ursprungsvorlage tatsächlich
                genau eine Tabelle mit der Klasse din_company_info enthält.

                Statt nach der Tabelle ein separates colgroup einzufügen,
                wird das vorhandene colgroup ersetzt. Ein colgroup außerhalb
                einer table wäre ungültiges HTML und kann von wkhtmltopdf
                unvorhersehbar gerendert werden.
            -->
            <xpath expr="//table[contains(concat(' ', normalize-space(@class), ' '), ' din_company_info ')]/colgroup"
                   position="replace">
                <colgroup>
                    <col style="width:70%;"/>
                    <col style="width:30%;"/>
                </colgroup>
            </xpath>

            <!--
                Dokumenttitel ausschließlich im DIN-Informationsbereich
                anpassen. Das exakte name-Attribut kann je nach
                Odoo-/l10n_din5008-Version abweichen.

                Falls das Elternlayout KEIN h2 mit name="document_title"
                enthält, diesen XPath anhand des finalen Parent-Views
                anpassen, statt wieder //h1 | //h2 zu verwenden.
            -->
            <xpath expr="//h2[@name='document_title']"
                   position="replace">
                <h2 name="document_title"
                    style="color:#0069b4;">

                    <t t-if="not o and not docs">
                        <span>Invoice</span>
                    </t>

                    <t t-else="">
                        <t t-if="not o and docs">
                            <t t-set="o" t-value="docs[0]"/>
                        </t>

                        <t t-if="din5008_document_title">
                            <t t-out="din5008_document_title"/>
                        </t>

                        <t t-elif="o and 'name' in o._fields">
                            <span t-field="o.name"/>
                        </t>
                    </t>
                </h2>
            </xpath>

            <!--
                Nur den Footer-Detailcontainer ersetzen.
                Nicht gleichzeitig o_report_footer matchen: Dieser kann
                je nach Version ein anderer bzw. übergeordneter Container sein.
            -->
            <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' company_details ')]"
                   position="replace">

                <div class="company_details"
                     style="font-size:9px;">

                    <div style="margin-bottom:4px;">
                        Kommanditgesellschaft · Sitz München, HRA 116761 ·
                        Persönlich haftende Gesellschafterin: Fischbacher GmbH ·
                        Sitz München ·
                        HRB <t t-out="company.company_registry or ''"/>
                        <br/>
                        USt-Id. <t t-out="company.vat or ''"/> ·
                        ST-Nr. 143/518/60562 ·
                        Geschäftsführer:
                        <t t-out="company.report_legal_reps or 'Dipl.-Ing. Marcus Mayr, Dipl.-Ing. (FH) Moritz Zwez'"/>
                    </div>

                    <table class="table table-borderless"
                           style="
                                width:100%;
                                border-collapse:collapse;
                                font-size:9px;
                           ">
                        <colgroup>
                            <col style="width:30%;"/>
                            <col style="width:40%;"/>
                            <col style="width:30%;"/>
                        </colgroup>

                        <tbody>
                            <tr>
                                <td style="vertical-align:top; padding-right:8px;">
                                    <div style="color:#0069b4;">Hausanschrift</div>
                                    <t t-if="company.company_details">
                                        <div t-field="company.company_details"/>
                                    </t>
                                </td>

                                <td style="vertical-align:top; padding-right:8px;">
                                    <div style="color:#0069b4;">Kontakt</div>
                                    <t t-if="company.report_footer">
                                        <div t-field="company.report_footer"/>
                                    </t>
                                </td>

                                <td style="vertical-align:top;">
                                    <t t-if="company.partner_id.bank_ids">
                                        <div style="color:#0069b4;">Banken</div>

                                        <t t-foreach="company.partner_id.bank_ids[:2]"
                                           t-as="bank">
                                            <div>
                                                <span t-field="bank.bank_id.name"/>
                                            </div>
                                            <div>
                                                IBAN:
                                                <span t-field="bank.acc_number"/>
                                            </div>
                                            <div>
                                                BIC:
                                                <span t-field="bank.bank_id.bic"/>
                                            </div>
                                        </t>
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!--
                        page/topage werden beim PDF-Rendering ersetzt.
                        Sie gehören in den Footer und nicht zusätzlich
                        in einzelne Dokumentreports.
                    -->
                    <div class="page_number"
                         style="
                            position:absolute;
                            right:0;
                            bottom:0;
                            font-size:9px;
                            color:#666;
                         ">
                        Page: <span class="page"/> of <span class="topage"/>
                    </div>
                </div>
            </xpath>

        </template>

        <!--
            CSS nur für das DIN-5008-External-Layout.
            Das vorhandene SCSS-Muster des Elternviews bleibt erhalten.
        -->
        <template id="din5008_css_inherit"
                  inherit_id="l10n_din5008.din5008_css"
                  priority="20">

            <xpath expr="//t[@t-elif]"
                   position="before">

                <t t-elif="layout == 'l10n_din5008.external_layout_din5008'">
                    &amp;.din_page {
                        .page {
                            [name=invoice_line_table],
                            [name=stock_move_table],
                            .o_main_table {
                                thead {
                                    border-bottom: 1px solid #d3d3d3 !important;
                                    color: <t t-out="secondary"/>;
                                }

                                tbody tr {
                                    border-bottom: 1px solid #d3d3d3 !important;
                                }
                            }
                        }

                        &amp;.invoice_note {
                            h3 {
                                margin-left: 5mm;
                                margin-right: 10mm;
                                margin-top: 8.46mm;
                                color: <t t-out="primary"/>;
                            }
                        }
                    }
                </t>

            </xpath>
        </template>

        <!--
            Sale Order:
            - Keine Seitenzahl mehr hier: Sie kommt zentral aus dem Footer.
            - Kein Footer-/company_details-Replace mehr hier:
              Das würde den zentralen DIN-5008-Footer überschreiben.
            - Nur Tabellenkopf gezielt formatieren.
        -->
        <template id="report_saleorder_document_inherit_fb"
                  inherit_id="sale.report_saleorder_document"
                  priority="20">

            <xpath expr="//table[@id='sales_order_table']/thead"
                   position="attributes">
                <attribute name="style">border-bottom:1px solid #0069b4;</attribute>
            </xpath>

        </template>

        <!--
            Rechnung:
            Nicht alle Tabellenköpfe treffen, sondern nur die
            Rechnungspositionsliste. In Odoo ist hierfür typischerweise
            name="invoice_line_table" vorgesehen.
        -->
        <template id="report_invoice_document_inherit_fb"
                  inherit_id="account.report_invoice_document"
                  priority="20">

            <xpath expr="//table[@name='invoice_line_table']/thead"
                   position="attributes">
                <attribute name="style">border-bottom:1px solid #0069b4;</attribute>
            </xpath>

        </template>

    </data>
</odoo>
