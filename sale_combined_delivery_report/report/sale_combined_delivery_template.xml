<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_combined_delivery_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- TITEL -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h2>Lieferschein (Gesamt)</h2>
                                <h4>
                                    Auftrag: <strong t-field="o.name"/>
                                    <t t-if="o.client_order_ref">
                                        &amp;nbsp;| Ihre Referenz: <span t-field="o.client_order_ref"/>
                                    </t>
                                </h4>
                            </div>
                        </div>

                        <!-- ADRESSE + META -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <strong>Lieferadresse:</strong><br/>
                                <address>
                                    <t t-if="o.partner_shipping_id">
                                        <span t-field="o.partner_shipping_id"
                                              t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": true}'/>
                                    </t>
                                </address>
                            </div>
                            <div class="col-6 text-end">
                                <table class="table table-sm table-borderless" style="width:auto;float:right;">
                                    <tr>
                                        <td class="text-muted pe-3">Druckdatum:</td>
                                        <td><span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d.%m.%Y')"/></td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted pe-3">Auftragsreferenz:</td>
                                        <td><span t-field="o.name"/></td>
                                    </tr>
                                    <t t-if="o.commitment_date">
                                        <tr>
                                            <td class="text-muted pe-3">Lieferdatum:</td>
                                            <td><span t-field="o.commitment_date" t-options='{"widget": "date"}'/></td>
                                        </tr>
                                    </t>
                                </table>
                            </div>
                        </div>

                        <!-- ===== ABGESCHLOSSENE LIEFERUNGEN ===== -->
                        <t t-set="done_pickings" t-value="o.get_done_pickings()"/>
                        <t t-set="done_lines"    t-value="o.get_done_move_lines()"/>

                        <t t-if="done_pickings">
                            <div class="row mb-3">
                                <div class="col-12">
                                    <h5 style="border-bottom:2px solid #198754;color:#198754;padding-bottom:4px;">
                                        ✓ Abgeschlossene Lieferungen
                                    </h5>

                                    <!-- Übersichtstabelle Pickings (done) -->
                                    <table class="table table-sm">
                                        <thead class="table-success">
                                            <tr>
                                                <th>Lieferschein-Nr.</th>
                                                <th>Lieferdatum</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="done_pickings" t-as="picking">
                                                <tr>
                                                    <td><span t-field="picking.name"/></td>
                                                    <td><span t-field="picking.date_done" t-options='{"widget": "date"}'/></td>
                                                    <td><span class="badge bg-success">Erledigt</span></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>

                                    <!-- Produkttabelle (done) -->
                                    <table class="table table-sm mt-2">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Produkt</th>
                                                <th class="text-end">Bestellmenge</th>
                                                <th class="text-end">Geliefert</th>
                                                <th>Einheit</th>
                                                <th>Lot / Seriennummer</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="done_lines" t-as="line">
                                                <tr>
                                                    <td>
                                                        <span t-esc="line['product'].display_name"/>
                                                        <t t-if="line['product'].default_code">
                                                            <br/><small class="text-muted"><span t-esc="line['product'].default_code"/></small>
                                                        </t>
                                                    </td>
                                                    <td class="text-end"><span t-esc="'%.2f' % line['product_uom_qty']"/></td>
                                                    <td class="text-end"><strong><span t-esc="'%.2f' % line['qty_done']"/></strong></td>
                                                    <td><span t-esc="line['uom_name']"/></td>
                                                    <td>
                                                        <t t-if="line['lot_names']">
                                                            <span t-esc="', '.join(line['lot_names'])"/>
                                                        </t>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </t>

                        <!-- ===== OFFENE / GEPLANTE LIEFERUNGEN ===== -->
                        <t t-set="open_pickings" t-value="o.get_open_pickings()"/>
                        <t t-set="open_lines"    t-value="o.get_open_move_lines()"/>

                        <t t-if="open_pickings">
                            <div class="row mb-3 mt-3">
                                <div class="col-12">
                                    <h5 style="border-bottom:2px solid #0d6efd;color:#0d6efd;padding-bottom:4px;">
                                        ⏳ Offene / geplante Lieferungen
                                    </h5>

                                    <!-- Übersichtstabelle Pickings (open) -->
                                    <table class="table table-sm">
                                        <thead class="table-primary">
                                            <tr>
                                                <th>Lieferschein-Nr.</th>
                                                <th>Geplantes Datum</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="open_pickings" t-as="picking">
                                                <tr>
                                                    <td><span t-field="picking.name"/></td>
                                                    <td>
                                                        <t t-if="picking.scheduled_date">
                                                            <span t-field="picking.scheduled_date" t-options='{"widget": "date"}'/>
                                                        </t>
                                                        <t t-else="">—</t>
                                                    </td>
                                                    <td>
                                                        <t t-if="picking.state == 'assigned'">
                                                            <span class="badge bg-primary">Bereit</span>
                                                        </t>
                                                        <t t-elif="picking.state == 'partially_available'">
                                                            <span class="badge bg-warning text-dark">Teilweise verfügbar</span>
                                                        </t>
                                                        <t t-elif="picking.state == 'waiting'">
                                                            <span class="badge bg-secondary">Warte auf Lager</span>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="badge bg-secondary"><span t-field="picking.state"/></span>
                                                        </t>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>

                                    <!-- Produkttabelle (open) -->
                                    <table class="table table-sm mt-2">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Produkt</th>
                                                <th class="text-end">Geplante Menge</th>
                                                <th>Einheit</th>
                                                <th>In Lieferschein(en)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="open_lines" t-as="line">
                                                <tr>
                                                    <td>
                                                        <span t-esc="line['product'].display_name"/>
                                                        <t t-if="line['product'].default_code">
                                                            <br/><small class="text-muted"><span t-esc="line['product'].default_code"/></small>
                                                        </t>
                                                    </td>
                                                    <td class="text-end"><span t-esc="'%.2f' % line['product_uom_qty']"/></td>
                                                    <td><span t-esc="line['uom_name']"/></td>
                                                    <td><small class="text-muted"><span t-esc="', '.join(line['picking_names'])"/></small></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </t>

                        <!-- Kein Picking vorhanden -->
                        <t t-if="not done_pickings and not open_pickings">
                            <div class="alert alert-warning">
                                Für diesen Auftrag sind noch keine Lieferungen vorhanden.
                            </div>
                        </t>

                        <!-- HINWEIS AUS AUFTRAG -->
                        <t t-if="o.note">
                            <div class="row mt-4">
                                <div class="col-12">
                                    <strong>Hinweis:</strong>
                                    <p t-field="o.note"/>
                                </div>
                            </div>
                        </t>

                        <!-- UNTERSCHRIFTEN -->
                        <div class="row mt-5">
                            <div class="col-6">
                                <p>________________________</p>
                                <p>Warenempfänger (Unterschrift / Datum)</p>
                            </div>
                            <div class="col-6">
                                <p>________________________</p>
                                <p>Fischbacher GmbH (Unterschrift / Datum)</p>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
