                                                        <td style="font-size:13px">Due Date: </td>
                                                        <td style="font-size:13px;padding-left:3px;"><t t-esc="doc.invoice_date_due" t-options="{'widget': 'date' , 'format': 'dd.MM.yyyy'}"/></td>
                                                    </tr>
                                                </t>
                                            </t>
                                            <t t-if="doc.reversed_entry_id and doc.move_type == 'out_refund'">
