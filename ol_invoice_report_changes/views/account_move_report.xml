                                                    <tr>
                                                        <td style="width:55%;font-size:13px;">Invoice Reference: </td>
                                                        <td style="font-size:13px;padding-left:3px;"><t t-esc="doc.reversed_entry_id.name"/></td>
                                                    </tr>
                                                </t>
                                                <t t-if="doc.reversed_entry_id.invoice_date">
                                                    <tr>
                                                        <td style="font-size:13px">Dated: </td>
                                                        <td style="font-size:13px;padding-left:3px;"><t t-esc="doc.reversed_entry_id.invoice_date" t-options="{'widget': 'date' , 'format': 'dd.MM.yyyy'}"/></td>
                                                    </tr>
                                                </t>
                                                
                                            </t>
                                            
                                            <t t-if="doc.invoice_origin">
                                                <tr>
                                                    <td style="font-size:13px">Quote number: </td>
                                                    <td style="font-size:13px;padding-left:3px;"><t t-esc="doc.invoice_origin"/></td>
                                                </tr>
                                            </t>
                                            
                                            <t t-if="sale_orders and sale_orders.date_order">
                                                <tr>
                                                    <td style="font-size:13px">Order Date: </td>
                                                    <td style="font-size:13px;padding-left:3px;"><t t-esc="sale_orders.date_order" t-options="{'widget': 'date' , 'format': 'dd.MM.yyyy'}"/></td>
                                                </tr>
                                            </t>    
                                        
                                            <t t-if="doc.partner_id.ref">
                                                <tr>
                                                    <td style="font-size:13px">Client Number: </td>
                                                    <td style="font-size:13px;padding-left:3px;"><t t-esc="doc.partner_id.ref"/></td>
                                                </tr>
                                            </t>
                                            <t t-elif="not doc.partner_id.ref">
                                                <tr>
                                                    <td style="font-size:13px">Client Number: </td>
                                                    <td style="font-size:13px;padding-left:3px;"><t t-esc="doc.partner_id.id"/></td>
                                                </tr>
                                            </t>
                                            
                                            <t t-if="sale_orders.client_order_name">
                                                <tr>
                                                    <td style="font-size:13px">Ordered by: </td>
                                                    <td style="font-size:13px;padding-left:3px;"><t t-esc="sale_orders.client_order_name"/></td>
                                                </tr>
                                            </t>
                                            
                                            <t t-if="sale_orders.client_order_number">
                                                <tr>
                                                    <td style="font-size:13px">Your Order Number: </td>
                                                    <td style="font-size:13px;padding-left:3px;"><t t-esc="sale_orders.client_order_number"/></td>
                                                </tr>
                                            </t>
                                            
                                            <t t-if="sale_orders.carrier_id">
                                                <tr>
                                                    <td style="font-size:13px">Shipping Method: </td>
                                                    <td style="font-size:13px;padding-left:3px;"><t t-esc="sale_orders.carrier_id.name"/></td>
                                                </tr>
                                            </t>
                                            
                                            <t t-if="doc.invoice_incoterm_id">
                                                <tr>
                                                    <td style="font-size:13px">Delivery Terms: </td>
                                                    <td style="font-size:13px;padding-left:3px;"><t t-esc="doc.invoice_incoterm_id.with_context(lang='de_DE').name"/></td>
                                                </tr>
                                            </t>
                                            
                                            <t t-if="doc.invoice_user_id.name">
                                                <tr>
                                                    <td style="font-size:13px">Salesperson: </td>
                                                    <td style="font-size:13px;padding-left:3px;"><t t-esc="doc.user_id.name"/></td>
                                                </tr>
                                            </t>
                                            <t t-if="doc.invoice_user_id.phone">
                                                <tr>
                                                    <td style="font-size:13px">Phone: </td>
                                                    <td style="font-size:13px;padding-left:3px;"><t t-esc="doc.user_id.phone"/></td>
                                                </tr>
                                            </t>
                                            <t t-if="doc.invoice_user_id.login">
                                                <tr>
                                                    <td style="font-size:13px">Email: </td>
                                                    <td style="font-size:13px;padding-left:3px;"><t t-esc="doc.user_id.login"/></td>
                                                </tr>
                                            </t>
                                            <t t-if="sale_orders.client_order_ref">
                                                <tr>
                                                    <td style="font-size:13px;vertical-align:top;">Project: </td>
                                                    <td style="font-size:13px;padding-left:3px;white-space:normal;word-wrap: break-word; word-break: break-word; vertical-align:top;"><t t-esc="sale_orders.client_order_ref"/></td>
                                                </tr>
                                            </t>
                                            <t t-if="doc.partner_id.reverse_charge">
                                                <t t-if="doc.partner_id.vat">
                                                    <tr>
                                                        <td style="font-size:13px">Client-Vat: </td>
                                                        <td style="font-size:13px;padding-left:3px;"><t t-esc="doc.partner_id.vat"/></td>
                                                    </tr>
                                                </t>
                                            </t>
                                            <t t-if="doc.ref">
                                                <tr>
                                                    <td style="font-size:13px;vertical-align:top;">Reference: </td>
                                                    <td style="font-size:13px;padding-left:3px;white-space:normal;word-wrap: break-word; word-break: break-word; vertical-align:top;"><t t-esc="doc.ref"/></td>
                                                </tr>
                                            </t>
                                            <!--<t t-if="sale_orders and sale_orders.picking_policy">-->
                                            <!--    <tr>-->
                                            <!--        <td style="font-size:13px">Lieferbedingungen:</td>-->
                                            <!--        <td style="font-size:13px;padding-left:3px;"><t t-esc="sale_orders.with_context(lang='de_DE').picking_policy"/></td>-->
                                            <!--    </tr>-->
                                            <!--</t>    -->
                                            
                                            <!--<t t-if="doc.invoice_incoterm_id">-->
                                            <!--    <tr>-->
                                            <!--        <td style="font-size:13px">Versandart: </td>-->
                                            <!--        <td style="font-size:11px;padding-left:3px;"><t t-esc="doc.invoice_incoterm_id.with_context(lang='de_DE').name"/></td>-->
                                            <!--    </tr>-->
                                            <!--</t>-->
                                            <!--<t t-if="doc.user_id.name">-->
                                            <!--    <tr>-->
                                            <!--        <td style="font-size:13px">Vertriebsmitarbeiter: </td>-->
                                            <!--        <td style="font-size:13px;padding-left:3px;"><t t-esc="doc.user_id.name"/></td>-->
                                            <!--    </tr>-->
                                            <!--</t>-->
