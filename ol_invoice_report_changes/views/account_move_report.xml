<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="invoice_report_new">
        <t t-foreach="docs" t-as="doc"> 
           <!--<t t-set="o" t-value="o.with_context(lang=lang)" -->
            <t t-call="ol_invoice_report_changes.external_layout_for_invoice">

             <main>
                <div class="page"> 
            
                    <table style="width:100%; border-collapse:collapse; margin-top:10mm;">
                        <tr>
            
                            <td style="width:50%;vertical-align:top;height:45mm;max-height:45mm;overflow:hidden;font-size:13px;">
                                <div style="margin-top:5mm;">
                                    <div style="font-size:10.5px; margin-bottom:4px;border-bottom:1px solid #ccc;">
                                        <span t-field="doc.company_id.name"/> |
                                        <span t-field="doc.company_id.street"/> |
                                        <span t-field="doc.company_id.zip"/>
                                        <span t-field="doc.company_id.city"/>
                                    </div>
                
                                    <strong>
                                        <t t-esc="doc.partner_id.name"/>
                                    </strong><br/>
                                    <t t-esc="doc.partner_id.street"/><br/>
                                    <t t-if="doc.partner_id.street2">
                                        <t t-esc="doc.partner_id.street2"/><br/>
                                    </t>
                                    <t t-esc="doc.partner_id.zip"/>
                                    <t t-esc="doc.partner_id.city"/><br/>
                                    <t t-esc="doc.partner_id.country_id.name"/>
                                </div>
                            </td>
            
                            <td style="width:45%;vertical-align:top;padding-left:15mm;line-height:1.5;">
            
                                <table style="width:100%; border-collapse:collapse;">
                                    <t t-if="doc.name">
                                        <tr>
                                            <td style="width:55%;font-size:13px;">Rechnungsnummer:</td>
                                            <td style="font-size:13px"><t t-esc="doc.name"/></td>
                                        </tr>
                                    </t>
                                    <t t-if="doc.invoice_date">
                                        <tr>
                                            <td style="font-size:13px">Rechnungsdatum:</td>
                                            <td style="font-size:13px"><t t-esc="doc.invoice_date" t-options="{'widget': 'date' , 'format': 'dd.MM.yyyy'}"/></td>
                                        </tr>
                                    </t>
                                    <t t-if="doc.invoice_origin">
                                        <tr>
                                            <td style="font-size:13px">Auftragsnummer:</td>
                                            <td style="font-size:13px"><t t-esc="doc.invoice_origin"/></td>
                                        </tr>
                                    </t>
                                    <t t-if="doc.invoice_line_ids">
                                        <t t-if="doc.invoice_line_ids[0].sale_line_ids.order_id.date_order">
                                            <tr>
                                                <td style="font-size:13px">Auftragsdatum:</td>
                                                <td style="font-size:13px"><t t-esc="doc.invoice_line_ids[0].sale_line_ids.order_id.date_order" t-options="{'widget': 'date' , 'format': 'dd.MM.yyyy'}"/></td>
                                            </tr>
                                        </t>    
                                    </t>
                                    <t t-if="doc.partner_id.ref">
                                        <tr>
                                            <td style="font-size:13px">Kundennummer:</td>
                                            <td style="font-size:13px"><t t-esc="doc.partner_id.ref"/></td>
                                        </tr>
                                    </t>
                                    <t t-if="doc.invoice_line_ids">
                                        <t t-if="doc.invoice_line_ids[0].sale_line_ids.order_id.picking_policy">
                                            <tr>
                                                <td style="font-size:13px">Lieferbedingungen:</td>
                                                <td style="font-size:13px"><t t-esc="doc.invoice_line_ids[0].sale_line_ids.order_id.with_context(lang='de_DE').picking_policy"/></td>
                                            </tr>
                                        </t>    
                                    </t>
                                    <t t-if="doc.invoice_incoterm_id">
                                        <tr>
                                            <td style="font-size:13px">Versandart:</td>
                                            <td style="font-size:11px"><t t-esc="doc.invoice_incoterm_id.with_context(lang='de_DE').name"/></td>
                                        </tr>
                                    </t>
                                    <t t-if="doc.user_id.name">
                                        <tr>
                                            <td style="font-size:13px">Vertriebsmitarbeiter:</td>
                                            <td style="font-size:13px"><t t-esc="doc.user_id.name"/></td>
                                        </tr>
                                    </t>
                                    <t t-if="doc.ref">
                                        <tr>
                                            <td style="font-size:13px">Referenz:</td>
                                            <td style="font-size:13px"><t t-esc="doc.ref"/></td>
                                        </tr>
                                    </t>
                                    <t t-if="doc.invoice_line_ids">
                                        <t t-if="doc.invoice_line_ids[0].sale_line_ids.order_id.purchase_no">
                                            <tr>
                                                <td style="font-size:13px">Besteller:</td>
                                                <td style="font-size:13px"><t t-esc="doc.invoice_line_ids[0].sale_line_ids.order_id.purchase_no"/></td>
                                            </tr>
                                        </t>    
                                    </t>
                                    <t t-if="doc.invoice_line_ids">
                                        <t t-if="doc.invoice_line_ids[0].sale_line_ids.order_id.order_number">
                                            <tr>
                                                <td style="font-size:13px">Bestellnummer:</td>
                                                <td style="font-size:13px"><t t-esc="doc.invoice_line_ids[0].sale_line_ids.order_id.order_number"/></td>
                                            </tr>
                                        </t>    
                                    </t>
                                    
                                </table>
            
                            </td>
                        </tr>
                    </table>
                    <h2 style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">
                        Rechnung
                    </h2>
                    <table style="width:100%; border-collapse:collapse; font-size:12px;">
                        <thead>
                            <tr>
                                <th colspan="4" style="text-align:left; font-size:12px; font-weight:600; padding:6px 0;">
                                    Mietzeitraum:
                                    <t t-if="doc.invoice_line_ids">
                                        <t t-esc="doc.invoice_line_ids[0].sale_line_ids.order_id.plan_id.name"/>
                                        vom
                                        <t t-esc="doc.invoice_line_ids[0].sale_line_ids.order_id.date_order" t-options="{'widget': 'date' , 'format': 'dd.MM.yyyy'}"/>
                                        bis
                                        <t t-esc="doc.invoice_line_ids[0].sale_line_ids.order_id.next_invoice_date" t-options="{'widget': 'date' , 'format': 'dd.MM.yyyy'}"/>
                                            
                                        
                                    </t>
                                </th>
                    
                                <th colspan="4" style="text-align:right; font-size:12px; font-weight:600; padding:6px 0;">
                                    Rechnung <t t-esc="doc.name"/>
                                </th>
                            </tr>
                            <tr style="border-bottom:1px solid #ccc;margin-bottom:2px;">
                                <th style="width:5%; text-align:left;font-size:14px;">POS</th>
                                <th style="width:45%; text-align:left;font-size:14px;">Beschreibung</th>
                                <th style="width:15%; text-align:right;font-size:14px;">Menge</th>
                                <th style="width:12%; text-align:right;font-size:14px;">Einzelpreis</th>
                                <th style="width:10%; text-align:right;font-size:14px;">Steuern</th>
                                <th style="width:13%; text-align:right;font-size:14px;">Betrag</th>
                            </tr>
                        </thead>
                    
                        <tbody>
                            <t t-set="pos" t-value="0"/>
                            <t t-foreach="doc.invoice_line_ids" t-as="line">
                                <t t-set="pos" t-value="pos + 1"/>
                    
                                <tr style="border-bottom:1px solid #e0e0e0;margin-bottom:20px;">
                                    <td style="font-size:14px;">
                                        <t t-esc="pos"/>
                                    </td>
                    
                                    <td style="white-space:normal;font-size:14px; word-wrap: break-word; word-break: break-word;max-width:20px;">
                                        <t t-esc="line.name"/>
                                    </td>
                    
                                    <td style="text-align:right;font-size:14px;">
                                        <t t-esc="line.quantity"/>
                                        <t t-esc="line.product_uom_id.with_context(lang='de_DE').name"/>
                                    </td>
                    
                                    <td style="text-align:right;font-size:14px;">
                                        <t t-esc="line.price_unit"/>
                                    </td>
                    
                                    <td style="text-align:right;font-size:14px;">
                                        <t t-foreach="line.tax_ids" t-as="tax">
                                            <t t-if="tax">
                                                <t t-esc="tax.name"/>
                                                
                                            </t>
                                            
                                        </t>
                                    </td>
                    
                                    <td style="text-align:right;font-size:14px;">
                                        <t t-esc="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    
                    <table style="margin-top:8mm; font-size:11px; line-height:1.4; width:100%;">
                        <tr>
                    
                    
                            <td style="width:60%; vertical-align:top;">
                                <div style="white-space:normal;font-size:12px; word-wrap: break-word; word-break: break-word;max-width:100%;">
                                    <t t-if="doc.narration">
                                        <t t-esc="doc.narration"/>
                                    </t>
                                  
                                </div>
                    
                                <div style="font-size:14px;">
                                    Zahlungsbedingungen:
                                    Zahlbar
                                    <t t-if="doc.invoice_payment_term_id">
                                        <t t-esc="doc.invoice_payment_term_id.name"/>
                                    </t>
                                    
                                </div>
                            
                               <div style="font-size:14px;">
                                    <t t-if="doc.amount_total">
                                        <t t-esc="doc.amount_total" t-options="{'widget':'monetary','display_currency':doc.currency_id}" />
                                    </t>
                                     fällig bei Zahlung bis
                                    <t t-if="doc.invoice_date_due">
                                        <t t-esc="doc.invoice_date_due" t-options="{'widget': 'date' , 'format': 'dd.MM.yyyy'}"/>
                                    </t>
                                </div>
                            
                                <div style="font-size:14px;">
                                    Fälligkeitsdatum:
                                    <t t-esc="doc.invoice_date_due" t-options="{'widget': 'date' , 'format': 'dd.MM.yyyy'}"/>
                                    
                                </div>
                            </td>
                    
                    
                            <td style="width:40%; vertical-align:top; padding-left:10mm;">
                                <table style="width:100%; border-collapse:collapse; font-size:12px;">
                                    
                    
                                    <tr style="font-size:14px;">
                                        <td style="text-align:left;">Nettobetrag:</td>
                                        <td style="text-align:right;">
                                            <t t-esc="doc.amount_untaxed"
                                               t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                                        </td>
                                    </tr>
                    
                    
                                    <tr style="font-size:14px;">
                                        <td style="text-align:left;">Steuern:</td>
                                        <td style="text-align:right;">
                                            <t t-esc="doc.amount_tax"
                                               t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                                        </td>
                                    </tr>
                    
                    
                                    <tr style="font-weight:bold; font-size:14px;">
                                        <td style="text-align:left;">Bruttobetrag:</td>
                                        <td style="text-align:right;">
                                            <t t-esc="doc.amount_total"
                                               t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                                        </td>
                                    </tr>
                    
                                </table>
                            </td>
                    
                        </tr>
                    </table>


            
                </div>
            </main>

        
        
            </t>
        </t>
    </template>
</odoo>




