                                                    <td style="width:55%;font-size:13px;">Invoice number: </td>
                                                    <td style="font-size:13px;padding-left:3px;"><t t-esc="doc.name"/></td>
                                                </tr>
                                            </t>
                                            <t t-if="doc.invoice_date">
                                                <tr>
                                                    <td style="font-size:13px">Invoice date: </td>
                                                    <td style="font-size:13px;padding-left:3px;"><t t-esc="doc.invoice_date" t-options="{'widget': 'date' , 'format': 'dd.MM.yyyy'}"/></td>
                                                </tr>
                                            </t>
                                            <t t-if="doc.name">
