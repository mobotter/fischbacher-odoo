<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_with_payments_inherit" inherit_id="account.report_invoice_with_payments">
        <xpath expr="//t[@t-call='account.report_invoice']" position="replace">
            <t t-foreach="docs" t-as="doc">
                <t t-call="ol_invoice_report_changes.external_layout_for_invoice">
                    <main>
                        <div class="page">
                            <style>
                                .page table,
                                .page tr,
                                .page td,
                                .page th {
                                    border: 0 !important;
                                    border-width: 0 !important;
                                    border-style: none !important;
                                    border-color: transparent !important;
                                    border-collapse: collapse !important;
                                    box-shadow: none !important;
                                    outline: none !important;
                                }

                                .page table {
                                    border-spacing: 0 !important;
                                    background: transparent !important;
                                }

                                .page pre {
                                    border: 0 !important;
                                    border-style: none !important;
                                    background: transparent !important;
                                    margin: 0 !important;
                                    padding: 0 !important;
                                    white-space: pre-wrap;
                                }

                                .page .head-bottom th {
                                    border-bottom: 1px solid #ccc !important;
                                }

                                .page .line-bottom td {
                                    border-bottom: 1px solid #e0e0e0 !important;
                                }

                                .page .line-bottom th {
                                    border-bottom: 1px solid #e0e0e0 !important;
                                }
                            </style>

                            <t t-set="sale_orders" t-value="doc.env['sale.order']"/>
                            <t t-if="doc.invoice_origin">
                                <t t-set="sale_orders" t-value="doc.env['sale.order'].search([('name', '=', doc.invoice_origin)], limit=1)"/>
                            </t>

                            <table style="width:100%; border-collapse:collapse; margin-top:10mm; border:0 !important;">
                                <tr>
                                    <td style="width:50%;vertical-align:top;height:45mm;max-height:45mm;overflow:hidden;font-size:13px; border:0 !important;">
                                        <div style="margin-top:5mm;">
                                            <div style="font-size:10.5px; margin-bottom:4px;border-bottom:1px solid #ccc;">
                                                <span t-field="doc.company_id.name"/> |
                                                <span t-field="doc.company_id.street"/> |
                                                <span t-field="doc.company_id.zip"/>
                                                <span t-field="doc.company_id.city"/>
                                            </div>

                                            <strong>
                                                <t t-out="doc.partner_id.name"/>
                                            </strong><br/>
                                            <t t-out="doc.partner_id.street"/><br/>
                                            <t t-if="doc.partner_id.street2">
                                                <t t-out="doc.partner_id.street2"/><br/>
                                            </t>
                                            <t t-out="doc.partner_id.zip"/>
                                            <t t-out="doc.partner_id.city"/><br/>
                                            <t t-out="doc.partner_id.country_id.name"/>
                                        </div>
                                    </td>

                                    <td style="width:45%;vertical-align:top;padding-left:15mm;line-height:1.5; border:0 !important;">
                                        <table style="width:100%; border-collapse:collapse; border:0 !important;">
                                            <t t-if="doc.name">
                                                <tr>
                                                    <td style="width:55%;font-size:13px; border:0 !important;">Invoice number: </td>
                                                    <td style="font-size:13px;padding-left:3px; border:0 !important;"><t t-out="doc.name"/></td>
                                                </tr>
                                            </t>
                                            <t t-if="doc.invoice_date">
                                                <tr>
                                                    <td style="font-size:13px; border:0 !important;">Invoice date: </td>
                                                    <td style="font-size:13px;padding-left:3px; border:0 !important;"><t t-out="doc.invoice_date" t-options="{'widget': 'date' , 'format': 'dd.MM.yyyy'}"/></td>
                                                </tr>
                                            </t>
                                            <t t-if="doc.name and doc.invoice_date_due">
                                                <tr>
                                                    <td style="font-size:13px; border:0 !important;">Due Date: </td>
                                                    <td style="font-size:13px;padding-left:3px; border:0 !important;"><t t-out="doc.invoice_date_due" t-options="{'widget': 'date' , 'format': 'dd.MM.yyyy'}"/></td>
                                                </tr>
                                            </t>
                                            <t t-if="doc.reversed_entry_id and doc.move_type == 'out_refund'">
                                                <t t-if="doc.reversed_entry_id.name">
                                                    <tr>
                                                        <td style="width:55%;font-size:13px; border:0 !important;">Invoice Reference: </td>
                                                        <td style="font-size:13px;padding-left:3px; border:0 !important;"><t t-out="doc.reversed_entry_id.name"/></td>
                                                    </tr>
                                                </t>
                                                <t t-if="doc.reversed_entry_id.invoice_date">
                                                    <tr>
                                                        <td style="font-size:13px; border:0 !important;">Dated: </td>
                                                        <td style="font-size:13px;padding-left:3px; border:0 !important;"><t t-out="doc.reversed_entry_id.invoice_date" t-options="{'widget': 'date' , 'format': 'dd.MM.yyyy'}"/></td>
                                                    </tr>
                                                </t>
                                            </t>

                                            <t t-if="doc.invoice_origin">
                                                <tr>
                                                    <td style="font-size:13px; border:0 !important;">Quote number: </td>
                                                    <td style="font-size:13px;padding-left:3px; border:0 !important;"><t t-out="doc.invoice_origin"/></td>
                                                </tr>
                                            </t>

                                            <t t-if="sale_orders and sale_orders.date_order">
                                                <tr>
                                                    <td style="font-size:13px; border:0 !important;">Order Date: </td>
                                                    <td style="font-size:13px;padding-left:3px; border:0 !important;"><t t-out="sale_orders.date_order" t-options="{'widget': 'date' , 'format': 'dd.MM.yyyy'}"/></td>
                                                </tr>
                                            </t>

                                            <t t-if="doc.partner_id.ref">
                                                <tr>
                                                    <td style="font-size:13px; border:0 !important;">Client Number: </td>
                                                    <td style="font-size:13px;padding-left:3px; border:0 !important;"><t t-out="doc.partner_id.ref"/></td>
                                                </tr>
                                            </t>
                                            <t t-elif="not doc.partner_id.ref">
                                                <tr>
                                                    <td style="font-size:13px; border:0 !important;">Client Number: </td>
                                                    <td style="font-size:13px;padding-left:3px; border:0 !important;"><t t-out="doc.partner_id.id"/></td>
                                                </tr>
                                            </t>

                                            <t t-if="sale_orders and sale_orders.client_order_name">
                                                <tr>
                                                    <td style="font-size:13px; border:0 !important;">Ordered by: </td>
                                                    <td style="font-size:13px;padding-left:3px; border:0 !important;"><t t-out="sale_orders.client_order_name"/></td>
                                                </tr>
                                            </t>

                                            <t t-if="sale_orders and sale_orders.client_order_number">
                                                <tr>
                                                    <td style="font-size:13px; border:0 !important;">Your Order Number: </td>
                                                    <td style="font-size:13px;padding-left:3px; border:0 !important;"><t t-out="sale_orders.client_order_number"/></td>
                                                </tr>
                                            </t>

                                            <t t-if="sale_orders and sale_orders.carrier_id">
                                                <tr>
                                                    <td style="font-size:13px; border:0 !important;">Shipping Method: </td>
                                                    <td style="font-size:13px;padding-left:3px; border:0 !important;"><t t-out="sale_orders.carrier_id.name"/></td>
                                                </tr>
                                            </t>

                                            <t t-if="doc.invoice_incoterm_id">
                                                <tr>
                                                    <td style="font-size:13px; border:0 !important;">Delivery Terms: </td>
                                                    <td style="font-size:13px;padding-left:3px; border:0 !important;"><t t-out="doc.invoice_incoterm_id.with_context(lang='de_DE').name"/></td>
                                                </tr>
                                            </t>

                                            <t t-if="doc.invoice_user_id.name">
                                                <tr>
                                                    <td style="font-size:13px; border:0 !important;">Salesperson: </td>
                                                    <td style="font-size:13px;padding-left:3px; border:0 !important;"><t t-out="doc.invoice_user_id.name"/></td>
                                                </tr>
                                            </t>
                                            <t t-if="doc.invoice_user_id.phone">
                                                <tr>
                                                    <td style="font-size:13px; border:0 !important;">Phone: </td>
                                                    <td style="font-size:13px;padding-left:3px; border:0 !important;"><t t-out="doc.invoice_user_id.phone"/></td>
                                                </tr>
                                            </t>
                                            <t t-if="doc.invoice_user_id.login">
                                                <tr>
                                                    <td style="font-size:13px; border:0 !important;">Email: </td>
                                                    <td style="font-size:13px;padding-left:3px; border:0 !important;"><t t-out="doc.invoice_user_id.login"/></td>
                                                </tr>
                                            </t>
                                            <t t-if="sale_orders and sale_orders.client_order_ref">
                                                <tr>
                                                    <td style="font-size:13px;vertical-align:top; border:0 !important;">Project: </td>
                                                    <td style="font-size:13px;padding-left:3px;white-space:normal;word-wrap:break-word;word-break:break-word;vertical-align:top; border:0 !important;"><t t-out="sale_orders.client_order_ref"/></td>
                                                </tr>
                                            </t>
                                            <t t-if="doc.partner_id.reverse_charge and doc.partner_id.vat">
                                                <tr>
                                                    <td style="font-size:13px; border:0 !important;">Client-Vat: </td>
                                                    <td style="font-size:13px;padding-left:3px; border:0 !important;"><t t-out="doc.partner_id.vat"/></td>
                                                </tr>
                                            </t>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <h2 t-if="doc.move_type == 'out_invoice' and doc.state == 'posted' and sale_orders and sale_orders.is_subscription" style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">Rental Invoice</h2>
                            <h2 t-elif="doc.move_type == 'out_invoice' and doc.state == 'draft' and sale_orders and sale_orders.is_subscription" style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">Rental Draft Invoice</h2>
                            <h2 t-elif="doc.move_type == 'out_invoice' and doc.state == 'posted'" style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">Invoice</h2>
                            <h2 t-elif="doc.move_type == 'out_invoice' and doc.state == 'draft'" style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">Proforma Invoice</h2>
                            <h2 t-elif="doc.move_type == 'out_invoice' and doc.state == 'cancel'" style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">Cancelled Invoice</h2>
                            <h2 t-elif="doc.move_type == 'out_refund' and doc.state == 'posted'" style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">Corrected Invoice</h2>
                            <h2 t-elif="doc.move_type == 'out_refund' and doc.state == 'draft'" style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">Draft Corrected Invoice</h2>
                            <h2 t-elif="doc.move_type == 'out_refund' and doc.state == 'cancel'" style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">Cancelled Corrected Invoice</h2>
                            <h2 t-elif="doc.move_type == 'in_refund'" style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">Vendor Corrected Invoice</h2>
                            <h2 t-elif="doc.move_type == 'in_invoice'" style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">Vendor Bill</h2>

                            <t t-set="display_discount" t-value="any(l.discount for l in doc.invoice_line_ids)"/>

                            <table style="width:100%; border-collapse:collapse; font-size:12px; border:0 !important;">
                                <thead>
                                    <tr>
                                        <th colspan="3" style="text-align:left; font-size:12px; font-weight:600; padding:6px 0; border:0 !important;">
                                            <t t-if="sale_orders and sale_orders.is_subscription">
                                                Rental price / <t t-out="sale_orders.plan_id.name"/>
                                            </t>
                                        </th>

                                        <th colspan="3" style="text-align:right; font-size:12px; font-weight:600; padding:6px 0; border:0 !important;">
                                            <t t-if="doc.move_type == 'out_invoice' and doc.state == 'draft'">Order Number: <t t-out="doc.invoice_origin"/></t>
                                            <t t-else="">Invoice-Nr: <t t-out="doc.name"/></t>
                                        </th>
                                    </tr>
                                    <tr class="head-bottom">
                                        <th style="width:5%; text-align:left;font-size:14px;">POS</th>
                                        <th style="width:45%; text-align:left;font-size:14px;">Description</th>
                                        <th style="width:15%; text-align:right;font-size:14px;">Quantity</th>
                                        <th style="width:12%; text-align:right;font-size:14px;">Unit Price</th>
                                        <th style="width:10%; text-align:right;font-size:14px;" t-if="display_discount">Disc.%</th>
                                        <th style="width:13%; text-align:right;font-size:14px;">Amount</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <t t-set="pos" t-value="0"/>
                                    <t t-set="hide_prices_for_section" t-value="False"/>

                                    <t t-foreach="doc.invoice_line_ids" t-as="line">
                                        <t t-if="line.display_type == 'line_section'">
                                            <t t-set="hide_prices_for_section" t-value="'hide_price_section' in line._fields and line.hide_price_section or False"/>
                                            <tr class="line-bottom">
                                                <td colspan="99" style="background-color:#D3D3D3; font-weight:bold; white-space:normal; font-size:14px; word-wrap:break-word; word-break:break-word; padding-top:7px; padding-bottom:7px;">
                                                    <span t-field="line.name"/>
                                                </td>
                                            </tr>
                                        </t>

                                        <t t-elif="line.display_type == 'line_note'">
                                            <tr class="line-bottom">
                                                <td colspan="99" style="font-style:italic; white-space:normal; font-size:14px; word-wrap:break-word; word-break:break-word; padding-top:7px; padding-bottom:7px;">
                                                    <span t-field="line.name"/>
                                                </td>
                                            </tr>
                                        </t>

                                        <t t-elif="not line.display_type">
                                            <t t-set="pos" t-value="pos + 1"/>
                                            <tr class="line-bottom">
                                                <td style="font-size:14px;"><t t-out="pos"/></td>
                                                <td style="white-space:normal;font-size:14px; word-wrap:break-word; word-break:break-word;max-width:20px;padding-top:7px;padding-bottom:7px;">
                                                    <pre t-out="line.name"/>
                                                </td>
                                                <td style="text-align:right;font-size:14px;">
                                                    <t t-out="'{:.2f}'.format(line.quantity)"/>
                                                    <t t-out="line.product_uom_id.with_context(lang='de_DE').name"/>
                                                </td>

                                                <td t-if="not hide_prices_for_section" style="text-align:right;font-size:14px;">
                                                    <t t-out="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                                </td>
                                                <td t-if="display_discount and not hide_prices_for_section" style="text-align:right;font-size:14px;">
                                                    <t t-out="line.discount"/>%
                                                </td>
                                                <td t-if="not hide_prices_for_section" style="text-align:right;font-size:14px;">
                                                    <t t-if="doc.move_type == 'out_refund'">-</t>
                                                    <t t-out="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                </tbody>
                            </table>

                            <table style="margin-top:8mm; font-size:12px; line-height:1.2; width:100%; page-break-inside:avoid; border:0 !important;">
                                <tr>
                                    <td style="width:60%; vertical-align:top; border:0 !important;">
                                        <div style="white-space:normal;font-size:12px; word-wrap:break-word; word-break:break-word;max-width:100%;">
                                            <div>Agreements exist that may result in subsequent reductions of the final price.</div>
                                        </div>

                                        <div style="white-space:normal;font-size:12px; word-wrap:break-word; word-break:break-word;max-width:100%;">
                                            <t t-if="doc.narration">
                                                <t t-out="doc.narration"/>
                                            </t>
                                        </div>

                                        <t t-if="doc.move_type != 'out_refund'">
                                            <div style="font-size:12px;">
                                                Payment Terms:
                                                <t t-if="doc.invoice_payment_term_id">
                                                    <t t-out="doc.invoice_payment_term_id.name"/>
                                                </t>
                                                <t t-else="">
                                                    Payable immediately, or at the latest within 10 days net.
                                                </t>
                                            </div>
                                            <t t-if="doc.invoice_payment_term_id.early_discount and doc.state == 'posted'">
                                                <div style="font-size:12px;">
                                                    <t t-out="doc.discount_amount" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                                                    with
                                                    <t t-out="doc.invoice_payment_term_id.discount_percentage"/>%
                                                    discount unit
                                                    <t t-out="doc.extended_date" t-options="{'widget': 'date' , 'format': 'dd.MM.yyyy'}"/>.
                                                    After that
                                                    <t t-out="doc.amount_total" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                                                    without deduction.
                                                </div>
                                            </t>
                                            <t t-if="doc.invoice_payment_term_id">
                                                <div style="font-size:12px;">
                                                    <t t-out="doc.invoice_payment_term_id.note"/>
                                                </div>
                                            </t>
                                        </t>
                                    </td>

                                    <td style="width:40%; vertical-align:top; padding-left:10mm; border:0 !important;">
                                        <table style="width:100%; border-collapse:collapse; font-size:12px; border:0 !important;">
                                            <tr style="font-size:14px;">
                                                <t t-if="not doc.partner_id.reverse_charge">
                                                    <td style="text-align:left;">Untaxed Amount:</td>
                                                </t>
                                                <t t-else="">
                                                    <td style="text-align:left;">Total Amount:</td>
                                                </t>
                                                <td style="text-align:right;">
                                                    <t t-if="doc.move_type == 'out_refund'">-</t>
                                                    <t t-out="doc.amount_untaxed" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                                                </td>
                                            </tr>

                                            <t t-if="not doc.partner_id.reverse_charge">
                                                <tr style="font-size:14px;">
                                                    <td style="text-align:left;">VAT 19%:</td>
                                                    <td style="text-align:right;">
                                                        <t t-if="doc.move_type == 'out_refund'">-</t>
                                                        <t t-out="doc.amount_tax" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                                                    </td>
                                                </tr>
                                            </t>

                                            <t t-if="not doc.partner_id.reverse_charge">
                                                <tr style="font-weight:bold; font-size:14px;">
                                                    <td style="text-align:left;">Total:</td>
                                                    <td style="text-align:right;">
                                                        <t t-if="doc.move_type == 'out_refund'">-</t>
                                                        <t t-out="doc.amount_total" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <br/>
                            <div style="font-size:14px;font-weight:bold;text-align:left;">
                                <t t-if="doc.partner_id.reverse_charge">
                                    *** Value added tax is owed by the recipient of the service (reverse charge) ***
                                </t>
                            </div>
                        </div>
                    </main>
                </t>
            </t>
        </xpath>
    </template>
</odoo>
