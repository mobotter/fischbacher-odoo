<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_with_payments_inherit" inherit_id="account.report_invoice_with_payments">
        <xpath expr="//t[@t-call='account.report_invoice']" position="replace">
            <t t-foreach="docs" t-as="doc">
                <t t-call="ol_invoice_report_changes.external_layout_for_invoice">

                    <style>
                        .page table,
                        .page tr,
                        .page td,
                        .page th {
                            border: 0 !important;
                            border-width: 0 !important;
                            border-style: none !important;
                            border-color: transparent !important;
                            border-collapse: collapse !important;
                            box-shadow: none !important;
                            outline: none !important;
                            background-image: none !important;
                        }

                        .page table {
                            border-spacing: 0 !important;
                            background: transparent !important;
                        }

                        .page pre {
                            border: 0 !important;
                            border-style: none !important;
                            background: transparent !important;
                            margin: 0 !important;
                            padding: 0 !important;
                            white-space: pre-wrap !important;
                        }

                        .page .head-bottom th {
                            border-bottom: 1px solid #ccc !important;
                        }

                        .page .line-bottom td,
                        .page .line-bottom th {
                            border-bottom: 1px solid #e0e0e0 !important;
                        }

                        .page table.table,
                        .page .table,
                        .page .table td,
                        .page .table th,
                        .page .table tr {
                            border: 0 !important;
                            border-top: 0 !important;
                            border-right: 0 !important;
                            border-left: 0 !important;
                            box-shadow: none !important;
                            outline: none !important;
                        }
                    </style>

                    <t t-set="sale_order" t-value="doc.env['sale.order']"/>
                    <t t-if="doc.invoice_origin">
                        <t t-set="sale_order" t-value="doc.env['sale.order'].search([('name', '=', doc.invoice_origin)], limit=1)"/>
                    </t>

                    <t t-set="is_rental_invoice"
                       t-value="bool(sale_order and (
                           ('is_subscription' in sale_order._fields and sale_order.is_subscription) or
                           ('plan_id' in sale_order._fields and sale_order.plan_id) or
                           ('has_plan' in sale_order._fields and sale_order.has_plan)
                       ))"/>

                    <t t-set="invoice_partner" t-value="doc.partner_id if doc.partner_id else False"/>
                    <t t-set="lines_to_report" t-value="doc.invoice_line_ids"/>

                    <table style="width:100%; border-collapse:collapse; margin-top:10mm;">
                        <tr>
                            <td style="width:50%; vertical-align:top; font-size:13px;">
                                <div style="margin-top:5mm;">
                                    <div style="font-size:10.5px; margin-bottom:4px; border-bottom:1px solid #ccc;">
                                        <span t-field="doc.company_id.name"/> |
                                        <span t-field="doc.company_id.street"/> |
                                        <span t-field="doc.company_id.zip"/>
                                        <span t-field="doc.company_id.city"/>
                                    </div>

                                    <t t-if="invoice_partner">
                                        <strong><t t-esc="invoice_partner.name"/></strong><br/>
                                        <t t-if="invoice_partner.street">
                                            <t t-esc="invoice_partner.street"/><br/>
                                        </t>
                                        <t t-if="invoice_partner.street2">
                                            <t t-esc="invoice_partner.street2"/><br/>
                                        </t>
                                        <t t-if="invoice_partner.zip or invoice_partner.city">
                                            <t t-esc="invoice_partner.zip"/>
                                            <t t-if="invoice_partner.zip and invoice_partner.city"> </t>
                                            <t t-esc="invoice_partner.city"/><br/>
                                        </t>
                                        <t t-if="invoice_partner.country_id">
                                            <t t-esc="invoice_partner.country_id.name"/>
                                        </t>
                                    </t>
                                </div>
                            </td>

                            <td style="width:45%; vertical-align:top; padding-left:15mm; line-height:1.5;">
                                <table style="width:100%; border-collapse:collapse;">
                                    <t t-if="doc.name">
                                        <tr>
                                            <td style="width:55%; font-size:13px;">Invoice number:</td>
                                            <td style="font-size:13px; padding-left:3px;"><t t-esc="doc.name"/></td>
                                        </tr>
                                    </t>

                                    <t t-if="doc.lease_agreement_no">
                                        <tr>
                                            <td style="font-size:13px;">Lease Agreement No.:</td>
                                            <td style="font-size:13px; padding-left:3px;"><t t-esc="doc.lease_agreement_no"/></td>
                                        </tr>
                                    </t>
                                    <t t-if="doc.invoice_date">
                                        <tr>
                                            <td style="font-size:13px;">Invoice date:</td>
                                            <td style="font-size:13px; padding-left:3px;">
                                                <t t-esc="doc.invoice_date" t-options="{'widget': 'date', 'format': 'dd.MM.yyyy'}"/>
                                            </td>
                                        </tr>
                                    </t>

                                    <t t-if="doc.name and doc.invoice_date_due">
                                        <tr>
                                            <td style="font-size:13px;">Due Date:</td>
                                            <td style="font-size:13px; padding-left:3px;">
                                                <t t-esc="doc.invoice_date_due" t-options="{'widget': 'date', 'format': 'dd.MM.yyyy'}"/>
                                            </td>
                                        </tr>
                                    </t>

                                    <t t-if="doc.reversed_entry_id and doc.move_type == 'out_refund'">
                                        <t t-if="doc.reversed_entry_id.name">
                                            <tr>
                                                <td style="width:55%; font-size:13px;">Invoice Reference:</td>
                                                <td style="font-size:13px; padding-left:3px;"><t t-esc="doc.reversed_entry_id.name"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.reversed_entry_id.invoice_date">
                                            <tr>
                                                <td style="font-size:13px;">Dated:</td>
                                                <td style="font-size:13px; padding-left:3px;">
                                                    <t t-esc="doc.reversed_entry_id.invoice_date" t-options="{'widget': 'date', 'format': 'dd.MM.yyyy'}"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>

                                    <t t-if="doc.invoice_origin">
                                        <tr>
                                            <td style="font-size:13px;">Quote number:</td>
                                            <td style="font-size:13px; padding-left:3px;"><t t-esc="doc.invoice_origin"/></td>
                                        </tr>
                                    </t>

                                    <t t-if="sale_order and sale_order.date_order">
                                        <tr>
                                            <td style="font-size:13px;">Order Date:</td>
                                            <td style="font-size:13px; padding-left:3px;">
                                                <t t-esc="sale_order.date_order" t-options="{'widget': 'date', 'format': 'dd.MM.yyyy'}"/>
                                            </td>
                                        </tr>
                                    </t>

                                    <t t-if="invoice_partner and invoice_partner.ref">
                                        <tr>
                                            <td style="font-size:13px;">Client Number:</td>
                                            <td style="font-size:13px; padding-left:3px;"><t t-esc="invoice_partner.ref"/></td>
                                        </tr>
                                    </t>
                                    <t t-elif="invoice_partner">
                                        <tr>
                                            <td style="font-size:13px;">Client Number:</td>
                                            <td style="font-size:13px; padding-left:3px;"><t t-esc="invoice_partner.id"/></td>
                                        </tr>
                                    </t>

                                    <t t-if="sale_order and sale_order.client_order_name">
                                        <tr>
                                            <td style="font-size:13px;">Ordered by:</td>
                                            <td style="font-size:13px; padding-left:3px;"><t t-esc="sale_order.client_order_name"/></td>
                                        </tr>
                                    </t>

                                    <t t-if="sale_order and sale_order.client_order_number">
                                        <tr>
                                            <td style="font-size:13px;">Your Order Number:</td>
                                            <td style="font-size:13px; padding-left:3px;"><t t-esc="sale_order.client_order_number"/></td>
                                        </tr>
                                    </t>

                                    <t t-if="sale_order and sale_order.carrier_id">
                                        <tr>
                                            <td style="font-size:13px;">Shipping Method:</td>
                                            <td style="font-size:13px; padding-left:3px;"><t t-esc="sale_order.carrier_id.name"/></td>
                                        </tr>
                                    </t>

                                    <t t-if="doc.invoice_incoterm_id">
                                        <tr>
                                            <td style="font-size:13px;">Delivery Terms:</td>
                                            <td style="font-size:13px; padding-left:3px;">
                                                <t t-esc="doc.invoice_incoterm_id.with_context(lang='de_DE').name"/>
                                            </td>
                                        </tr>
                                    </t>

                                    <t t-if="doc.invoice_user_id.name">
                                        <tr>
                                            <td style="font-size:13px;">Salesperson:</td>
                                            <td style="font-size:13px; padding-left:3px;"><t t-esc="doc.invoice_user_id.name"/></td>
                                        </tr>
                                    </t>
                                    <t t-if="doc.invoice_user_id.phone">
                                        <tr>
                                            <td style="font-size:13px;">Phone:</td>
                                            <td style="font-size:13px; padding-left:3px;"><t t-esc="doc.invoice_user_id.phone"/></td>
                                        </tr>
                                    </t>
                                    <t t-if="doc.invoice_user_id.login">
                                        <tr>
                                            <td style="font-size:13px;">Email:</td>
                                            <td style="font-size:13px; padding-left:3px;"><t t-esc="doc.invoice_user_id.login"/></td>
                                        </tr>
                                    </t>

                                    <t t-if="sale_order and sale_order.client_order_ref">
                                        <tr>
                                            <td style="font-size:13px; vertical-align:top;">Project:</td>
                                            <td style="font-size:13px; padding-left:3px; white-space:normal; word-wrap:break-word; word-break:break-word; vertical-align:top;">
                                                <t t-esc="sale_order.client_order_ref"/>
                                            </td>
                                        </tr>
                                    </t>

                                    <t t-if="invoice_partner and 'reverse_charge' in invoice_partner._fields and invoice_partner.reverse_charge and invoice_partner.vat">
                                        <tr>
                                            <td style="font-size:13px;">Client-Vat:</td>
                                            <td style="font-size:13px; padding-left:3px;"><t t-esc="invoice_partner.vat"/></td>
                                        </tr>
                                    </t>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <h2 t-if="doc.move_type == 'out_invoice' and doc.state == 'posted' and is_rental_invoice"
                        style="color:#1f6fd2; font-weight:500; margin:10mm 0 2mm 0;">Rental Invoice</h2>
                    <h2 t-elif="doc.move_type == 'out_invoice' and doc.state == 'draft' and is_rental_invoice"
                        style="color:#1f6fd2; font-weight:500; margin:10mm 0 2mm 0;">Rental Draft Invoice</h2>
                    <h2 t-elif="doc.move_type == 'out_invoice' and doc.state == 'posted'"
                        style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">Invoice</h2>
                    <h2 t-elif="doc.move_type == 'out_invoice' and doc.state == 'draft'"
                        style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">Proforma Invoice</h2>
                    <h2 t-elif="doc.move_type == 'out_invoice' and doc.state == 'cancel'"
                        style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">Cancelled Invoice</h2>
                    <h2 t-elif="doc.move_type == 'out_refund' and doc.state == 'posted'"
                        style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">Corrected Invoice</h2>
                    <h2 t-elif="doc.move_type == 'out_refund' and doc.state == 'draft'"
                        style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">Draft Corrected Invoice</h2>
                    <h2 t-elif="doc.move_type == 'out_refund' and doc.state == 'cancel'"
                        style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">Cancelled Corrected Invoice</h2>
                    <h2 t-elif="doc.move_type == 'in_refund'"
                        style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">Vendor Corrected Invoice</h2>
                    <h2 t-elif="doc.move_type == 'in_invoice'"
                        style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">Vendor Bill</h2>

                    <t t-if="is_rental_invoice and sale_order">
                        <div style="font-size:12px; margin-bottom:2px;">
                            <t t-if="'plan_id' in sale_order._fields and sale_order.plan_id">
                                Rental price / <t t-esc="sale_order.plan_id.name"/>
                            </t>
                        </div>

                        <div style="font-size:12px; margin-bottom:5mm;"
                             t-if="doc.rental_billing_period_start and doc.rental_billing_period_end">
                            Billing period from
                            <t t-esc="doc.rental_billing_period_start.strftime('%d.%m.%Y')"/>
                            to
                            <t t-esc="doc.rental_billing_period_end.strftime('%d.%m.%Y')"/>
                        </div>
                    </t>

                    <t t-set="display_discount" t-value="any(l.discount for l in lines_to_report)"/>

                    <table style="width:100%; border-collapse:collapse; font-size:12px;">
                        <thead>
                            <tr>
                                <th colspan="3" style="text-align:left; font-size:12px; font-weight:600; padding:6px 0;"></th>
                                <th colspan="3" style="text-align:right; font-size:12px; font-weight:600; padding:6px 0;">
                                    <t t-if="doc.move_type == 'out_invoice' and doc.state == 'draft' and doc.invoice_origin">
                                        Order Number: <t t-esc="doc.invoice_origin"/>
                                    </t>
                                    <t t-else="">
                                        Invoice-Nr: <t t-esc="doc.name"/>
                                    </t>
                                </th>
                            </tr>
                            <tr class="head-bottom">
                                <th style="width:5%; text-align:left; font-size:14px;">POS</th>
                                <th style="width:45%; text-align:left; font-size:14px;">Description</th>
                                <th style="width:15%; text-align:right; font-size:14px;">Quantity</th>
                                <th style="width:12%; text-align:right; font-size:14px;">Unit Price</th>
                                <th style="width:10%; text-align:right; font-size:14px;" t-if="display_discount">Disc.%</th>
                                <th style="width:13%; text-align:right; font-size:14px;">Amount</th>
                            </tr>
                        </thead>

                        <tbody>
                            <t t-set="pos" t-value="0"/>
                            <t t-set="hide_prices_for_section" t-value="False"/>

                            <t t-foreach="lines_to_report" t-as="line">
                                <t t-if="line.display_type == 'line_section'">
                                    <t t-set="hide_prices_for_section" t-value="'hide_price_section' in line._fields and line.hide_price_section or False"/>
                                    <tr class="line-bottom">
                                        <td colspan="99" style="background-color:#D3D3D3; font-weight:bold; white-space:normal; font-size:14px; word-wrap:break-word; word-break:break-word; padding-top:7px; padding-bottom:7px;">
                                            <span t-field="line.name"/>
                                        </td>
                                    </tr>
                                </t>

                                <t t-elif="line.display_type == 'line_note'">
                                    <tr class="line-bottom">
                                        <td colspan="99" style="font-style:italic; white-space:normal; font-size:14px; word-wrap:break-word; word-break:break-word; padding-top:7px; padding-bottom:7px;">
                                            <span t-field="line.name"/>
                                        </td>
                                    </tr>
                                </t>

                                <t t-elif="line.display_type == 'product' or not line.display_type">
                                    <t t-set="pos" t-value="pos + 1"/>
                                    <tr class="line-bottom">
                                        <td style="font-size:14px;">
                                            <t t-esc="pos"/>
                                        </td>

                                        <td style="white-space:normal; font-size:14px; word-wrap:break-word; word-break:break-word; padding:7px 0; text-align:left; vertical-align:top;">
                                            <t t-set="raw_lines" t-value="[l.strip() for l in (line.name or '').split('\n') if l.strip()]"/>
                                            <t t-set="first_line" t-value="raw_lines[0] if raw_lines else ''"/>
                                            <t t-set="desc_lines" t-value="raw_lines[1:] if len(raw_lines) &gt; 1 else []"/>
                                            <t t-set="last_line" t-value="desc_lines[-1] if desc_lines else ''"/>
                                            <t t-set="desc_lines"
                                               t-value="desc_lines[:-1] if last_line and ('Woche' in last_line or 'Monat' in last_line or ('von' in last_line and 'bis' in last_line)) else desc_lines"/>
                                        
                                            <span style="display:block; margin:0; padding:0; text-align:left;">
                                                <t t-esc="first_line"/>
                                            </span>
                                        
                                            <t t-if="desc_lines">
                                                <span style="display:block; margin:0; padding:0; text-align:left; color:#444; font-size:13px; line-height:1.25;">
                                                    <t t-esc="' '.join(desc_lines)"/>
                                                </span>
                                            </t>
                                        </td>

                                        <td style="text-align:right; font-size:14px;">
                                            <t t-esc="'{:.2f}'.format(line.quantity)"/>
                                            <t t-if="line.product_uom_id">
                                                <t t-esc="line.product_uom_id.with_context(lang='de_DE').name"/>
                                            </t>
                                        </td>

                                        <td t-if="not hide_prices_for_section" style="text-align:right; font-size:14px;">
                                            <t t-esc="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                        </td>

                                        <td t-if="display_discount and not hide_prices_for_section" style="text-align:right; font-size:14px;">
                                            <t t-esc="line.discount"/>%
                                        </td>

                                        <td t-if="not hide_prices_for_section" style="text-align:right; font-size:14px;">
                                            <t t-if="doc.move_type == 'out_refund'">-</t>
                                            <t t-esc="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>

                    <table style="margin-top:8mm; font-size:12px; line-height:1.2; width:100%; page-break-inside:avoid;">
                        <tr>
                            <td style="width:60%; vertical-align:top;">
                                <div style="white-space:normal; font-size:12px; word-wrap:break-word; word-break:break-word; max-width:100%;">
                                    <div>Agreements exist that may result in subsequent reductions of the final price.</div>
                                </div>

                                <div style="white-space:normal; font-size:12px; word-wrap:break-word; word-break:break-word; max-width:100%;">
                                    <t t-if="doc.narration">
                                        <t t-esc="doc.narration"/>
                                    </t>
                                </div>

                                <t t-if="doc.move_type != 'out_refund'">
                                    <div style="font-size:12px;">
                                        Payment Terms:
                                        <t t-if="doc.invoice_payment_term_id">
                                            <t t-esc="doc.invoice_payment_term_id.name"/>
                                        </t>
                                        <t t-else="">
                                            Payable immediately, or at the latest within 10 days net.
                                        </t>
                                    </div>

                                    <t t-if="doc.invoice_payment_term_id and doc.invoice_payment_term_id.early_discount and doc.state == 'posted'">
                                        <div style="font-size:12px;">
                                            <t t-esc="doc.discount_amount" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                                            with
                                            <t t-esc="doc.invoice_payment_term_id.discount_percentage"/>%
                                            discount unit
                                            <t t-esc="doc.extended_date" t-options="{'widget': 'date', 'format': 'dd.MM.yyyy'}"/>.
                                            After that
                                            <t t-esc="doc.amount_total" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                                            without deduction.
                                        </div>
                                    </t>

                                    <t t-if="doc.invoice_payment_term_id and doc.invoice_payment_term_id.display_on_invoice and doc.invoice_payment_term_id.note">
                                        <div style="margin-top:2px;">
                                            <span t-field="doc.invoice_payment_term_id.note"/>
                                        </div>
                                    </t>
                                </t>
                            </td>

                            <td style="width:40%; vertical-align:top; padding-left:10mm;">
                                <table style="width:100%; border-collapse:collapse; font-size:12px;">
                                    <tr style="font-size:14px;">
                                        <t t-if="not (invoice_partner and 'reverse_charge' in invoice_partner._fields and invoice_partner.reverse_charge)">
                                            <td style="text-align:left;">Untaxed Amount:</td>
                                        </t>
                                        <t t-else="">
                                            <td style="text-align:left;">Total Amount:</td>
                                        </t>
                                        <td style="text-align:right;">
                                            <t t-if="doc.move_type == 'out_refund'">-</t>
                                            <t t-esc="doc.amount_untaxed" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                                        </td>
                                    </tr>

                                    <t t-if="not (invoice_partner and 'reverse_charge' in invoice_partner._fields and invoice_partner.reverse_charge)">
                                        <tr style="font-size:14px;">
                                            <td style="text-align:left;">VAT 19%:</td>
                                            <td style="text-align:right;">
                                                <t t-if="doc.move_type == 'out_refund'">-</t>
                                                <t t-esc="doc.amount_tax" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                                            </td>
                                        </tr>

                                        <tr style="font-weight:bold; font-size:14px;">
                                            <td style="text-align:left;">Total:</td>
                                            <td style="text-align:right;">
                                                <t t-if="doc.move_type == 'out_refund'">-</t>
                                                <t t-esc="doc.amount_total" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                                            </td>
                                        </tr>
                                    </t>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <br/>
                    <div style="font-size:14px; font-weight:bold; text-align:left;">
                        <t t-if="invoice_partner and 'reverse_charge' in invoice_partner._fields and invoice_partner.reverse_charge">
                            *** Value added tax is owed by the recipient of the service (reverse charge) ***
                        </t>
                    </div>

                </t>
            </t>
        </xpath>
    </template>
</odoo>
