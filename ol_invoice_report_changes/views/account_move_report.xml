                                            <!--    <tr>-->
                                            <!--        <td style="font-size:13px;vertical-align:top;">Referenz: </td>-->
                                            <!--        <td style="font-size:13px;padding-left:3px;white-space:normal;word-wrap: break-word; word-break: break-word; vertical-align:top;"><t t-esc="doc.ref"/></td>-->
                                            <!--    </tr>-->
                                            <!--</t>-->
                                            
                                            <!--<t t-if="sale_orders and sale_orders.purchase_no">-->
                                            <!--    <tr>-->
                                            <!--        <td style="font-size:13px">Besteller: </td>-->
                                            <!--        <td style="font-size:13px;padding-left:3px;"><t t-esc="sale_orders.purchase_no"/></td>-->
                                            <!--    </tr>-->
                                            <!--</t>    -->
                                            
                                            <!--<t t-if="sale_orders and sale_orders.order_number">-->
                                            
                                            <!--    <tr>-->
                                            <!--        <td style="font-size:13px">Bestellnummer: </td>-->
                                            <!--        <td style="font-size:13px;padding-left:3px;"><t t-esc="sale_orders.order_number"/></td>-->
                                            <!--    </tr>-->
                                            
                                            <!--</t>-->
                                            <!--<t t-if="doc.partner_id.country_id.name != 'Deutschland' and doc.partner_id.country_id.name != 'Germany' and doc.partner_id.name != 'Barverkauf' ">-->
                                            
                                            <!--    <tr>-->
                                            <!--        <td style="font-size:13px">USt-IdNr.: </td>-->
                                            <!--        <td style="font-size:13px;padding-left:3px;"><t t-esc="doc.partner_id.vat"/></td>-->
                                            <!--    </tr>-->
                                            
                                            <!--</t>-->
                                            
                                        </table>
                                    </td>
                                </tr>
                            </table>
                            <h2 t-if="doc.move_type == 'out_invoice' and doc.state == 'posted' and sale_orders.is_subscription" style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">Rental Invoice</h2>
                            <h2 t-elif="doc.move_type == 'out_invoice' and doc.state == 'draft' and sale_orders.is_subscription" style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">Rental Draft Invoice</h2>
                            <h2 t-elif="doc.move_type == 'out_invoice' and doc.state == 'posted'" style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">Invoice</h2>
                            <h2 t-elif="doc.move_type == 'out_invoice' and doc.state == 'draft'" style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">Proforma Invoice</h2>
                            <h2 t-elif="doc.move_type == 'out_invoice' and doc.state == 'cancel'" style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">Cancelled Invoice</h2>
                            <h2 t-elif="doc.move_type == 'out_refund' and doc.state == 'posted'" style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">Corrected Invoice</h2>
                            <h2 t-elif="doc.move_type == 'out_refund' and doc.state == 'draft'" style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">Draft Corrected Invoice</h2>
                            <h2 t-elif="doc.move_type == 'out_refund' and doc.state == 'cancel'" style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">Cancelled Corrected Invoice</h2>
                            <h2 t-elif="doc.move_type == 'in_refund'" style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">Vendor Corrected Invoice</h2>
                            <h2 t-elif="doc.move_type == 'in_invoice'" style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">Vendor Bill</h2>
                            <!--<h2 t-if="sale_orders.is_subscription" style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">-->
                            <!--    Rental Invoice-->
                            <!--</h2>-->
                            <!--<h2 t-elif="doc.state != 'posted'" style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">-->
                            <!--    Pro-Forma_Invoice-->
                            <!--</h2>-->
                            <!--<h2 t-else=" " style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">-->
                            <!--    Invoice-->
                            <!--</h2>-->
                            
                            <!--<t t-set="lines_to_report" t-value="doc.invoice_line_ids._get_order_lines_to_report()"/>-->
                            <t t-set="display_discount" t-value="any(l.discount for l in doc.invoice_line_ids)"/>
                            <table style="width:100%; border-collapse:collapse; font-size:12px;">
                                <thead>
                                    <tr>
                                        <th colspan="3" style="text-align:left; font-size:12px; font-weight:600; padding:6px 0;">
                                            <t t-if="doc.is_rent  and doc.partner_id.name != 'Barverkauf'">
                                                Mietzeitraum:
                                                <t t-if="sale_orders">
                                                    <t t-esc="sale_orders.plan_id.name"/>
                                                    vom
                                                    <t t-esc="sale_orders.start_date" t-options="{'widget': 'date' , 'format': 'dd.MM.yyyy'}"/>
                                                    bis
                                                    <t t-esc="sale_orders.next_invoice_date" t-options="{'widget': 'date' , 'format': 'dd.MM.yyyy'}"/>

                                                </t>
                                            </t>
                                             <t t-elif="sale_orders.is_subscription">
                                                Rental price /
                                                    <t t-esc="sale_orders.plan_id.name"/>
                                                    <br/>
                                                    Rental period
                                                    from
                                                    <t t-esc="sale_orders.start_date" t-options="{'widget': 'date' , 'format': 'dd.MM.yyyy'}"/>
                                                    to
                                                    <t t-esc="sale_orders.next_invoice_date" t-options="{'widget': 'date' , 'format': 'dd.MM.yyyy'}"/>
    
                                            </t>
                                           
                                        </th>
                                       
                                        <th colspan="3" style="text-align:right; font-size:12px; font-weight:600; padding:6px 0;">
                                            
                                            <t t-if="doc.move_type == 'out_invoice' and doc.state == 'draft'">Order Number: <t t-esc="doc.invoice_origin"/></t>
                                            <t t-else="">Invoice-Nr:<t t-esc="doc.name"/></t> 
                                        </th>
                                    </tr>
                                    <tr style="border-bottom:1px solid #ccc;margin-bottom:2px;">
                                        <th style="width:5%; text-align:left;font-size:14px;">POS</th>
                                        <th style="width:45%; text-align:left;font-size:14px;">Description</th>
                                        <th style="width:15%; text-align:right;font-size:14px;">Quantity</th>
                                        <th style="width:12%; text-align:right;font-size:14px;">Unit Price</th>
                                        <th style="width:10%; text-align:right;font-size:14px;" t-if="display_discount">Disc.%</th>
                                        <!--<th style="width:10%; text-align:right;font-size:14px;">Steuern</th>-->
                                        <th style="width:13%; text-align:right;font-size:14px;">Amount</th>
                                    </tr>
                                </thead>
                            
                                <tbody>
                                    <t t-set="pos" t-value="0"/>
                                    <t t-foreach="doc.invoice_line_ids" t-as="line">
                                        <!--<t t-set="pos" t-value="pos + 1"/>-->
                                        <tr style="border-bottom:1px solid #e0e0e0;margin-bottom:20px;">
                                            <t t-if="line.display_type == 'product'">
                                                <t t-set="pos" t-value="pos + 1"/>
                                                <td style="font-size:14px;">
                                                    <t t-esc="pos"/>
                                                </td>
                                
                                                <td style="white-space:normal;font-size:14px; word-wrap: break-word; word-break: break-word;max-width:20px;padding-top:7px;padding-bottom:7px;">
                                                    <!-- <t t-esc="line.name"/> -->
                                                    <t t-esc="line.product_id.display_name"/>
                                                    <t t-esc="line.product_id.description"/>
                                                </td>
                                
                                               <td style="text-align:right;font-size:14px;">
                                                    <t t-esc="'{:.2f}'.format(line.quantity)"/> 
                                                    <t t-esc="line.product_uom_id.with_context(lang='de_DE').name"/>
                                                </td>
    
                                
                                                <td style="text-align:right;font-size:14px;">
                                                    <t t-esc="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                                </td>
                                                <td t-if="display_discount" style="text-align:right;font-size:14px;">
                                                    <t t-esc="line.discount"/>%
                                                    <!--<span t-field="line.discount">-</span>-->
                                                </td>
                                
                                                <td style="text-align:right;font-size:14px;">
                                                    <t t-if="doc.move_type == 'out_refund'">-</t>
                                                    <t t-esc="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                                </td>
                                            </t>
                                            <t t-elif="line.display_type == 'line_section'">
                                                <td name="td_section_line" colspan="99" style="background-color: #D3D3D3; font-weight:bold; white-space:normal;font-size:14px; word-wrap: break-word; word-break: break-word;max-width:20px;padding-top:7px;padding-bottom:7px;">
                                                    <span t-field="line.name">A section title</span>
                                                </td>
                                            </t>
                                            <t t-elif="line.display_type == 'line_note'">
                                                <td name="td_note_line" colspan="99" style="font-style: italic;white-space:normal;font-size:14px; word-wrap: break-word; word-break: break-word;max-width:20px;padding-top:7px;padding-bottom:7px;">
                                                    <span t-field="line.name">A note, whose content usually applies to the section or product above.</span>
                                                </td>
                                            </t>
                                        </tr>
                                       
                                    </t>
                                </tbody>
                            </table>
                            
                            <table style="margin-top:8mm; font-size:12px; line-height:1.2; width:100%; page-break-inside: avoid;">
                                <tr>
                            
                                    <td style="width:60%; vertical-align:top;">
                                        <div style="white-space:normal;font-size:12px; word-wrap: break-word; word-break: break-word;max-width:100%;">
                                            
                                            <div>
                                                Agreements exist that may result in subsequent reductions of the final price.
                                                
                                            </div>
                                            
                                        </div>
                                        
                                        <div style="white-space:normal;font-size:12px; word-wrap: break-word; word-break: break-word;max-width:100%;">
                                            <t t-if="doc.narration">
                                                <t t-esc="doc.narration"/>
                                            </t>
                                        
                                        </div>
                                        <t t-if=" not doc.move_type == 'out_refund'">
                                            <div style="font-size:12px;">
                                                Payment Terms:
                                                <t t-if="doc.invoice_payment_term_id">
                                                    <t t-esc="doc.invoice_payment_term_id.name"/>
                                                </t>
                                                <t t-else="">
                                                   Zahlbar 10 Tage Skonto netto.
                                                </t>
                                            </div>
                                            <t t-if="doc.invoice_payment_term_id.early_discount  and doc.state == 'posted'">
                                                <div style="font-size:12px;">
                                                    <t t-esc="doc.discount_amount" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                                                     with
                                                     <t t-esc="doc.invoice_payment_term_id.discount_percentage"/>% 
                                                     discount unit
                                                     <t t-esc="doc.extended_date" t-options="{'widget': 'date' , 'format': 'dd.MM.yyyy'}"/>.
                                                     After that
                                                     <t t-esc="doc.amount_total" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                                                     without discount.
                                                </div>
                                            </t>
                                        </t>
                                        
                                        <!--<t t-if="doc.invoice_payment_term_id and 'Banklastschrift' not in doc.invoice_payment_term_id.name">-->
                                        <!--    <div style="font-size:12px;">-->
                                                
                                        <!--        Bei Zahlung bis-->
                                        <!--        <t t-if="doc.invoice_date_due and doc.amount_total">-->
                                        <!--            <t t-esc="doc.invoice_date_due" t-options="{'widget': 'date' , 'format': 'dd.MM.yyyy'}"/>-->
                                        <!--            :-->
                                        <!--            <t t-esc="doc.amount_total" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>-->
                                                    
                                        <!--        </t>-->
                                        <!--    </div>-->
                                        <!--</t>-->
                                        <!-- <t t-if="doc.invoice_payment_term_id and 'Banklastschrift' in doc.invoice_payment_term_id.name">
                        
                                            <div style="font-size:12px;">
                                                <t t-esc="doc.invoice_payment_term_id.note"/>
                                            </div>
                                        </t> -->
                                    </td>
                            
                            
                                    <td style="width:40%; vertical-align:top; padding-left:10mm;">
                                        <table style="width:100%; border-collapse:collapse; font-size:12px;">
                                            
                            
                                            <tr style="font-size:14px;">
                                                <t t-if=" not doc.partner_id.reverse_charge">
                                                    <td style="text-align:left;">Untaxed Amount:</td>
                                                </t>
                                                <t t-else="">
                                                    <td style="text-align:left;">Total Amount:</td>
                                                </t>
                                                <td style="text-align:right;">
                                                    <t t-if="doc.move_type == 'out_refund'">-</t>
                                                    <t t-esc="doc.amount_untaxed" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                                                </td>
                                            </tr>
                            
                                            <t t-if=" not doc.partner_id.reverse_charge">
                                                <tr style="font-size:14px;">
                                                    <td style="text-align:left;">VAT 19%:</td>
                                                    <td style="text-align:right;">
                                                        <t t-if="doc.move_type == 'out_refund'">-</t>
                                                        <t t-esc="doc.amount_tax" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                                                    </td>
                                                </tr>
                                            </t>
                            
