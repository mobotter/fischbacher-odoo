<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_report_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.report.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="purchase_no" />
                <field name="order_number" />
                <!-- Task Id 33897 JC -->
                <field name="client_order_number" />
                <field name="client_order_name" />
                <!-- Task Id 33897 JC -->
            </xpath>

            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="is_rent" invisible="1"/>
                <field name="hide_total" />
                <field name="german_payment_term" />
            </xpath>

        </field>
    </record>

    <record id="acc_move_report_form_inherit" model="ir.ui.view">
        <field name="name">acc.move.report.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="is_rent" invisible="1"/>

            </xpath>

        </field>
    </record>
</odoo>