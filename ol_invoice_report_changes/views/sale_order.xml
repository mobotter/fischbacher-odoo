<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sale_order_report_form_inherit" model="ir.ui.view">
            <field name="name">sale.order.report.form.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='tag_ids']" position="after">
                    <field name="purchase_no"/>
                    <field name="client_order_number"/>
                    <!-- Bei Subscription ODER plan_id sichtbar -->
                    <field name="lease_agreement_no" invisible="not is_subscription and not plan_id"/>
                    <field name="client_order_name"/>
                </xpath>

                <xpath expr="//field[@name='payment_term_id']" position="after">
                    <field name="hide_total"/>
                </xpath>
            </field>
        </record>

        <!-- Der acc_move_report_form_inherit Block wurde entfernt, da is_rent nicht mehr existiert -->
    </data>
</odoo>
