<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_order_confirmation_report_new" inherit_id="sale.report_saleorder_raw">
        <xpath expr="//t" position="replace">
            <!-- Task Id 35336 JC  -->
            <t t-foreach="docs" t-as="doc"> 
                <t t-call="ol_invoice_report_changes.external_layout_for_sale_confirmation">
                <main>
                    <div class="page"> 
                       
                        <!-- WICHTIG: border: none !important; verhindert das Bootstrap-Styling von Odoo 19 -->
                        <table style="width:100%; border-collapse:collapse; border: none !important; margin-top:10mm;">
                            <tr style="border: none !important;">
                                <td style="width:50%;vertical-align:top;height:45mm;max-height:45mm;overflow:hidden;font-size:13px; border: none !important;">
                                    <div style="margin-top:5mm;">
                                        <div style="font-size:10.5px; margin-bottom:4px;border-bottom:1px solid #ccc;">
                                            <span t-field="doc.company_id.name"/> |
                                            <span t-field="doc.company_id.street"/> |
                                            <span t-field="doc.company_id.zip"/>
                                            <span t-field="doc.company_id.city"/>
                                        </div>
                    
                                        <strong>
                                            <t t-out="doc.partner_id.name"/>
                                        </strong><br/>
                                        <t t-out="doc.partner_id.street"/><br/>
                                        <t t-if="doc.partner_id.street2">
                                            <t t-out="doc.partner_id.street2"/><br/>
                                        </t>
                                        <t t-out="doc.partner_id.zip"/>
                                        <t t-out="doc.partner_id.city"/><br/>
                                        <t t-out="doc.partner_id.country_id.name"/>
                                    </div>
                                </td>
                
                                <td style="width:45%;vertical-align:top;padding-left:15mm;line-height:1.5; border: none !important;">
                                    <table style="width:100%; border-collapse:collapse; border: none !important;">
                                        <t t-if="doc.name">
                                            <tr style="border: none !important;">
                                                <td style="width:55%;font-size:13px; border: none !important;">Order Number: </td>
                                                <td style="font-size:13px;padding-left:3px; border: none !important;"><t t-out="doc.name"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.date_order">
                                            <tr style="border: none !important;">
                                                <td style="font-size:13px; border: none !important;">Order Date: </td>
                                                <td style="font-size:13px;padding-left:3px; border: none !important;"><t t-out="doc.date_order" t-options="{'widget': 'date' , 'format': 'dd.MM.yyyy'}"/></td>
                                            </tr>
                                        </t>
                                        
                                        <t t-if="doc.partner_id.ref">
                                            <tr style="border: none !important;">
                                                <td style="font-size:13px; border: none !important;">Client Number: </td>
                                                <td style="font-size:13px;padding-left:3px; border: none !important;"><t t-out="doc.partner_id.ref"/></td>
                                            </tr>
                                        </t>
                                        <t t-else="not doc.partner_id.ref">
                                            <tr style="border: none !important;">
                                                <td style="font-size:13px; border: none !important;">Client Number: </td>
                                                <td style="font-size:13px;padding-left:3px; border: none !important;"><t t-out="doc.partner_id.id"/></td>
                                            </tr>
                                        </t>
        
                                        <t t-if="doc.client_order_name">
                                            <tr style="border: none !important;">
                                                <td style="font-size:13px; border: none !important;">Ordered by: </td>
                                                <td style="font-size:13px;padding-left:3px; border: none !important;"><t t-out="doc.client_order_name"/></td>
                                            </tr>
                                        </t>
                                        
                                        <t t-if="doc.client_order_number">
                                            <tr style="border: none !important;">
                                                <td style="font-size:13px; border: none !important;">Your Order Number: </td>
                                                <td style="font-size:13px;padding-left:3px; border: none !important;"><t t-out="doc.client_order_number"/></td>
                                            </tr>
                                        </t>
                                        
                                        <t t-if="doc.carrier_id">
                                            <tr style="border: none !important;">
                                                <td style="font-size:13px; border: none !important;">Shipping Method: </td>
                                                <td style="font-size:13px;padding-left:3px; border: none !important;"><t t-out="doc.carrier_id.name"/></td>
                                            </tr>
                                        </t>
                                        
                                        <t t-if="doc.incoterm">
                                            <tr style="border: none !important;">
                                                <td style="font-size:13px; border: none !important;">Delivery Terms: </td>
                                                <td style="font-size:13px;padding-left:3px; border: none !important;"><t t-out="doc.incoterm.name"/></td>
                                            </tr>
                                        </t>
                                        
                                        <t t-if="doc.user_id.name">
                                            <tr style="border: none !important;">
                                                <td style="font-size:13px; border: none !important;">Salesperson: </td>
                                                <td style="font-size:13px;padding-left:3px; border: none !important;"><t t-out="doc.user_id.name"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.user_id.phone">
                                            <tr style="border: none !important;">
                                                <td style="font-size:13px; border: none !important;">Phone: </td>
                                                <td style="font-size:13px;padding-left:3px; border: none !important;"><t t-out="doc.user_id.phone"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.user_id.login">
                                            <tr style="border: none !important;">
                                                <td style="font-size:13px; border: none !important;">Email: </td>
                                                <td style="font-size:13px;padding-left:3px; border: none !important;"><t t-out="doc.user_id.login"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.client_order_ref">
                                            <tr style="border: none !important;">
                                                <td style="font-size:13px;vertical-align:top; border: none !important;">Project: </td>
                                                <td style="font-size:13px;padding-left:3px;white-space:normal;word-wrap: break-word; word-break: break-word; vertical-align:top; border: none !important;"><t t-out="doc.client_order_ref"/></td>
                                            </tr>
                                        </t>
                                    </table>
                                </td>
                            </tr>
                        </table>
                        <h2 style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">
                            Order Confirmation
                        </h2>
                        <!-- Is there a discount on at least one line? -->
                        <t t-set="lines_to_report" t-value="doc._get_order_lines_to_report()"/>
                        <t t-set="display_discount" t-value="any(l.discount for l in lines_to_report)"/>
                        
                        <!-- Hier entfernen wir class="table-borderless" und zwingen es per CSS -->
                        <table style="width:100%; border-collapse:collapse; font-size:12px; border: none !important;">
                            <thead>
                                <tr style="border: none !important;">
                                    <th colspan="3" style="text-align:left; font-size:12px; font-weight:600; padding:6px 0; border: none !important;"></th>
                                    <th colspan="4" style="text-align:right; font-size:12px; border: none !important;">
                                            Order Number: <t t-out="doc.name"/>
                                    </th>
                                </tr>
                                <!-- Diese Zeile behält einen unteren Rahmen (Trennstrich), falls du das mochtest -->
                                <tr style="border-bottom:1px solid #ccc; margin-bottom:2px;">
                                    <th style="width:5%; text-align:left;font-size:14px; border:none; border-bottom:1px solid #ccc;">POS</th>
                                    <th style="width:45%; text-align:left;font-size:14px; border:none; border-bottom:1px solid #ccc;">Description</th>
                                    <th style="width:15%; text-align:right;font-size:14px; border:none; border-bottom:1px solid #ccc;">Quantity</th>
                                    <th style="width:12%; text-align:right;font-size:14px; border:none; border-bottom:1px solid #ccc;">Unit Price</th>
                                    <th style="width:10%; text-align:right;font-size:14px; border:none; border-bottom:1px solid #ccc;" t-if="display_discount">Disc.%</th>
                                    <th style="width:13%; text-align:right;font-size:14px; border:none; border-bottom:1px solid #ccc;">Amount</th>
                                </tr>
                            </thead>
                        
                            <tbody>
                                <t t-set="pos" t-value="0"/>
                                <t t-foreach="doc.order_line" t-as="line">
                                    <!-- Hier auch border: none außer einem unteren Rahmen für Positionen -->
                                    <tr style="border: none; border-bottom:1px solid #e0e0e0; margin-bottom:20px;">
                                        <t t-if="not line.display_type and line.product_type != 'combo'">
                                            <t t-set="pos" t-value="pos + 1"/>
                                            <td style="font-size:14px; border: none; border-bottom:1px solid #e0e0e0;">
                                                <t t-out="pos"/>
                                            </td>
                                            
                                            <td style="border: none; border-bottom:1px solid #e0e0e0;">
                                                <pre style="border:none; background-color: #FFF; margin: 0; padding: 0; padding-top:7px;padding-bottom:7px;" t-out="line.name"/>
                                            </td>
                            
                                           <td style="text-align:right;font-size:14px; border: none; border-bottom:1px solid #e0e0e0;">
                                                <t t-out="'{:.2f}'.format(line.product_uom_qty)"/> 
                                                <t t-out="line.product_uom_id.with_context(lang='de_DE').name"/>
                                            </td>
                            
                                            <td style="text-align:right;font-size:14px; border: none; border-bottom:1px solid #e0e0e0;">
                                                <t t-out="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                            </td>
                                            <td t-if="display_discount" style="text-align:right;font-size:14px; border: none; border-bottom:1px solid #e0e0e0;">
                                                <t t-out="line.discount"/>%
                                            </td>
                            
                                            <td style="text-align:right;font-size:14px; border: none; border-bottom:1px solid #e0e0e0;">
                                                <t t-out="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                            </td>
                                        </t>
                                        <t t-elif="line.display_type == 'line_section' or line.product_type == 'combo'">
                                            <td name="td_section_line" colspan="99" style="background-color: #D3D3D3; border: none; font-weight:bold; white-space:normal;font-size:14px; word-wrap: break-word; word-break: break-word;max-width:20px;padding-top:7px;padding-bottom:7px;">
                                                <span t-field="line.name">A section title</span>
                                            </td>
                                        </t>
                                        <t t-elif="line.display_type == 'line_note'">
                                            <td name="td_note_line" colspan="99" style="font-style: italic; border: none; white-space:normal;font-size:14px; word-wrap: break-word; word-break: break-word;max-width:20px;padding-top:7px;padding-bottom:7px;">
                                                <span t-field="line.name">A note, whose content usually applies to the section or product above.</span>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        
                        <table style="margin-top:4mm; font-size:12px; line-height:1.1; width:100%; page-break-inside: avoid; border: none !important;">
                            <tr style="border: none !important;">
                                <td style="width:60%; vertical-align:top; border: none !important;">
                                    <t>
                                       <div style="white-space:normal;font-size:12px; word-wrap: break-word; word-break: break-word;max-width:100%;">
                                            Prices:
                                            <div>Ex works, conditions as described above,</div>
                                            <div>subject to prior sale, plus statutory VAT.</div>
                                        </div>
                                        <br/>
                                    </t>
                        
                                    <div style="white-space:normal;">
                                        Payment Terms:
                                        <div>
                                            <t t-if="doc.is_subscription">
                                                <t t-if="doc.german_payment_term">
                                                    <t t-out="doc.german_payment_term"/>
                                                </t>
                                                <t t-else="">
                                                    Zahlbar 10 Tage Skonto netto.
                                                </t>
                                            </t>
                                            <t t-else="">
                                                <t t-if="doc.payment_term_id.name">
                                                    <t t-out="doc.payment_term_id.name"/>
                                                </t>
                                                <t t-else="">
                                                   Zahlbar 10 Tage Skonto netto.
                                                </t>
                                            </t>
                                        </div>
                                    </div>
                                    <br/>
                                    <div style="white-space:normal;">
                                        <div>
                                            <t t-if="doc.note">
                                                <t t-out="doc.note"/>
                                            </t>
                                        </div>
                                    </div>
                                </td>
                        
                                <td style="width:40%; vertical-align:top; padding-left:10mm; border: none !important;">
                                    <table style="width:100%; border-collapse:collapse; font-size:12px; border: none !important;">
                                        <t t-if="not doc.hide_total">
                                            <tr style="font-size:14px; border: none !important;">
                                                <td style="text-align:left; border: none !important;">Untaxed Amount:</td>
                                                <td style="text-align:right; border: none !important;">
                                                    <t t-out="doc.amount_untaxed" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                                                </td>
                                            </tr>
                                            <tr style="font-size:14px; border: none !important;">
                                                <td style="text-align:left; border: none !important;">VAT 19%:</td>
                                                <td style="text-align:right; border: none !important;">
                                                    <t t-out="doc.amount_tax" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                                                </td>
                                            </tr>
                                            <tr style="font-weight:bold; font-size:14px; border: none !important;">
                                                <td style="text-align:left; border: none !important;">Total:</td>
                                                <td style="text-align:right; border: none !important;">
                                                    <t t-out="doc.amount_total" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </div>
                </main>
                </t>
            </t> 
        </xpath>
    </template>
</odoo>
