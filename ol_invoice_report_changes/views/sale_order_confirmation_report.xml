<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_order_confirmation_report_new" inherit_id="sale.report_saleorder_raw">
        <xpath expr="//div[hasclass('page')]" position="replace">
            <div class="page">
                <!-- Very similar structure to sale_order_report.xml, keeping it DRY where possible -->
                <t t-set="report_sections" t-value="doc._get_report_sections_for_pdf()"/>
                <t t-set="lines_to_report" t-value="doc.quotation_lines if (doc.is_rent and hasattr(doc, 'quotation_lines')) else doc.order_line"/>
                <t t-set="display_discount" t-value="any(l.discount for l in lines_to_report if not l.display_type)"/>

                <table class="table-borderless" style="width:100%; border-collapse:collapse; margin-top:10mm;">
                    <tr>
                        <td style="width:50%; vertical-align:top; font-size:13px;">
                            <strong><t t-esc="doc.partner_id.name"/></strong><br/>
                            <t t-esc="doc.partner_id.street"/><br/>
                            <t t-esc="doc.partner_id.zip"/> <t t-esc="doc.partner_id.city"/>
                        </td>
                        <td style="width:45%; vertical-align:top; padding-left:15mm;">
                            <table style="width:100%;">
                                <tr><td style="font-size:13px;">Order Number:</td><td style="font-size:13px;"><t t-esc="doc.name"/></td></tr>
                                <tr><td style="font-size:13px">Order Date:</td><td style="font-size:13px;"><t t-esc="doc.date_order" t-options="{'widget': 'date'}"/></td></tr>
                            </table>
                        </td>
                    </tr>
                </table>

                <h2 style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">
                    <t t-if="doc.is_rent">Rental Order Confirmation</t>
                    <t t-else="">Order Confirmation</t>
                </h2>

                <table class="table-borderless" style="width:100%; border-collapse:collapse; font-size:12px;">
                    <!-- Table rendering exact same logic as Quotation -->
                    <thead>
                        <tr class="border-bottom">
                            <th style="width:5%; text-align:left;">POS</th>
                            <th style="width:45%; text-align:left;">Description</th>
                            <th style="width:12%; text-align:right;">Quantity</th>
                            <th style="width:12%; text-align:right;">Unit Price</th>
                            <th t-if="display_discount" style="width:10%; text-align:right;">Disc.%</th>
                            <th style="width:16%; text-align:right;">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="pos" t-value="0"/>
                        <t t-foreach="report_sections" t-as="section">
                            <t t-if="section['title']">
                                <tr class="bg-light fw-bold">
                                    <td t-attf-colspan="#{5 if display_discount else 4}"><span t-esc="section['title']"/></td>
                                    <td class="text-end"><t t-esc="section['subtotal']" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/></td>
                                </tr>
                            </t>
                            <t t-if="not section['hide_composition']">
                                <t t-foreach="section['product_lines']" t-as="product">
                                    <t t-set="line" t-value="product['line']"/>
                                    <t t-set="pos" t-value="pos + 1"/>
                                    <tr class="border-bottom">
                                        <td><t t-esc="pos"/></td>
                                        <td><span t-out="line.name"/></td>
                                        <td class="text-end"><t t-esc="line.product_uom_qty"/> <t t-esc="line.product_uom_id.name"/></td>
                                        <td class="text-end"><t t-if="product['show_prices']"><t t-esc="line.price_unit" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/></t></td>
                                        <td t-if="display_discount" class="text-end"><t t-if="product['show_prices']"><t t-esc="line.discount"/>%</t></td>
                                        <td class="text-end"><t t-if="product['show_prices']"><t t-esc="line.price_subtotal" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/></t></td>
                                    </tr>
                                </t>
                            </t>
                        </t>
                    </tbody>
                </table>
            </div>
        </xpath>
    </template>
</odoo>
