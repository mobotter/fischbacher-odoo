<odoo>
    <record id="report_invoice_custom_paperformat" model="report.paperformat">
        <field name="name">Invoice Custom Paper Format</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="margin_top" eval="35"/>
        <field name="margin_bottom" eval="25"/>
        <field name="margin_left" eval="20"/>
        <field name="margin_right" eval="10"/>
        <field name="orientation">Portrait</field>
        <field name="header_spacing" eval="25"/>
        <field name="dpi" eval="90"/>
    </record>
</odoo>
