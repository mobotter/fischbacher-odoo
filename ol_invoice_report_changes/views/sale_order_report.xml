<?xml version="1.0" encoding="utf-8"?>
<!--
    Datei: sale_order_report.xml
    Zweck: Custom QWeb-Report für Angebots-/Auftragsdruck
    Ausgabe: PDF mit Adressblock, Positionsliste, Rental-Quotation-Logik,
             Sections/Notes, Summen und Zahlungsbedingungen

    Wichtige Logik:
    - Rental Quote:
      rendert direkt aus quotation_lines / quotation_line_ids
      und umgeht report_sections vollständig
    - Standard Quote / Order:
      rendert weiter aus order_line
-->
<odoo>
    <template id="sale_report_new" inherit_id="sale.report_saleorder" priority="30">
        <xpath expr="//t[@t-call='sale.report_saleorder_raw']" position="replace">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.html_container">
                    <t t-call="web.external_layout">
                        <main>
                            <!-- Rental-Erkennung nur über bestehende Felder -->
                            <t t-set="is_rental"
                               t-value="('is_subscription' in doc._fields and doc.is_subscription) or ('has_plan' in doc._fields and doc.has_plan)"/>

                            <!-- Zeilenquelle:
                                 Rental => quotation_lines / quotation_line_ids
                                 Standard => order_line -->
                            <t t-if="is_rental">
                                <t t-if="'quotation_lines' in doc._fields">
                                    <t t-set="lines_to_report" t-value="doc.quotation_lines"/>
                                </t>
                                <t t-elif="'quotation_line_ids' in doc._fields">
                                    <t t-set="lines_to_report" t-value="doc.quotation_line_ids"/>
                                </t>
                                <t t-else="">
                                    <t t-set="lines_to_report" t-value="doc.order_line"/>
                                </t>
                            </t>
                            <t t-else="">
                                <t t-set="lines_to_report" t-value="doc.order_line"/>
                            </t>

                            <!-- Kopfbereich / Adressblock -->
                            <div class="page">

                                <table style="width:100%; border-collapse:collapse; margin-bottom:30px;">
                                    <tr>
                                        <td style="width:50%; vertical-align:top; padding-right:20px;">
                                            <div t-if="doc.partner_invoice_id">
                                                <strong>
                                                    <span t-field="doc.partner_invoice_id.name"/>
                                                </strong><br/>

                                                <t t-if="doc.partner_invoice_id.parent_id">
                                                    <span t-field="doc.partner_invoice_id.parent_id.name"/><br/>
                                                </t>

                                                <span t-field="doc.partner_invoice_id.street"/><br t-if="doc.partner_invoice_id.street2 or doc.partner_invoice_id.city"/>
                                                <t t-if="doc.partner_invoice_id.street2">
                                                    <span t-field="doc.partner_invoice_id.street2"/><br/>
                                                </t>
                                                <span t-field="doc.partner_invoice_id.zip"/>
                                                <span t-field="doc.partner_invoice_id.city"/><br/>
                                                <span t-field="doc.partner_invoice_id.country_id.name"/>
                                            </div>
                                        </td>

                                        <td style="width:50%; vertical-align:top; text-align:left;">
                                            <table style="width:100%; border-collapse:collapse;">
                                                <tr>
                                                    <td style="padding:2px 0; width:45%;"><strong>Quotation / Order:</strong></td>
                                                    <td style="padding:2px 0;">
                                                        <span t-field="doc.name"/>
                                                    </td>
                                                </tr>

                                                <tr t-if="doc.client_order_ref">
                                                    <td style="padding:2px 0;"><strong>Customer Reference:</strong></td>
                                                    <td style="padding:2px 0;">
                                                        <span t-field="doc.client_order_ref"/>
                                                    </td>
                                                </tr>

                                                <tr t-if="doc.date_order">
                                                    <td style="padding:2px 0;"><strong>Date:</strong></td>
                                                    <td style="padding:2px 0;">
                                                        <span t-field="doc.date_order" t-options="{'widget': 'date'}"/>
                                                    </td>
                                                </tr>

                                                <tr t-if="doc.user_id">
                                                    <td style="padding:2px 0;"><strong>Salesperson:</strong></td>
                                                    <td style="padding:2px 0;">
                                                        <span t-field="doc.user_id.name"/>
                                                    </td>
                                                </tr>

                                                <tr t-if="doc.partner_shipping_id and doc.partner_shipping_id != doc.partner_invoice_id">
                                                    <td style="padding:2px 0; vertical-align:top;"><strong>Delivery Address:</strong></td>
                                                    <td style="padding:2px 0;">
                                                        <span t-field="doc.partner_shipping_id.name"/><br/>
                                                        <span t-field="doc.partner_shipping_id.street"/><br t-if="doc.partner_shipping_id.street2 or doc.partner_shipping_id.city"/>
                                                        <t t-if="doc.partner_shipping_id.street2">
                                                            <span t-field="doc.partner_shipping_id.street2"/><br/>
                                                        </t>
                                                        <span t-field="doc.partner_shipping_id.zip"/>
                                                        <span t-field="doc.partner_shipping_id.city"/><br/>
                                                        <span t-field="doc.partner_shipping_id.country_id.name"/>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>

                                <!-- Titel -->
                                <div style="margin-bottom:20px;">
                                    <h2 style="margin:0; font-size:24px;">
                                        <t t-if="is_rental and doc.state in ['draft', 'sent']">Rental Quote</t>
                                        <t t-elif="is_rental">Rental Order</t>
                                        <t t-elif="doc.state in ['draft', 'sent']">Quotation</t>
                                        <t t-else="">Order Confirmation</t>
                                    </h2>
                                </div>

                                <!-- Positionsliste -->
                                <div class="table-responsive">
                                    <table style="width:100%; border-collapse:collapse; font-size:14px;">
                                        <thead>
                                            <tr style="border-bottom:1px solid #000;">
                                                <th style="text-align:left; padding:8px 6px;">Description</th>
                                                <th style="text-align:right; padding:8px 6px; width:90px;">Qty</th>
                                                <th style="text-align:right; padding:8px 6px; width:120px;">Unit Price</th>
                                                <th style="text-align:right; padding:8px 6px; width:120px;">Taxes</th>
                                                <th style="text-align:right; padding:8px 6px; width:120px;">Amount</th>
                                            </tr>
                                        </thead>
                                        <tbody>

                                            <!-- Rental-Fall:
                                                 direkt aus lines_to_report rendern,
                                                 KEIN report_sections -->
                                            <t t-if="is_rental">

                                                <t t-foreach="lines_to_report" t-as="line">

                                                    <!-- Section -->
                                                    <tr t-if="line.display_type == 'line_section'"
                                                        style="background:#e9e9e9; font-weight:bold;">
                                                        <td colspan="5" style="padding:8px 6px; white-space:normal;">
                                                            <span t-field="line.name"/>
                                                        </td>
                                                    </tr>

                                                    <!-- Note -->
                                                    <tr t-elif="line.display_type == 'line_note'">
                                                        <td colspan="5"
                                                            style="padding:7px 6px; font-style:italic; white-space:normal; word-wrap:break-word; word-break:break-word;">
                                                            <span t-field="line.name"/>
                                                        </td>
                                                    </tr>

                                                    <!-- Normale Position -->
                                                    <tr t-else="">
                                                        <td style="padding:7px 6px; vertical-align:top; white-space:normal; word-wrap:break-word; word-break:break-word;">
                                                            <span t-field="line.name"/>
                                                        </td>

                                                        <td style="padding:7px 6px; text-align:right; vertical-align:top;">
                                                            <span t-field="line.product_uom_qty"/>
                                                            <t t-if="line.product_uom">
                                                                <span t-field="line.product_uom"/>
                                                            </t>
                                                        </td>

                                                        <td style="padding:7px 6px; text-align:right; vertical-align:top;">
                                                            <span t-field="line.price_unit"/>
                                                        </td>

                                                        <td style="padding:7px 6px; text-align:right; vertical-align:top;">
                                                            <span t-esc="', '.join([(tax.description or tax.name) for tax in line.tax_id])"/>
                                                        </td>

                                                        <td style="padding:7px 6px; text-align:right; vertical-align:top;">
                                                            <span t-field="line.price_subtotal"/>
                                                        </td>
                                                    </tr>

                                                </t>
                                            </t>

                                            <!-- Standard-Fall:
                                                 weiter klassisch aus order_line -->
                                            <t t-else="">
                                                <t t-foreach="lines_to_report" t-as="line">

                                                    <!-- Section -->
                                                    <tr t-if="line.display_type == 'line_section'"
                                                        style="background:#e9e9e9; font-weight:bold;">
                                                        <td colspan="5" style="padding:8px 6px; white-space:normal;">
                                                            <span t-field="line.name"/>
                                                        </td>
                                                    </tr>

                                                    <!-- Note -->
                                                    <tr t-elif="line.display_type == 'line_note'">
                                                        <td colspan="5"
                                                            style="padding:7px 6px; font-style:italic; white-space:normal; word-wrap:break-word; word-break:break-word;">
                                                            <span t-field="line.name"/>
                                                        </td>
                                                    </tr>

                                                    <!-- Normale Position -->
                                                    <tr t-else="">
                                                        <td style="padding:7px 6px; vertical-align:top; white-space:normal; word-wrap:break-word; word-break:break-word;">
                                                            <span t-field="line.name"/>
                                                        </td>

                                                        <td style="padding:7px 6px; text-align:right; vertical-align:top;">
                                                            <span t-field="line.product_uom_qty"/>
                                                            <t t-if="line.product_uom">
                                                                <span t-field="line.product_uom"/>
                                                            </t>
                                                        </td>

                                                        <td style="padding:7px 6px; text-align:right; vertical-align:top;">
                                                            <span t-field="line.price_unit"/>
                                                        </td>

                                                        <td style="padding:7px 6px; text-align:right; vertical-align:top;">
                                                            <span t-esc="', '.join([(tax.description or tax.name) for tax in line.tax_id])"/>
                                                        </td>

                                                        <td style="padding:7px 6px; text-align:right; vertical-align:top;">
                                                            <span t-field="line.price_subtotal"/>
                                                        </td>
                                                    </tr>

                                                </t>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Summen -->
                                <div style="margin-top:25px; width:100%;">
                                    <div style="width:320px; margin-left:auto;">
                                        <table style="width:100%; border-collapse:collapse; font-size:14px;">
                                            <tr>
                                                <td style="padding:6px 0;"><strong>Untaxed Amount</strong></td>
                                                <td style="padding:6px 0; text-align:right;">
                                                    <span t-field="doc.amount_untaxed"/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding:6px 0;"><strong>Taxes</strong></td>
                                                <td style="padding:6px 0; text-align:right;">
                                                    <span t-field="doc.amount_tax"/>
                                                </td>
                                            </tr>
                                            <tr style="border-top:1px solid #000;">
                                                <td style="padding:8px 0;"><strong>Total</strong></td>
                                                <td style="padding:8px 0; text-align:right;">
                                                    <strong><span t-field="doc.amount_total"/></strong>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>

                                <!-- Notizen / Zahlungsbedingungen -->
                                <div style="margin-top:30px;">
                                    <div t-if="doc.note" style="margin-bottom:18px;">
                                        <strong>Notes</strong><br/>
                                        <span t-field="doc.note"/>
                                    </div>

                                    <div t-if="doc.payment_term_id">
                                        <strong>Payment Terms</strong><br/>
                                        <span t-field="doc.payment_term_id.note"/>
                                    </div>
                                </div>

                            </div>
                        </main>
                    </t>
                </t>
            </t>
        </xpath>
    </template>
</odoo>
