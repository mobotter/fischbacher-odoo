<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_report_new" inherit_id="sale.report_saleorder">
        <xpath expr="//t[@t-call='sale.report_saleorder_raw']" position="replace">
    
            <t t-foreach="docs" t-as="doc"> 
            <!--<t t-set="doc" t-value="doc.with_context(lang='de_DE')"/>-->
            <!--<t t-set="o" t-value="o.with_context(lang=lang)" -->
                <t t-call="ol_invoice_report_changes.external_layout_for_invoice">

                <main>
                    <div class="page"> 
                        <!-- <t t-if="doc.invoice_origin">
                            <t t-set="sale_orders" t-value="doc.env['sale.order'].search([('name', '=', doc.invoice_origin)])"/>

                            
                        </t> -->
                
                        <table style="width:100%; border-collapse:collapse; margin-top:10mm;">
                            <tr>
                
                                <td style="width:50%;vertical-align:top;height:45mm;max-height:45mm;overflow:hidden;font-size:13px;">
                                    <div style="margin-top:5mm;">
                                        <div style="font-size:10.5px; margin-bottom:4px;border-bottom:1px solid #ccc;">
                                            <span t-field="doc.company_id.name"/> |
                                            <span t-field="doc.company_id.street"/> |
                                            <span t-field="doc.company_id.zip"/>
                                            <span t-field="doc.company_id.city"/>
                                        </div>
                    
                                        <strong>
                                            <t t-esc="doc.partner_id.name"/>
                                        </strong><br/>
                                        <t t-esc="doc.partner_id.street"/><br/>
                                        <t t-if="doc.partner_id.street2">
                                            <t t-esc="doc.partner_id.street2"/><br/>
                                        </t>
                                        <t t-esc="doc.partner_id.zip"/>
                                        <t t-esc="doc.partner_id.city"/><br/>
                                        <t t-esc="doc.partner_id.country_id.name"/>
                                    </div>
                                </td>
                
                                <td style="width:45%;vertical-align:top;padding-left:15mm;line-height:1.5;">
                
                                    <table style="width:100%; border-collapse:collapse;">
                                        <t t-if="doc.name">
                                            <tr>
                                                <td style="width:55%;font-size:13px;">Angebotsnr: </td>
                                                <td style="font-size:13px;padding-left:3px;"><t t-esc="doc.name"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.date_order">
                                            <tr>
                                                <td style="font-size:13px">Angebotsdatum: </td>
                                                <td style="font-size:13px;padding-left:3px;"><t t-esc="doc.date_order" t-options="{'widget': 'date' , 'format': 'dd.MM.yyyy'}"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.end_date">
                                            <tr>
                                                <td style="font-size:13px">Gültigkeit: </td>
                                                <td style="font-size:13px;padding-left:3px;"><t t-esc="doc.validity_date"  t-options="{'widget': 'date' , 'format': 'dd.MM.yyyy'}"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.client_order_ref">
                                            <tr>
                                                <td style="font-size:13px;vertical-align:top;">Kundenreferenz: </td>
                                                <td style="font-size:13px;padding-left:3px;white-space:normal;word-wrap: break-word; word-break: break-word; vertical-align:top;"><t t-esc="doc.client_order_ref"/></td>
                                            </tr>
                                        </t>
        
                                        <t t-if="doc.user_id.name">
                                            <tr>
                                                <td style="font-size:13px">Vertriebsmitarbeiter: </td>
                                                <td style="font-size:13px;padding-left:3px;"><t t-esc="doc.user_id.name"/></td>
                                            </tr>
                                        </t>
                                        
                                        
        
                                        
                                    </table>
                
                                </td>
                            </tr>
                        </table>
                        <h2 style="color:#1f6fd2; font-weight:500; margin:10mm 0 5mm 0;">
                            Angebot
                        </h2>
                        <table style="width:100%; border-collapse:collapse; font-size:12px;">
                            <thead>
                                <tr>
                                    <th colspan="4" style="text-align:left; font-size:12px; font-weight:600; padding:6px 0;">
                                        <t t-if="doc.is_subscription">
                                            Mietzeitraum:
                                                <t t-esc="doc.plan_id.name"/>
                                                vom
                                                <t t-esc="doc.start_date" t-options="{'widget': 'date' , 'format': 'dd.MM.yyyy'}"/>
                                                bis
                                                <t t-esc="doc.next_invoice_date" t-options="{'widget': 'date' , 'format': 'dd.MM.yyyy'}"/>

                                        </t>
                                                                                        
                                            
                                        
                                    </th>
                        
        
                                </tr>
                                <tr style="border-bottom:1px solid #ccc;margin-bottom:2px;">
                                    <th style="width:5%; text-align:left;font-size:14px;">POS</th>
                                    <th style="width:45%; text-align:left;font-size:14px;">Beschreibung</th>
                                    <th style="width:15%; text-align:right;font-size:14px;">Menge</th>
                                    <th style="width:12%; text-align:right;font-size:14px;">Einzelpreis</th>
                                    <th style="width:10%; text-align:right;font-size:14px;">Steuern</th>
                                    <th style="width:13%; text-align:right;font-size:14px;">Betrag</th>
                                </tr>
                            </thead>
                        
                            <tbody>
                                <t t-set="pos" t-value="0"/>
                                <t t-foreach="doc.order_line" t-as="line">
                                    <t t-set="pos" t-value="pos + 1"/>
                        
                                    <tr style="border-bottom:1px solid #e0e0e0;margin-bottom:20px;">
                                        <td style="font-size:14px;">
                                            <t t-esc="pos"/>
                                        </td>
                        
                                        <td style="white-space:normal;font-size:14px; word-wrap: break-word; word-break: break-word;max-width:20px;padding-top:7px;padding-bottom:7px;">
                                            <t t-esc="line.name"/>
                                        </td>
                        
                                        <td style="text-align:right;font-size:14px;">
                                            <t t-esc="line.product_uom_qty"/>
                                            <t t-esc="line.product_uom.with_context(lang='de_DE').name"/>
                                        </td>
                        
                                        <td style="text-align:right;font-size:14px;">
                                            <t t-esc="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                        </td>
                        
                                        <td style="text-align:right;font-size:14px;">
                                            <t t-foreach="line.tax_id" t-as="tax">
                                                <t t-if="tax">
                                                    <t t-esc="tax.name"/>
                                                    
                                                </t>
                                                
                                            </t>
                                        </td>
                        
                                        <td style="text-align:right;font-size:14px;">
                                            <t t-esc="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        
                        <table style="margin-top:8mm; font-size:11px; line-height:1.4; width:100%;">
                            <tr>
                        
                        
                                <td style="width:60%; vertical-align:top;">
                                    <div style="white-space:normal;font-size:12px; word-wrap: break-word; word-break: break-word;max-width:100%;">
                                        Preise:
                                        <div>
                                            ab Werk, Konditionen wie beschrieben,
                                            
                                        </div>
                                        <div>
                                        
                                            Zwischenverkauf vorbehalten. zzgl. gesetzl MwSt.
                                        </div>
                                        
                                    
                                    </div>
                                    <br/>
                        
                        
                                    <div style="font-size:14px;">
                                        Zahlungsbedingungen:
                                        <div>
                                            <t t-if="doc.is_subscription">
                                                <t t-esc="doc.german_payment_term"/>
                                            </t>
                                            <t t-else="">
                                                <t t-esc="doc.payment_term_id.name"/>
                                            </t>
                                        </div>
                                        
                                        
                                    </div>
                                    <!-- <t t-if="doc.invoice_payment_term_id.early_discount">
                                        <div style="font-size:14px;">
                                            
                                            Bei Zahlung bis
                                            <t t-if="doc.extended_date and doc.discount_amount">
                                                <t t-esc="doc.extended_date" t-options="{'widget': 'date' , 'format': 'dd.MM.yyyy'}" />
                                                :
                                                <t t-esc="doc.discount_amount" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                                                
                                            </t>
                                        </div>
                                    </t>
                                        <t t-if="doc.invoice_payment_term_id and 'Banklastschrift' not in doc.invoice_payment_term_id.name">
                                        <div style="font-size:14px;">
                                            
                                            Bei Zahlung bis
                                            <t t-if="doc.invoice_date_due and doc.amount_total">
                                                <t t-esc="doc.invoice_date_due" t-options="{'widget': 'date' , 'format': 'dd.MM.yyyy'}"/>
                                                :
                                                <t t-esc="doc.amount_total" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                                                
                                            </t>
                                        </div>
                                    </t>
                                    <t t-if="doc.invoice_payment_term_id and 'Banklastschrift' in doc.invoice_payment_term_id.name">
                    
                                        <div style="font-size:14px;">
                                            <t t-esc="doc.invoice_payment_term_id.note"/>
                                        </div>
                                    </t>
                                -->
                                    <!--<div style="font-size:14px;">-->
                                    <!--    Fälligkeitsdatum:-->
                                    <!--    <t t-esc="doc.invoice_date_due" t-options="{'widget': 'date' , 'format': 'dd.MM.yyyy'}"/>-->
                                        
                                    <!--</div>-->
                                </td>
                        
                        
                                <td style="width:40%; vertical-align:top; padding-left:10mm;">
                                    <table style="width:100%; border-collapse:collapse; font-size:12px;">
                                        
                                        <t t-if="not doc.hide_total">
                                            <tr style="font-size:14px;">
                                                <td style="text-align:left;">Nettobetrag:</td>
                                                <td style="text-align:right;">
                                                    <t t-esc="doc.amount_untaxed" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                                                </td>
                                            </tr>
                            
                            
                                            <tr style="font-size:14px;">
                                                <td style="text-align:left;">Steuern:</td>
                                                <td style="text-align:right;">
                                                    <t t-esc="doc.amount_tax" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                                                </td>
                                            </tr>
                            
                            
                                            <tr style="font-weight:bold; font-size:14px;">
                                                <td style="text-align:left;">Bruttobetrag:</td>
                                                <td style="text-align:right;">
                                                    <t t-esc="doc.amount_total" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                                                </td>
                                            </tr>
                                        </t>
                                        
                        
                                    </table>
                                </td>
                        
                            </tr>
                        </table>
                        <!--<br/>-->
                        <!--<div style="font-size:14px;text-align:center;width:100%">-->
                        <!--    <t t-if="doc.invoice_payment_term_id">-->
                        <!--        <t t-if="doc.invoice_payment_term_id.display_on_invoice">-->
                        <!--            <div>-->
                        <!--                <t t-esc="doc.invoice_payment_term_id.note"/>-->
                        <!--            </div>-->
                        <!--            <div>-->
                        <!--                <t t-esc="doc.invoice_payment_term_id.example_preview_discount"/>-->
                                    
                        <!--                <t t-esc="doc.invoice_payment_term_id.example_preview"/>-->
                        <!--            </div>-->
                                    
                                    
                        <!--        </t>-->
                        <!--    </t>-->
                        <!--</div>-->
                        <!-- <br/> -->
                        <!-- <div style="font-size:14px;font-weight:bold;text-align:left;">
                            <t t-if="doc.partner_id.country_id.name != 'Deutschland' and doc.partner_id.country_id.name != 'Germany'">
                                *** Reverse Charge ***
                                
                            </t>
                        </div> -->


                
                    </div>
                </main>

            
            
                </t>
            </t> 
        </xpath>

    </template>
</odoo>
