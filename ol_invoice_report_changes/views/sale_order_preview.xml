<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_order_preview_inherit" inherit_id="sale_subscription.subscription_portal_content">
        <xpath expr="//div[@id='sale_info']/table/tbody/tr[4]" position="replace">
            <tr t-if="sale_order.client_order_ref or sale_order.subscription_id.name">
                <th class="ps-0 pb-0">Reference:</th>
                <td class="w-100 pb-0" style="white-space:normal;word-wrap: break-word; word-break: break-word; vertical-align:top;"><em t-out="sale_order.client_order_ref or sale_order.subscription_id.name"/></td>
            </tr>
        </xpath>
            
        
    </template>
</odoo>