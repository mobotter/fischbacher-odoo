<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_order_preview_inherit" inherit_id="sale.sale_order_portal_content">
        <!-- Odoo 19 sucht nach dem div mit id="informations". 
             Wir fügen die Referenz am Ende dieses Informations-Blocks ein -->
        <xpath expr="//div[@id='informations']" position="inside">
            
            <div t-if="sale_order.client_order_ref or sale_order.subscription_id.name" class="row mb-3">
                <div class="col-12">
                    <strong>Reference:</strong>
                    <br/>
                    <span class="text-muted" style="white-space:normal; word-wrap:break-word; word-break:break-word;">
                        <t t-out="sale_order.client_order_ref or sale_order.subscription_id.name"/>
                    </span>
                </div>
            </div>
            
        </xpath>
    </template>
</odoo>
