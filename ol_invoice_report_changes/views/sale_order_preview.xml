<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_order_preview_inherit" inherit_id="sale_subscription.subscription_portal_content">
        <!-- Odoo 19 sucht nach den konkreten Referenz-Elementen anstatt starren tr[4] Strukturen -->
        <xpath expr="//div[@id='sale_info']//strong[contains(text(), 'Reference')]/../.." position="replace">
            <div t-if="sale_order.client_order_ref" class="mb-2">
                <strong class="d-block mb-1">Reference:</strong>
                <span style="white-space:normal;word-wrap: break-word; word-break: break-word; vertical-align:top;" t-out="sale_order.client_order_ref"/>
            </div>
        </xpath>
    </template>
</odoo>
