<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Shared external layout for Odoo PDF reports.
        Adds the Fischbacher company header and a unified footer
        with company details and page numbering.
    -->
    <template id="external_layout_for_invoice">
        <t t-set="company" t-value="env.company"/>
        <t t-call="web.html_container">
            <head>
                <meta charset="utf-8"/>
                <style>
                    /* Rahmen vom Odoo-Layout entfernen */
                    .article,
                    .article .page,
                    .page {
                        border: none !important;
                        box-shadow: none !important;
                        outline: none !important;
                    }

                    .page table,
                    .page tr,
                    .page td,
                    .page th {
                        border: 0 !important;
                        border-width: 0 !important;
                        border-style: none !important;
                        border-color: transparent !important;
                        border-collapse: collapse !important;
                        box-shadow: none !important;
                        outline: none !important;
                    }

                    .page table {
                        border-spacing: 0 !important;
                        background: transparent !important;
                    }

                    .page pre {
                        border: 0 !important;
                        border-style: none !important;
                        background: transparent !important;
                        margin: 0 !important;
                        padding: 0 !important;
                        white-space: pre-wrap;
                    }

                    .page .head-bottom th {
                        border-bottom: 1px solid #ccc !important;
                    }

                    .page .line-bottom td,
                    .page .line-bottom th {
                        border-bottom: 1px solid #e0e0e0 !important;
                    }
                </style>
            </head>

            <div class="header">
                <table class="company_header table-borderless" style="width:100%;">
                    <tr>
                        <td style="text-align:right;">
                            <img t-if="company.logo"
                                 t-att-src="image_data_uri(company.logo)"
                                 style="height:80px;"/>
                        </td>
                    </tr>
                </table>
            </div>

            <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id">
                <div class="page">
                    <t t-out="0"/>
                </div>
            </div>

            <div class="footer table-borderless mt-2" style="width:100%; font-size:12px; padding-top:0; text-align:left;">
                <div style="text-align:left; font-size:10.5px; margin-bottom:6px;">
                    Kommanditgesellschaft · Sitz München, HRA 116761 ·
                    Persönlich haftende Gesellschafterin: Fischbacher GmbH · Sitz München · HRB 278787<br/>
                    USt-Id. DE355684446 · St-Nr. 143/518/60562 ·
                    Geschäftsführer: Dipl.-Ing. Marcus Mayr, Dipl.-Ing. (FH) Moritz Zwez
                </div>

                <table style="width:100%; border-collapse:collapse;">
                    <tr style="border:none;">
                        <td style="width:33%; vertical-align:top; border:none; padding:0;">
                            Fischbacher GmbH + Co. KG<br/>
                            Dessauerstr. 9<br/>
                            80992 München
                        </td>
                        <td style="width:33%; vertical-align:top; border:none; padding:0;">
                            <strong style="display:inline-block; width:60px; color:#1f6fd2;">Telefon</strong>089 / 14 99 08-0<br/>
                            <strong style="display:inline-block; width:60px; color:#1f6fd2;">Internet</strong>www.fischbacher.de<br/>
                            <strong style="display:inline-block; width:60px; color:#1f6fd2;">E-Mail</strong>info@fischbacher.de
                        </td>
                        <td style="width:33%; vertical-align:top; border:none; padding:0;">
                            <strong style="display:inline-block; width:40px; color:#1f6fd2;">Bank</strong>VR-Bank Fürstenfeldbruck<br/>
                            <strong style="display:inline-block; width:40px; color:#1f6fd2;">IBAN</strong>DE83 7016 3370 0000 3132 54<br/>
                            <strong style="display:inline-block; width:40px; color:#1f6fd2;">BIC</strong>GENODEF1FFB
                        </td>
                    </tr>
                </table>

                <div style="text-align:center; font-weight:bold; margin-top:8px;">
                    Seite <span class="page"/> / <span class="topage"/>
                </div>
            </div>
        </t>
    </template>

