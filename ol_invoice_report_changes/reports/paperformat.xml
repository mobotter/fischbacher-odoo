<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_invoice_custom_paperformat"
            model="report.paperformat">

        <field name="name">Invoice DIN 5008 – Fischbacher</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>

        <!-- Allgemeine Text-/Inhaltskante -->
        <field name="margin_left" eval="20"/>
        <field name="margin_right" eval="15"/>

        <!-- Oberer und unterer Schutzbereich -->
        <field name="margin_top" eval="40"/>
        <field name="margin_bottom" eval="30"/>

        <!-- Kein zusätzlicher künstlicher Header-Abstand -->
        <field name="header_spacing">25</field>

        <field name="dpi" eval="90"/>
    </record>
</odoo>
