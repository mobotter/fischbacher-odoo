<?xml version="1.0" encoding="utf-8" ?>
<odoo>

     <record id="paperformat_product_barcode" model="report.paperformat">
        <field name="name">Product Barcode Reports</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_height">30</field>
        <field name="page_width">80</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
        <field name="disable_shrinking" eval="False"/>
    </record>


    <record id="action_product_barcode_report" model="ir.actions.report">
        <field name="name">Miet-Aufkleber</field>
        <field name="model">product.product</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">product_report.report_barcode_label</field>
        <field name="report_file">product_report.report_barcode_label</field>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="paperformat_id" ref="product_report.paperformat_product_barcode"/> 
        <field name="binding_type">report</field>
    </record>

</odoo>
