<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="report_barcode_label" name="Barcode Label Report">
        <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <div style="border: 1px solid black; padding: 5px; ">
                        <div style="font-weight:bold; font-size:15px;"> 
                            <span t-esc="doc.default_code"/>
                        </div>
                        <div style="font-weight:lighter; font-size:12px; margin-top:5px;">
                            <span t-esc="doc.name"/>
                        </div>
                        <div>
                            <span t-field="doc.barcode" class="barcode" t-options="{'widget': 'barcode', 'width': 250, 'height': 20, 'quiet': 0, }"/>
                        </div>
                        <div style="font-size:12px;">
                            <span t-field="doc.barcode"/>
                        </div>
                    </div>
                </t>
        </t>

    </template>
</odoo>