<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_fb_fixed_putaway_wizard" model="ir.ui.view">
        <field name="name">fb.fixed.putaway.wizard.form</field>
        <field name="model">fb.fixed.putaway.wizard</field>
        <field name="arch" type="xml">
            <form string="Feste Einlagerungsregeln">
                <header>
                    <button name="action_preview"
                            type="object"
                            string="Vorschau laden"
                            class="btn-secondary"/>
                    <button name="action_apply_selected"
                            type="object"
                            string="Markierte Regeln erstellen"
                            class="btn-primary"/>
                </header>

                <sheet>
                    <group>
                        <field name="location_in_id"/>
                        <field name="product_id"/>
                    </group>

                    <group string="Übersicht">
                        <field name="new_proposal_count" readonly="1"/>
                    </group>

                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="apply"/>
                            <field name="product_id" readonly="1"/>
                            <field name="total_qty" readonly="1"/>
                            <field name="suggested_location_count" readonly="1"/>
                            <field name="status" readonly="1"/>
                            <field name="location_id"/>
                            <field name="note" readonly="1"/>
                            <button name="action_apply"
                                    type="object"
                                    string="Regel erstellen"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fb_fixed_putaway" model="ir.actions.act_window">
        <field name="name">Feste Einlagerungsregeln</field>
        <field name="res_model">fb.fixed.putaway.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_fb_fixed_putaway"
              name="Feste Einlagerungsregeln"
              parent="stock.menu_stock_config_settings"
              action="action_fb_fixed_putaway"
              groups="stock.group_stock_manager"
              sequence="80"/>

    <record id="view_product_fixed_putaway_button" model="ir.ui.view">
        <field name="name">product.template.fb.fixed.putaway.button</field>
        <field name="model">product.template</field>
        <field name="inherit_id"
               ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Fester Einlagerungsplatz"
                       groups="stock.group_stock_manager">
                    <button name="action_fb_open_fixed_putaway"
                            type="object"
                            string="Einlagerungsregel vorbereiten"
                            class="btn-secondary"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
