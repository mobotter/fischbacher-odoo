<odoo>
    <record id="job_list" model="ir.ui.view">
        <field name="name">history.import.job.list</field>
        <field name="model">product.history.import.job</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="filename"/>
                <field name="state"/>
                <field name="processed"/>
                <field name="created_count"/>
                <field name="error_count"/>
            </list>
        </field>
    </record>
    <record id="job_form" model="ir.ui.view">
        <field name="name">history.import.job.form</field>
        <field name="model">product.history.import.job</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Import starten" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_pause" type="object" string="Pausieren" invisible="state not in ['queued', 'running']"/>
                    <button name="action_resume" type="object" string="Fortsetzen" invisible="state not in ['paused', 'failed']"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="status">
                        Jede gültige CSV-Zeile erzeugt einen neuen Eintrag.
                        Ein neuer Auftrag mit derselben Datei legt alle Zeilen erneut an.
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="filename" readonly="state != 'draft'"/>
                        <field name="file_data" filename="filename" readonly="state != 'draft'"/>
                        <field name="source" readonly="state != 'draft'"/>
                        <field name="delimiter" readonly="state != 'draft'"/>
                        <field name="batch_size"/>
                    </group>
                    <group>
                        <field name="processed"/>
                        <field name="created_count"/>
                        <field name="error_count"/>
                        <field name="started_at"/>
                        <field name="finished_at"/>
                        <field name="last_error"/>
                    </group>
                    <notebook>
                        <page string="Fehlerprotokoll">
                            <field name="error_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="line_number"/>
                                    <field name="message"/>
                                    <field name="original"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_jobs" model="ir.actions.act_window">
        <field name="name">Abwertungstabellen importieren</field>
        <field name="res_model">product.history.import.job</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_jobs" name="Großimport" parent="inventory_history_menu" action="action_jobs" groups="base.group_system"/>
    <record id="error_list" model="ir.ui.view">
        <field name="name">history.import.error.list</field>
        <field name="model">product.history.import.error</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="job_id"/>
                <field name="line_number"/>
                <field name="message"/>
                <field name="original"/>
            </list>
        </field>
    </record>
    <record id="action_errors" model="ir.actions.act_window">
        <field name="name">Importfehler</field>
        <field name="res_model">product.history.import.error</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="menu_errors" name="Importfehler" parent="inventory_history_menu" action="action_errors" groups="base.group_system"/>
</odoo>
