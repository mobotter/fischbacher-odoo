<odoo>
    <record id="product_template_history_form" model="ir.ui.view">
        <field name="name">product.template.inventory.history</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="template_inventory_history" string="Abwertungstabellen">
                    <button name="%(action_jobs)d" type="action" string="Excel/CSV-Großimport" class="oe_highlight" groups="base.group_system"/>
                    <field name="inventory_history_ids" context="{'default_product_tmpl_id': id}">
                        <list editable="bottom">
                            <field name="currency_id" column_invisible="True"/>
                            <field name="product_tmpl_id" column_invisible="True"/>
                            <field name="product_id" domain="[('product_tmpl_id', '=', parent.id)]" optional="hide"/>
                            <field name="date"/>
                            <field name="warehouse"/>
                            <field name="quantity"/>
                            <field name="purchase_price"/>
                            <field name="value"/>
                            <field name="base_purchase_price"/>
                            <field name="total_value"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="product_variant_history_form" model="ir.ui.view">
        <field name="name">product.product.inventory.history</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="variant_inventory_history" string="Abwertungstabellen">
                    <button name="%(action_jobs)d" type="action" string="Excel/CSV-Großimport" class="oe_highlight" groups="base.group_system"/>
                    <field name="variant_inventory_history_ids" context="{'default_product_id': id, 'default_product_tmpl_id': product_tmpl_id}">
                        <list editable="bottom">
                            <field name="currency_id" column_invisible="True"/>
                            <field name="product_tmpl_id" column_invisible="True"/>
                            <field name="product_id" column_invisible="True"/>
                            <field name="date"/>
                            <field name="warehouse"/>
                            <field name="quantity"/>
                            <field name="purchase_price"/>
                            <field name="value"/>
                            <field name="base_purchase_price"/>
                            <field name="total_value"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
