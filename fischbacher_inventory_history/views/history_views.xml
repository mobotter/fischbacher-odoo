<odoo>
    <record id="inventory_history_list" model="ir.ui.view">
        <field name="name">product.inventory.history.list</field>
        <field name="model">product.inventory.history</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="currency_id" column_invisible="True"/>
                <field name="product_tmpl_id"/>
                <field name="product_id" domain="[('product_tmpl_id', '=', product_tmpl_id)]"/>
                <field name="date"/>
                <field name="warehouse"/>
                <field name="quantity"/>
                <field name="purchase_price"/>
                <field name="value"/>
                <field name="base_purchase_price"/>
                <field name="total_value"/>
                <field name="legacy_article_number" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="inventory_history_form" model="ir.ui.view">
        <field name="name">product.inventory.history.form</field>
        <field name="model">product.inventory.history</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="currency_id" invisible="True"/>
                        <field name="product_tmpl_id"/>
                        <field name="product_id" domain="[('product_tmpl_id', '=', product_tmpl_id)]"/>
                        <field name="date"/>
                        <field name="warehouse"/>
                        <field name="quantity"/>
                        <field name="purchase_price"/>
                        <field name="value"/>
                        <field name="base_purchase_price"/>
                        <field name="total_value"/>
                        <field name="legacy_article_number"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="inventory_history_action" model="ir.actions.act_window">
        <field name="name">Abwertungstabellen</field>
        <field name="res_model">product.inventory.history</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="inventory_history_menu" name="Abwertungstabellen" action="inventory_history_action" groups="base.group_user"/>
</odoo>
