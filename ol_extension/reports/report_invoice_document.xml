<odoo>
    <template id="report_invoice_document_inherit"
        inherit_id="l10n_din5008.report_invoice_document">
        <!-- TASK ID: 52132 -->
        <xpath position="before" expr="//div[@class='information_block']">
            <br />
        </xpath>
        <!-- TASK ID: 52132 -->
        <!-- TASK ID: 51580 -->
        <xpath position="replace" expr="//t[@t-set='din5008_address_block']">
            <t t-set="din5008_address_block">
                <t t-if="o and o._name=='account.move'">
                    <t t-set="commercial_partner" t-value="o.commercial_partner_id" />
                    <t t-set="invoice_partner" t-value="o.partner_id" />
                    <t t-set="delivery_partner"
                        t-value="o.line_ids.sale_line_ids.order_id.delivery_address" />
                    <t t-set="different_partner_count"
                        t-value="len({partner.id for partner in [o.partner_id.commercial_partner_id, o.partner_id, o.partner_shipping_id] if partner})" />
                    <tr t-if="different_partner_count &gt; 1">
                        <t
                            t-if="o.partner_shipping_id and o.partner_shipping_id != commercial_partner">
                            <td class="shipping_address">
                                <span class="fw-bold">Shipping Address:</span>
                                <t t-if="delivery_partner">

                                    <div t-field="doc.delivery_address" t-options="{'widget': 'text'}" />
                                </t>
                                <t t-else="">
                                    <address t-esc="o.partner_shipping_id"
                                        t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True}" />
                                </t>
                            </td>
                        </t>
                        <t t-if="invoice_partner and invoice_partner != commercial_partner">
                            <td class="shipping_address">
                                <span class="fw-bold">Beneficiary:</span>
                                <address class="mb-0" t-esc="o.commercial_partner_id"
                                    t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True}" />
                                <div t-if="o.commercial_partner_id.vat">
                                    <t
                                        t-if="o.commercial_partner_id.company_id.account_fiscal_country_id.vat_label"
                                        t-out="o.commercial_partner_id.company_id.account_fiscal_country_id.vat_label"
                                        id="inv_tax_id_label" />
                                        <t t-else="">Tax ID</t>: <span
                                        t-field="o.commercial_partner_id.vat" />
                                </div>
                            </td>
                        </t>
                    </tr>
                </t>
            </t>
        </xpath>
        <!-- TASK ID: 51580 -->
    </template>
</odoo>
