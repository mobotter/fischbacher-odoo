<odoo>
    <template id="report_saleorder_document_inherit"
        inherit_id="l10n_din5008_sale.report_saleorder_document">
        <!-- TASK ID: 51580 -->
        <xpath position="replace" expr="//t[@t-set='din5008_address_block']">
            <t t-set="din5008_address_block">
                <tr t-if="doc and doc._name=='sale.order'">
                    <t t-set="commercial_partner" t-value="doc.partner_id.commercial_partner_id" />
                    <t t-set="invoice_partner" t-value="doc.partner_invoice_id" />
                    <t t-set="delivery_partner" t-value="doc.delivery_address" />

                    <t t-if="doc.env.context.get('proforma')">
                        <td class="shipping_address"
                            t-if="doc.partner_shipping_id and doc.partner_shipping_id != commercial_partner">
                            <span class="fw-bold">Shipping Address:</span>
                            <t t-if="delivery_partner">
                                <div t-raw="delivery_partner.replace('\n', '&lt;br/&gt;')" />
                            </t>
                            <t t-else="">
                                <address t-esc="doc.partner_shipping_id"
                                    t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True}" />
                            </t>
                        </td>
                        <td class="shipping_address"
                            t-if="invoice_partner and invoice_partner != commercial_partner">
                            <span class="fw-bold">Beneficiary:</span>
                            <address class="mb-0" t-esc="commercial_partner"
                                t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True}" />
                            <div t-if="commercial_partner.vat">
                                <t
                                    t-if="commercial_partner.company_id.account_fiscal_country_id.vat_label"
                                    t-out="commercial_partner.company_id.account_fiscal_country_id.vat_label"
                                    id="inv_tax_id_label" />
                                <t t-else="">Tax ID</t>: <span
                                    t-field="commercial_partner.vat" />
                            </div>
                        </td>
                    </t>
                    <t t-else="">
                        <t t-if="doc.partner_invoice_id == doc.partner_shipping_id">
                            <td class="shipping_address">
                                <span class="fw-bold">Invoicing and Shipping Address:</span>
                                <t t-if="delivery_partner">

                                    <div t-raw="delivery_partner.replace('\n', '&lt;br/&gt;')" />
                                </t>
                                <t t-else="">
                                    <address t-esc="doc.partner_shipping_id"
                                        t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True}" />
                                </t>
                            </td>
                        </t>
                        <t t-else="">
                            <td class="shipping_address">
                                <span class="fw-bold">Shipping Address:</span>
                                <t t-if="delivery_partner">
                                    <div t-raw="delivery_partner.replace('\n', '&lt;br/&gt;')" />
                                </t>
                                <t t-else="">
                                    <address t-esc="doc.partner_shipping_id"
                                        t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True}" />
                                </t>
                            </td>
                            <td class="shipping_address">
                                <span class="fw-bold">Invoicing Address:</span>
                                <address t-esc="doc.partner_invoice_id"
                                    t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True}" />
                            </td>
                        </t>
                    </t>
                </tr>
            </t>
        </xpath>
        <!-- TASK ID: 51580 -->
    </template>
</odoo>
