<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Task ID: 51016 -->
    <record id="view_client_info_list" model="ir.ui.view">
        <field name="name">client.info.list</field>
        <field name="model">client.info</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="pos" />
                <field name="info" />
            </list>
        </field>
    </record>

    <record id="view_client_info_form" model="ir.ui.view">
        <field name="name">client.info.form</field>
        <field name="model">client.info</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="pos" />
                        <field name="info" />
                        <field name="partner_id" invisible="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Task ID: 51016 -->
</odoo>