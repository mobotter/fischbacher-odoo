<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_woo_sync" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.woo.sync</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="WooCommerce Sync" name="fischbacher_woo_sync">
                    <block title="WooCommerce-Verbindung">
                        <setting string="Shop-URL">
                            <field name="fischbacher_woo_base_url"/>
                        </setting>
                        <setting string="Consumer Key">
                            <field name="fischbacher_woo_consumer_key"
                                   password="True"/>
                        </setting>
                        <setting string="Consumer Secret">
                            <field name="fischbacher_woo_consumer_secret"
                                   password="True"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
