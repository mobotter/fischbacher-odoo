<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Erweitert das sale.order-Formular:
        Fügt dem partner_id-Feld den Kontext show_ref_prefix=True hinzu,
        damit name_get() 'ref - name' zurückgibt.
        Zusätzlich wird die Suche auf ref ausgeweitet.
    -->
    <record id="view_order_form_partner_ref" model="ir.ui.view">
        <field name="name">sale.order.form.partner.ref</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="context">
                    {
                        'display_website': True,
                        'res_partner_search_mode': 'customer',
                        'show_address': 1,
                        'show_vat': True,
                        'show_ref_prefix': True,
                    }
                </attribute>
            </xpath>
        </field>
    </record>

    <!-- Produktanzeige in Auftragspositionen anpassen -->
    <record id="view_order_form_product_display" model="ir.ui.view">
        <field name="name">sale.order.form.product.display</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree//field[@name='product_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
