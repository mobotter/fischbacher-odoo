<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Verkaufsauftrag: Kundenanzeige und Kundendomäne -->
    <record id="view_order_form_partner_ref" model="ir.ui.view">
        <field name="name">sale.order.form.partner.ref</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">
                    [('active', '=', True), ('parent_id', '=', False), ('sale_blocked', '=', False)]
                </attribute>
                <attribute name="context">
                    {
                        'display_website': True,
                        'show_address': 1,
                        'show_vat': True,
                        'show_ref_prefix': True
                    }
                </attribute>
            </xpath>
        </field>
    </record>

    <!-- Verkaufsauftrag: Sichtbares Produkt-Suchfeld -->
    <record id="view_order_form_product_display" model="ir.ui.view">
        <field name="name">sale.order.form.product.display</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Odoo Sales verwendet für die Produktsuche product_template_id -->
            <xpath expr="//field[@name='order_line']//field[@name='product_template_id']" position="attributes">
                <!-- Bestehende Modul-Logik beibehalten -->
                <attribute name="context">{'forbid_quick_create_product': True}</attribute>

                <!-- Bestehendes Sales-Produktwidget ausdrücklich erhalten -->
                <attribute name="widget">sol_product_many2one</attribute>

                <!-- Keine Anlage eines neuen Produkttemplates über die Auftragsposition -->
                <attribute name="can_create">false</attribute>

                <!-- Quick Create und „Erstellen und bearbeiten …“ sperren -->
                <attribute name="options">
                    {
                        'no_create': True,
                        'no_quick_create': True,
                        'no_create_edit': True
                    }
                </attribute>
            </xpath>

            <!-- Zusätzliche Absicherung für Felder/Unteransichten, die product_id verwenden -->
            <xpath expr="//field[@name='order_line']//field[@name='product_id']" position="attributes">
                <attribute name="context">{'forbid_quick_create_product': True}</attribute>
                <attribute name="can_create">false</attribute>
                <attribute name="options">
                    {
                        'no_create': True,
                        'no_quick_create': True,
                        'no_create_edit': True
                    }
                </attribute>
            </xpath>

        </field>
    </record>

    <!-- Abonnement: Kundenanzeige und Kundendomäne -->
    <record id="view_subscription_form_partner_ref" model="ir.ui.view">
        <field name="name">sale.subscription.form.partner.ref</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_order_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">
                    [('active', '=', True), ('parent_id', '=', False), ('sale_blocked', '=', False)]
                </attribute>
                <attribute name="context">
                    {
                        'display_website': True,
                        'show_address': 1,
                        'show_vat': True,
                        'show_ref_prefix': True
                    }
                </attribute>
            </xpath>
        </field>
    </record>

    <!-- Abonnement: Produkt auswählen, aber nicht neu anlegen -->
    <record id="view_subscription_form_product_display" model="ir.ui.view">
        <field name="name">sale.subscription.form.product.display</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_order_view_form"/>
        <field name="arch" type="xml">

            <!-- Primäres Produktsuchfeld in der Subscription-Auftragszeile -->
            <xpath expr="//field[@name='order_line']//field[@name='product_template_id']" position="attributes">
                <attribute name="context">{'forbid_quick_create_product': True}</attribute>
                <attribute name="widget">sol_product_many2one</attribute>
                <attribute name="can_create">false</attribute>
                <attribute name="options">
                    {
                        'no_create': True,
                        'no_quick_create': True,
                        'no_create_edit': True
                    }
                </attribute>
            </xpath>

            <!-- Zusätzliche Absicherung, falls die Subscriptions-View product_id rendert -->
            <xpath expr="//field[@name='order_line']//field[@name='product_id']" position="attributes">
                <attribute name="context">{'forbid_quick_create_product': True}</attribute>
                <attribute name="can_create">false</attribute>
                <attribute name="options">
                    {
                        'no_create': True,
                        'no_quick_create': True,
                        'no_create_edit': True
                    }
                </attribute>
            </xpath>

        </field>
    </record>

</odoo>
