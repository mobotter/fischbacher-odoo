<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_partner_ref" model="ir.ui.view">
        <field name="name">sale.order.form.partner.ref</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="context">
                    {
                        'display_website': True,
                        'show_address': 1,
                        'show_vat': True,
                        'show_ref_prefix': True
                    }
                </attribute>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_product_display" model="ir.ui.view">
        <field name="name">sale.order.form.product.display</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//field[@name='product_id']" position="attributes">
                <attribute name="context">{'forbid_quick_create_product': True}</attribute>
                <attribute name="options">{'no_quick_create': True, 'no_create_edit': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='product_template_id']" position="attributes">
                <attribute name="context">{'forbid_quick_create_product': True}</attribute>
                <attribute name="options">{'no_quick_create': True, 'no_create_edit': True}</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_subscription_form_partner_ref" model="ir.ui.view">
        <field name="name">sale.subscription.form.partner.ref</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_order_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="context">
                    {
                        'display_website': True,
                        'res_partner_search_mode': 'customer',
                        'show_address': 1,
                        'show_vat': True,
                        'show_ref_prefix': True
                    }
                </attribute>
            </xpath>
        </field>
    </record>

    <record id="view_subscription_form_product_display" model="ir.ui.view">
        <field name="name">sale.subscription.form.product.display</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_order_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//field[@name='product_id']" position="attributes">
                <attribute name="context">{'forbid_quick_create_product': True}</attribute>
                <attribute name="options">{'no_quick_create': True, 'no_create_edit': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='product_template_id']" position="attributes">
                <attribute name="context">{'forbid_quick_create_product': True}</attribute>
                <attribute name="options">{'no_quick_create': True, 'no_create_edit': True}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
