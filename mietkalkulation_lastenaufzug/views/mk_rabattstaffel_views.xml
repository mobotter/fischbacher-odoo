<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mk_rabattstaffel_view_tree" model="ir.ui.view">
        <field name="name">mk.rabattstaffel.tree</field>
        <field name="model">mk.rabattstaffel</field>
        <field name="arch" type="xml">
            <list string="Rabattstaffeln" editable="bottom">
                <field name="monate_ab"/>
                <field name="rabatt_prozent"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <record id="mk_rabattstaffel_view_form" model="ir.ui.view">
        <field name="name">mk.rabattstaffel.form</field>
        <field name="model">mk.rabattstaffel</field>
        <field name="arch" type="xml">
            <form string="Rabattstaffel">
                <sheet>
                    <group>
                        <field name="monate_ab"/>
                        <field name="rabatt_prozent"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mk_rabattstaffel_action" model="ir.actions.act_window">
        <field name="name">Rabattstaffeln</field>
        <field name="res_model">mk.rabattstaffel</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="mk_menu_rabattstaffel"
        name="Rabattstaffeln"
        parent="sale_subscription.menu_sale_subscription_root"
        action="mk_rabattstaffel_action"
        sequence="86"/>
</odoo>
