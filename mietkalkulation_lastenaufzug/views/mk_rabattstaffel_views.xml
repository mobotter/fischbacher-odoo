<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mk_rabattstaffel_view_tree" model="ir.ui.view">
        <field name="name">mk.rabattstaffel.tree</field>
        <field name="model">mk.rabattstaffel</field>
        <field name="arch" type="xml">
            <list string="Rabattstaffeln" editable="bottom">
                <field name="monate_ab"/>
                <field name="rabatt_prozent"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <record id="mk_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mietkalkulation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Mietkalkulation" name="mietkalkulation_lastenaufzug">
                    <block title="Mietkalkulation">
                        <setting string="Basis-Höhe inkl. Grundgerät (m)">
                            <field name="mk_basis_hoehe_grundgeraet"/>
                        </setting>
                        <setting string="Schrittweite Mehrhöhe (m)">
                            <field name="mk_schrittweite_mehrhoehe"/>
                        </setting>
                        <setting string="Maschinenbruchversicherung (%)">
                            <field name="mk_maschinenbruch_prozent"/>
                        </setting>
                    </block>
                    <block title="Rabattstaffeln">
                        <setting string="Rabattstaffeln nach Mietdauer">
                            <field name="mk_rabattstaffel_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="monate_ab"/>
                                    <field name="rabatt_prozent"/>
                                    <field name="active" optional="show"/>
                                </list>
                            </field>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="mk_rabattstaffel_action_settings" model="ir.actions.act_window">
        <field name="name">Rabattstaffeln</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'mietkalkulation_lastenaufzug'}</field>
    </record>

    <menuitem id="mk_menu_rabattstaffel"
        name="Rabattstaffeln"
        parent="sale_subscription.menu_sale_subscription_config"
        action="mk_rabattstaffel_action_settings"
        sequence="20"/>
</odoo>
