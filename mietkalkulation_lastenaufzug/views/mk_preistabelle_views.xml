<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mk_preistabelle_view_tree" model="ir.ui.view">
        <field name="name">mk.preistabelle.tree</field>
        <field name="model">mk.preistabelle</field>
        <field name="arch" type="xml">
            <list string="Mietpreisliste" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="traglast"/>
                <field name="grundpreis" widget="monetary"/>
                <field name="mehrpreis_hoehe" widget="monetary"/>
                <field name="mehrpreis_station" widget="monetary"/>
                <field name="mehrpreis_buehne_145" widget="monetary"/>
                <field name="mehrpreis_buehne_165" widget="monetary"/>
                <field name="mehrpreis_person" widget="monetary"/>
                <field name="std_je_5m"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <record id="mk_preistabelle_view_tree_readonly" model="ir.ui.view">
        <field name="name">mk.preistabelle.tree.readonly</field>
        <field name="model">mk.preistabelle</field>
        <field name="arch" type="xml">
            <list string="Mietpreisliste" create="0" edit="0" delete="0">
                <field name="traglast"/>
                <field name="grundpreis" widget="monetary"/>
                <field name="mehrpreis_hoehe" widget="monetary"/>
                <field name="mehrpreis_station" widget="monetary"/>
                <field name="mehrpreis_buehne_145" widget="monetary"/>
                <field name="mehrpreis_buehne_165" widget="monetary"/>
                <field name="mehrpreis_person" widget="monetary"/>
            </list>
        </field>
    </record>

    <record id="mk_preistabelle_view_form" model="ir.ui.view">
        <field name="name">mk.preistabelle.form</field>
        <field name="model">mk.preistabelle</field>
        <field name="arch" type="xml">
            <form string="Preiseintrag">
                <sheet>
                    <group>
                        <group string="Traglastklasse">
                            <field name="traglast"/>
                            <field name="std_je_5m"/>
                            <field name="active"/>
                        </group>
                        <group string="Mietpreise (pro 4 Wochen)">
                            <field name="grundpreis" widget="monetary"/>
                            <field name="mehrpreis_hoehe" widget="monetary"/>
                            <field name="mehrpreis_station" widget="monetary"/>
                        </group>
                    </group>
                    <group string="B├╝hnen- und Personenzuschl├Ąge">
                        <group>
                            <field name="mehrpreis_buehne_145" widget="monetary"/>
                            <field name="mehrpreis_buehne_165" widget="monetary"/>
                        </group>
                        <group>
                            <field name="mehrpreis_person" widget="monetary"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mk_preistabelle_action" model="ir.actions.act_window">
        <field name="name">Mietpreistabelle</field>
        <field name="res_model">mk.preistabelle</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Noch keine Preise hinterlegt.</p>
            <p>Legen Sie hier die Mietpreise je Traglastklasse an.</p>
        </field>
    </record>

    <menuitem

    <menuitem
        id="mk_menu_preistabelle"
        name="Mietpreistabelle"
        parent="sale_subscription.menu_sale_subscription_config"
        action="mk_preistabelle_action"
        sequence="10"/>

</odoo>
