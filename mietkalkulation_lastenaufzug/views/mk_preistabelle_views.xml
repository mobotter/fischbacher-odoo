<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Konfiguration: editierbare Mietpreistabelle -->
    <record id="mk_preistabelle_view_tree" model="ir.ui.view">
        <field name="name">mk.preistabelle.list</field>
        <field name="model">mk.preistabelle</field>
        <field name="arch" type="xml">
            <list string="Mietpreistabelle" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name" string="Aufzug"/>
                <field name="beschreibung"/>
                <field name="grundpreis"/>
                <field name="mehrpreis_hoehe"/>
                <field name="mehrpreis_station"/>
                <field name="mehrpreis_buehne_145"/>
                <field name="mehrpreis_buehne_165"/>
                <field name="mehrpreis_person"/>
                <field name="std_je_5m"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Ausschließlich lesbare Ansicht im Abonnement-Auftrag -->
    <record id="mk_preistabelle_view_tree_readonly" model="ir.ui.view">
        <field name="name">mk.preistabelle.list.readonly</field>
        <field name="model">mk.preistabelle</field>
        <field name="arch" type="xml">
            <list string="Mietpreistabelle"
                  create="0"
                  edit="0"
                  delete="0">
                <field name="name" string="Aufzug"/>
                <field name="beschreibung"/>
                <field name="grundpreis"/>
                <field name="mehrpreis_hoehe"/>
                <field name="mehrpreis_station"/>
                <field name="mehrpreis_buehne_145"/>
                <field name="mehrpreis_buehne_165"/>
                <field name="mehrpreis_person"/>
                <field name="std_je_5m" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Einzelansicht eines Preiseintrags -->
    <record id="mk_preistabelle_view_form" model="ir.ui.view">
        <field name="name">mk.preistabelle.form</field>
        <field name="model">mk.preistabelle</field>
        <field name="arch" type="xml">
            <form string="Mietpreiseintrag">
                <sheet>
                    <group>
                        <group string="Aufzug / Preiszeile">
                            <field name="name"
                                   string="Aufzug"
                                   placeholder="z. B. Lastenaufzug 500 kg"/>
                            <field name="beschreibung"
                                   placeholder="Optionale Zusatzbeschreibung"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>

                        <group string="Mietpreise pro 4 Wochen">
                            <field name="grundpreis"/>
                            <field name="mehrpreis_hoehe"/>
                            <field name="mehrpreis_station"/>
                        </group>
                    </group>

                    <group string="Bühnen- und Personenzuschläge">
                        <group>
                            <field name="mehrpreis_buehne_145"/>
                            <field name="mehrpreis_buehne_165"/>
                        </group>
                        <group>
                            <field name="mehrpreis_person"/>
                            <field name="std_je_5m"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action für die Konfiguration -->
    <record id="mk_preistabelle_action" model="ir.actions.act_window">
        <field name="name">Mietpreistabelle</field>
        <field name="res_model">mk.preistabelle</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Noch keine Mietpreise hinterlegt.
            </p>
            <p>
                Legen Sie hier Mietpreise für Aufzüge und Transportbühnen an.
            </p>
        </field>
    </record>

    <!-- Menü in der Abonnement-Konfiguration -->
    <menuitem
        id="mk_menu_preistabelle"
        name="Mietpreistabelle"
        parent="sale_subscription.menu_sale_subscription_config"
        action="mk_preistabelle_action"
        sequence="10"/>

</odoo>
