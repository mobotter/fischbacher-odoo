<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_mietkalkulation_tab" model="ir.ui.view">
        <field name="name">sale.order.mietkalkulation.tab</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_primary_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Mietkalkulation" name="mietkalkulation">
                    <div class="mk_tab_wrapper">

                        <!-- ── EINGABEN ───────────────────────────────────── -->
                        <group string="📋 Eingaben">
                            <group>
                                <field name="mk_traglast"/>
                                <field name="mk_aufbauhoehe"/>
                                <field name="mk_buehnengroesse"/>
                                <field name="mk_personenbefoerderung"/>
                                <field name="mk_extra_stationen"/>
                            </group>
                            <group>
                                <field name="mk_mietdauer_wochen"/>
                                <field name="mk_transport_stunden"/>
                            </group>
                        </group>

                        <separator string="📊 Berechnung Mietpreis"/>
                        <group>
                            <group string="Preiskomponenten">
                                <field name="mk_grundpreis"          widget="monetary" readonly="1"/>
                                <field name="mk_extra_hoehenabschnitte"                readonly="1"/>
                                <field name="mk_mehrpreis_hoehe"     widget="monetary" readonly="1"/>
                                <field name="mk_mehrpreis_stationen" widget="monetary" readonly="1"/>
                                <field name="mk_mehrpreis_buehne"    widget="monetary" readonly="1"/>
                                <field name="mk_mehrpreis_person"    widget="monetary" readonly="1"/>
                                <field name="mk_zwischensumme"       widget="monetary" readonly="1"/>
                            </group>
                            <group string="Rabatt &amp; Endpreis">
                                <field name="mk_rabatt_prozent"            readonly="1"
                                       string="Rabatt % (nach Mietdauer)"/>
                                <field name="mk_preis_nach_rabatt"         widget="monetary" readonly="1"/>
                                <field name="mk_preis_verlaengerungswoche" widget="monetary" readonly="1"/>
                                <field name="mk_maschinenbruch"            widget="monetary" readonly="1"
                                       help="4% Maschinenbruchversicherung auf Preis nach Rabatt"/>
                                <field name="mk_gesamt_4wochen"            widget="monetary" readonly="1"
                                       string="✅ Gesamt pro 4 Wochen (€)"/>
                                <field name="mk_gesamt_mietdauer"          widget="monetary" readonly="1"/>
                            </group>
                        </group>

                        <separator string="🔧 Montage &amp; Transport"/>
                        <group>
                            <group string="Montage-Einstellwerte">
                                <field name="mk_monteur_stundensatz" widget="monetary"/>
                                <field name="mk_helfer_stundensatz"  widget="monetary"/>
                                <field name="mk_std_je_station"/>
                                <field name="mk_faktor_geruest"/>
                                <field name="mk_faktor_gebaeude"/>
                            </group>
                            <group string="Berechnete Stunden">
                                <field name="mk_stunden_aufbau"     readonly="1"/>
                                <field name="mk_stunden_stationen"  readonly="1"/>
                                <field name="mk_gesamtstunden"      readonly="1"/>
                                <field name="mk_team_kosten_stunde" widget="monetary" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <group string="Montagekosten ohne Transport">
                                <field name="mk_montage_geruest"  widget="monetary" readonly="1"/>
                                <field name="mk_montage_gebaeude" widget="monetary" readonly="1"/>
                            </group>
                            <group string="Kosten inkl. Transport (LKW)">
                                <field name="mk_transportkosten_lkw"     widget="monetary" readonly="1"/>
                                <field name="mk_montage_gesamt_geruest"  widget="monetary" readonly="1"/>
                                <field name="mk_montage_gesamt_gebaeude" widget="monetary" readonly="1"/>
                            </group>
                        </group>

                        <!-- ── PREISTABELLE ───────────────────────────────── -->
                        <separator string="📋 Mietpreisliste Lastenaufzüge / Transportbühnen (pro 4 Wochen)"/>
                        <div class="mk_preistabelle">
                            <table class="mk_price_table">
                                <thead>
                                    <tr>
                                        <th>Position</th>
                                        <th>200 kg</th>
                                        <th>300 kg</th>
                                        <th>500 kg</th>
                                        <th>1000/1200 kg</th>
                                        <th>1500 kg</th>
                                        <th>2000 kg</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Grundgerät inkl. Zubehör (bis 15 m / 1 HS)</td>
                                        <td>€ 640,00</td><td>€ 680,00</td><td>€ 750,00</td>
                                        <td>€ 1.040,00</td><td>€ 1.190,00</td><td>€ 1.240,00</td>
                                    </tr>
                                    <tr>
                                        <td>Mehrpreis je zusätzliche 1,5 m Höhe</td>
                                        <td>€ 13,00</td><td>€ 14,00</td><td>€ 18,00</td>
                                        <td>€ 28,00</td><td>€ 31,00</td><td>€ 31,00</td>
                                    </tr>
                                    <tr>
                                        <td>Mehrpreis je zusätzl. Be-/Entladestelle (EG+1.OG inkl.)</td>
                                        <td>€ 38,00</td><td>€ 38,00</td><td>€ 55,00</td>
                                        <td>€ 55,00</td><td>€ 55,00</td><td>€ 55,00</td>
                                    </tr>
                                    <tr>
                                        <td>Lastbühne 1,45 × 3,25 m – Mehrpreis</td>
                                        <td>–</td><td>–</td><td>–</td>
                                        <td>€ 60,00</td><td>€ 60,00</td><td>€ 60,00</td>
                                    </tr>
                                    <tr>
                                        <td>Lastbühne 1,65 × 4,35 m – Mehrpreis</td>
                                        <td>–</td><td>–</td><td>–</td>
                                        <td>€ 80,00</td><td>€ 80,00</td><td>€ 80,00</td>
                                    </tr>
                                    <tr>
                                        <td>Personenbeförderung – Mehrpreis</td>
                                        <td>–</td><td>€ 390,00</td><td>€ 370,00</td>
                                        <td>€ 450,00</td><td>€ 460,00</td><td>€ 460,00</td>
                                    </tr>
                                </tbody>
                            </table>
                            <p class="mk_preistabelle_hinweis">
                                <em>Hinweis: 4% Maschinenbruchversicherung wird auf den berechneten Mietpreis (pro 4 Wochen) aufgeschlagen. – Preisliste 01/2023</em>
                            </p>
                        </div>

                        <!-- ── HINWEISE ───────────────────────────────────── -->
                        <separator string="ℹ️ Hinweise zur Kalkulation"/>
                        <div class="alert alert-info" role="alert">
                            <ul>
                                <li>Grundpreis gilt bis 15 m Aufbauhöhe (EG + 1. OG inkl.)</li>
                                <li>Jede weitere 1,5 m Höhe wird mit dem jeweiligen Mehrpreis berechnet.</li>
                                <li>4 % Maschinenbruchversicherung wird auf den Preis nach Rabatt aufgeschlagen.</li>
                                <li>Rabattstaffeln: ab 2 Mt. 5 % | ab 3 Mt. 10 % | ab 4 Mt. 12 % | ab 6 Mt. 15 % | ab 12 Mt. 20 %</li>
                            </ul>
                        </div>

                    </div><!-- /.mk_tab_wrapper -->
                </page>
            </xpath>
        </field>
    </record>
</odoo>
