<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="value_property_tree" model="ir.ui.view">
      <field name="name">zbs.value.property tree</field>
      <field name="model">zbs.value.property</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="description"/>
          <field name="property_id"/>
          <field name="property_type_id"/>
          <field name="object_appearance"/>
          <field name="property_type_name" invisible="1"/>
          <field name="field_ids" widget="many2many_tags"/>
          <field name="allowed_values" optional="hide"/>
          <field name="required"/>
          <field name="example" optional="hide"/>
        </list>
      </field>
    </record>
    <record id="zbs_specification_property_action" model="ir.actions.act_window">
      <field name="name">OpenAPI Props</field>
      <field name="res_model">zbs.value.property</field>
      <field name="view_mode">list,form</field>
      <field name="help">No values found!</field>
    </record>
    <menuitem id="menu_property_values" action="zbs_specification_property_action" parent="zbsync.menu_config"/>
  </data>
</odoo>
