<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="start_form_inherit" model="ir.ui.view">
      <field name="inherit_id" ref="zbsync_receiver.start_form"/>
      <field name="name">zbs.start form</field>
      <field name="model">zbs.start</field>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='authorizer_id']" position="after">
          <field name="rest_config_id"/>
          <field name="description" widget="text"/>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
