<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="stop_form" model="ir.ui.view">
      <field name="inherit_id" ref="zbsync_receiver.stop_form"/>
      <field name="name">zbs.stop form</field>
      <field name="model">zbs.stop</field>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='content_type']" position="after">
          <field name="description"/>
        </xpath>
      </field>
    </record>
    <record id="response_form" model="ir.ui.view">
      <field name="name">zbs.response form</field>
      <field name="model">zbs.stop.response</field>
      <field name="arch" type="xml">
        <form>
          <h1>
            <field name="name"/>
          </h1>
          <group>
            <field name="description"/>
            <field name="content_type"/>
            <field name="content_scheme_id" domain="[('property_id','=',False)]"/>
          </group>
        </form>
      </field>
    </record>
  </data>
</odoo>
