<?xml version="1.0"?>
<odoo>
  <data>
    <record id="zbs_res_config_form" model="ir.ui.view">
      <field name="model">zbs.rest.config</field>
      <field name="arch" type="xml">
        <form>
          <h1>
            <field name="name"/>
          </h1>
          <group colspan="1">
            <field name="short_name"/>
            <field name="request_group"/>
            <field name="request_method"/>
            <field name="request_type"/>
            <field name="description" widget="text"/>
            <field name="summary"/>
            <field name="example_ids">
              <list>
                <field name="name"/>
                <field name="example_type"/>
                <field name="example_json"/>
              </list>
            </field>
            <field name="payload_scheme_id" domain="[('property_id','=',False)]" invisible="request_method == 'GET'"/>
            <field name="parameter_ids">
              <list>
                <field name="name"/>
                <field name="description"/>
                <field name="example"/>
                <field name="parameter_type" optional="hide"/>
                <field name="field" optional="hide"/>
                <field name="required" optional="hide"/>
              </list>
            </field>
            <field name="response_id"/>
            <field name="error_ids">
              <list>
                <field name="code"/>
                <field name="description"/>
                <field name="zbs_exception" widget="many2many_tags"/>
              </list>
            </field>
          </group>
          <group string="Open API Config">
            <field name="payload" invisible="request_method == 'GET'" widget="ace"/>
            <field name="component" invisible="request_method == 'GET'" widget="ace"/>
            <field name="parameters" widget="ace"/>
            <field name="response_load" widget="ace"/>
          </group>
        </form>
      </field>
    </record>
    <record id="zbs_error_form" model="ir.ui.view">
      <field name="model">zbs.response.error</field>
      <field name="arch" type="xml">
        <form>
          <h3>
            <field name="code"/>
          </h3>
          <group>
            <field name="description"/>
            <field name="zbs_exception" widget="many2many_tags"/>
          </group>
        </form>
      </field>
    </record>
  </data>
</odoo>
