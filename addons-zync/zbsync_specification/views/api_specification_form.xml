<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="api_specifiaction_form" model="ir.ui.view">
      <field name="name">zbs.api.specification form</field>
      <field name="model">zbs.api.specification</field>
      <field name="arch" type="xml">
        <form>
          <sheet colspan="6">
            <group colspan="1" string="Specification">
              <field name="name"/>
              <field name="specification_type"/>
              <field name="description"/>
              <field name="pipeline_ids" widget="many2many_tags"/>
              <field name="version" readonly="1"/>
            </group>
            <group>
              <group col="6" string="Version">
                <field name="major_version"/>
                <field name="minor_version"/>
                <field name="patch_version"/>
              </group>
            </group>
            <group>
              <field name="api_version"/>
            </group>
            <button name="create_specification" class="oe_highlight" string="Generate Spec" type="object"/>
            <group string="Result">
              <field name="specification" widget="ace"/>
            </group>
            <chatter/>
          </sheet>
        </form>
      </field>
    </record>
    <record id="api_specifiaction_tree" model="ir.ui.view">
      <field name="name">zbs.api.specification tree</field>
      <field name="model">zbs.api.specification</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="description"/>
          <field name="version"/>
          <field name="pipeline_ids" widget="many2many_tags"/>
          <field name="api_version" readonly="1"/>
        </list>
      </field>
    </record>
    <record id="zbs_specification_action" model="ir.actions.act_window">
      <field name="name">OpenAPI Specs</field>
      <field name="res_model">zbs.api.specification</field>
      <field name="view_mode">list,form</field>
      <field name="help">No values found!</field>
    </record>
    <menuitem id="menu_pipelines_specifications" action="zbs_specification_action" parent="zbsync.menu_pipelines"/>
  </data>
</odoo>
