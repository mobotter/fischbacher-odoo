<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="value_property_form" model="ir.ui.view">
      <field name="name">zbs.value.property form</field>
      <field name="model">zbs.value.property</field>
      <field name="arch" type="xml">
        <form>
          <h1>
            <field name="name"/>
          </h1>
          <group>
            <field name="description" widget="text"/>
            <field name="property_type_id"/>
            <field name="object_appearance" invisible="property_type_name not in ['object']"/>
            <field name="property_type_name" invisible="1"/>
            <field name="field_ids" invisible="property_type_name not in ['array', 'object']">
              <list>
                <field name="name"/>
                <field name="property_type_id"/>
                <field name="required"/>
                <field name="allowed_values"/>
              </list>
            </field>
            <field name="allowed_values" invisible="property_type_name in ['array', 'object']"/>
            <field name="required"/>
            <field name="example"/>
          </group>
        </form>
      </field>
    </record>
  </data>
</odoo>
