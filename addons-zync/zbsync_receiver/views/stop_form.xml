<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="stop_form" model="ir.ui.view">
      <field name="inherit_id" ref="zbsync.stop_form"/>
      <field name="name">zbs.stop form</field>
      <field name="model">zbs.stop</field>
      <field name="mode">extension</field>
      <field name="arch" type="xml">
        <xpath expr="//group[@name='maingroup']" position="after">
          <group>
            <field name="return_data"/>
            <field name="force_return_object"/>
            <field name="content_type"/>
          </group>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
