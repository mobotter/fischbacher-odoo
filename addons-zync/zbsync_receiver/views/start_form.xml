<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="start_form" model="ir.ui.view">
      <field name="inherit_id" ref="zbsync.start_form"/>
      <field name="name">zbs.start form</field>
      <field name="model">zbs.start</field>
      <field name="mode">extension</field>
      <field name="arch" type="xml">
        <xpath expr="//group[@name='maingroup']" position="after">
          <group colspan="2">
            <field name="identifier" placeholder="get_something"/>
            <field name="url"/>
            <field name="authorizer_id"/>
            <field name="request_method"/>
            <field name="request_type"/>
            <field name="force_user_id"/>
          </group>
          <group colspan="2">
            <span colspan="2">
              <div>
                                Example to upload json data:
                                requests.post("HOMEURL/receiver", json={"exampledata":"Filled"})
                                <newline/>
                                In this case a new instance of this Pipeline will be created and will have the starting Data
                            </div>
            </span>
          </group>
          <newline/>
          <span colspan="2">
            <div style="padding: 6px; color: red; border: 1px solid #aaaaaa">
                        IMPORTANT: For to pipeline to correctly accept the body data of the request, the header "Content-Type-Orig"
                        with a content-type value must be added.
                        <newline/>
                        (Example: "Content-Type-Orig":"application/json")
                        </div>
          </span>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
