<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="zbs_receive_authorizer_list" model="ir.ui.view">
      <field name="model">zbs.receive.authorizer</field>
      <field name="arch" type="xml">
        <list default_order="" string="">
          <field name="name"/>
          <field name="auth_type"/>
        </list>
      </field>
    </record>
    <record id="zbs_receive_authorizer_form" model="ir.ui.view">
      <field name="name">zbs.receive.authorizer form</field>
      <field name="model">zbs.receive.authorizer</field>
      <field name="arch" type="xml">
        <form string="">
          <header/>
          <sheet>
            <group col="2" string="">
              <field name="name"/>
              <field name="auth_type"/>
              <notebook colspan="2">
                <page name="code" invisible="auth_type != 'code'" string="Code">
                  <field name="code" colspan="2" nolabel="1" widget="ace"/>
                  <newline/>
                  <details>
                    <summary>Available objects</summary>
                    <ul>
                      <li><b>headers:</b>request headers
                                            </li>
                      <li><b>postdata:</b>if post method
                                            </li>
                      <li><b>keyvalues:</b>querystring
                                            </li>
                      <li><b>env:</b>odoo environment
                                            </li>
                      <li><b>instance_env:</b>instance environment
                                            </li>
                    </ul>
                    <pre>
if not env['res.users'].is_user_ok(headers.token):
    return False
return True
                                        </pre>
                  </details>
                </page>
              </notebook>
            </group>
          </sheet>
          <chatter/>
        </form>
      </field>
    </record>
  </data>
</odoo>
