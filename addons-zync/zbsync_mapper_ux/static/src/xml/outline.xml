<?xml version="1.0"?>
<templates xml:space="preserve">
    <div owl="1" t-attf-style="padding-left: #{props.padding}px;" t-name="zbsync.mapper.ux.outline">
        <span t-att-data-id="props.id" t-attf-class="#{props.current ? 'current' : ''}" t-on-click.stop="clicked">
            <t t-esc="props.name" t-if="props.name"/>
            <t t-if="props.match_count &gt; 0">
            [<t t-esc="props.match_count"/>]
            </t>
        </span>
    </div>
    <div class="outline" owl="1" t-name="zbsync.mapper.ux.outline.parent">
        <t t-as="item" t-foreach="state.elements" t-key="item.id">
            <OutlineElement id="item.id" name="item.outline_name" current="item.outline_current || false" match_count="item.outline_match_count || 0" onSelect.bind="(id) =&gt; this.onSelect(id)" padding="item.outline_padding"/>
        </t>
    </div>
</templates>
