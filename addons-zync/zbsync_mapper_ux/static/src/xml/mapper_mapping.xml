<?xml version="1.0"?>
<templates xml:space="preserve">
    <t owl="1" t-name="zbsync.mapper.ux.mapping_data.table">
        <div class="zbsync-mapper-ux-input">
            <h3>Mappings</h3>
            <div class="left">
                <Outline current_item="state.current_parent || null" fields="state.root_fields" onSelect="(item) =&gt; { this.set_new_parent(item) }"/>
            </div>
            <div class="right">
                <FieldFilter onNewFilter.bind="(value) =&gt; this.filter_updated(value)"/>
                <BreadCrumbs onSelect.bind="(item) =&gt; this.set_new_parent(item.parent)" parent="state.current_parent || null"/>
                <div class="ux-mapper-table">
                    <MappingList mapper_id="props.mapper_id" mapping_id="state.current_parent ? state.current_parent.id : false" mappinglist="state.fieldlist" onEnteredItem.bind="(item) =&gt; this.set_new_parent(item)"/>
                </div>
            </div>
        </div>
        <!-- <div>
            <Preview preview="state.preview"/>
        </div> -->
    </t>
    <t owl="1" t-name="zbsync.mapper.ux.mapping_data.mappinglist">
        <t t-as="item" t-foreach="props.mappinglist" t-key="item_index">
            <Mapping item="item" mapper_id="props.mapper_id" mapping_id="props.mapping_id" onEnteredItem.bind="(item) =&gt; this.set_new_parent(item)"/>
        </t>
        <div class="">
            <span>
                <button t-attf-class="btn btn-light dropzone #{state.addmapping_dropklass}" t-on-click.prevent="add" t-on-dragenter="dragenter_addmapping" t-on-dragleave="dragleave_addmapping" t-on-drop="dropped_addmapping">Add Mapping...</button>
            </span>
        </div>
    </t>
    <t owl="1" t-name="zbsync.mapper.ux.mapping_data.mapping">
        <div class="table-row mapping" draggable="True" t-attf-data-id="#{props.item.id}" t-on-dblclick.stop.prevent="dblclicked_item" t-on-dragend.stop="drag_end" t-on-dragleave.prevent="dragleave_item_sequence" t-on-dragover.prevent="dragover_item_sequence" t-on-dragstart.stop="drag_start" t-on-drop="on_drop">
            <span>
                <a class="fa fa-external-link" t-on-click.stop.prevent="clicked_extlink"/>
            </span>
            <span>
                <t t-esc="props.item.id"/>
            </span>
            <MappingProperty fieldname="'field_source'" item="props.item"/>
            <MappingProperty fieldname="'action'" item="props.item" type="'selection'"/>
            <MappingProperty fieldname="'field_dest'" item="props.item"/>
            <span style="text-align: center;">
                <a class="fa fa-trash-o" t-on-click.stop="delete"/>
            </span>
        </div>
    </t>
    <t owl="1" t-name="zbsync.mapper.ux.mapping_data.mapping.property">
        <span t-if="state.edit_mode">
            <t t-if="props.type === 'selection'">
                <select t-on-blur.stop.prevent="savechanges" t-ref="autofocus">
                    <t t-as="val" t-foreach="state.selectionValues" t-key="val.id">
                        <t t-if="val.name == state.stringvalue">
                            <option selected="1" t-att-value="val.value">
                                <t t-esc="val.name"/>
                            </option>
                        </t>
                        <t t-else="">
                            <option t-att-value="val.value">
                                <t t-esc="val.name"/>
                            </option>
                        </t>
                    </t>
                </select>
            </t>
            <t t-else="">
                <input t-att-value="props.item[props.fieldname]" t-on-blur="savechanges" t-on-dblclick.stop="() =&gt; {}" t-ref="autofocus"/>
            </t>
        </span>
        <span t-else="" t-on-click.stop.prevent="enter_editmode">
            <t t-esc="state.stringvalue"/>
        </span>
    </t>
</templates>
