<?xml version="1.0"?>
<templates xml:space="preserve">
    <t owl="1" t-name="zbsync.mapper.ux.input_data.table">
        <div class="zbsync-mapper-ux-input">
            <h3>Input Data</h3>
            <div class="control-panel">
                <span>
                    Samples
                    <input t-model="state.show_sample_values" type="checkbox"/>
                </span>
            </div>
        </div>
        <div class="left">
            <Outline current_item="state.current_parent || null" fields="state.root_fields" onSelect="(item) =&gt; { this.set_new_parent(item) }"/>
        </div>
        <div class="right">
            <FieldFilter onNewFilter.bind="(value) =&gt; this.filter_updated(value)"/>
            <BreadCrumbs onSelect.bind="(item) =&gt; this.set_new_parent(item.parent)" parent="state.current_parent || null"/>
            <div class="ux-mapper-table zbsync-mapper-ux-scrollcontainer">
                <FieldList fieldlist="state.fieldlist" onEnteredItem.bind="(item) =&gt; this.set_new_parent(item)" parent="state.current_parent || null" root_state="state" show_sample_values="state.show_sample_values"/>
            </div>
        </div>
    </t>
    <t owl="1" t-name="zbsync.mapper.ux.input_data.fieldlist">
        <t t-as="item" t-foreach="props.fieldlist" t-key="item_index">
            <SourceField item="item" onEnteredItem.bind="(item) =&gt; this.props.onEnteredItem(item)" root_state="props.root_state" show_sample_values="props.show_sample_values"/>
        </t>
    </t>
    <t owl="1" t-name="zbsync.mapper.ux.input_data.field">
        <div draggable="true" t-attf-class="table-row" t-on-click="clicked_item" t-on-dragstart="dragstart" t-on-mouseenter="mouseenter" t-on-mouseleave="mouseleave">
            <span>
                <t t-esc="props.item.name"/>
                <t t-if="props.item.lenchildren">
                    [
                    <t t-esc="props.item.lenchildren"/>
                    ]
                </t>
            </span>
            <span t-if="props.show_sample_values">
                <t t-esc="props.item.sample"/>
            </span>
        </div>
    </t>
</templates>
