<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="view_zbs_mapper_form" model="ir.ui.view">
      <field name="model">zbs.mapper</field>
      <field name="inherit_id" ref="zbsync_mapper.view_zbs_mapper_form"/>
      <field name="arch" type="xml">
        <xpath expr="//notebook" position="inside">
          <page name="table" string="Table">
          </page>
        </xpath>
        <xpath expr="//page[@name='table']" position="inside">
          <xpath expr="//field[@name='mapping_ids']/../following-sibling::button" position="move"/>
          <xpath expr="//field[@name='mapping_ids']/../following-sibling::button" position="move"/>
          <xpath expr="//field[@name='mapping_ids']/.." position="move"/>
        </xpath>
        <xpath expr="//page[1]" position="before">
          <page name="ux" string="Visual">
            <group col="1">
              <field name="ux_input_mapped" nolabel="1" widget="zbsync_mapper_ux_input"/>
              <field name="ux_output_mapped" nolabel="1" widget="zbsync_mapper_ux_mapping"/>
              <field name="ux_preview" nolabel="1"/>
            </group>
          </page>
          <page name="input_sample" string="Input Sample">
            <group>
              <field name="ux_input_path"/>
              <field name="ux_input_sample_error"/>
              <field name="ux_input_sample"/>
            </group>
          </page>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
