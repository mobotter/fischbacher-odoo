<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="view_zbs_trigger_form" model="ir.ui.view">
      <field name="name">zbs.trigger.methodhook form</field>
      <field name="model">zbs.trigger.methodhook</field>
      <field name="arch" type="xml">
        <form string="">
          <header/>
          <sheet position="inside">
            <a href="https://www.zebroo.de/knowledge/article/259" target="_blank">Online Help for defining Triggers</a>
            <group>
              <field name="model_id" required="1"/>
              <field name="model_name" invisible="1"/>
              <field name="domain" options="{'model': 'model_name', 'in_dialog': False}" widget="domain"/>
              <field name="method" placeholder="create,write etc."/>
              <field name="link_expression"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>
    <record id="zbs_trigger_fieldhook_form" model="ir.ui.view">
      <field name="name">zbs.trigger.fieldhook form</field>
      <field name="model">zbs.trigger.fieldhook</field>
      <field name="arch" type="xml">
        <form string="">
          <header/>
          <sheet>
            <a href="https://www.zebroo.de/knowledge/article/259" target="_blank">Online Help for defining Triggers</a>
            <group col="2" string="">
              <field name="model_id"/>
              <field name="model_name" invisible="1"/>
              <field name="domain" options="{'model': 'model_name', 'in_dialog': False}" widget="domain"/>
              <field name="field_names"/>
              <field name="old_value" placeholder="comma separated"/>
              <field name="new_value" placeholder="comma separated"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>
  </data>
</odoo>
