<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="view_zbs_pipeline_form" model="ir.ui.view">
      <field name="model">zbs.pipeline</field>
      <field name="inherit_id" ref="zbsync.view_zbs_pipeline_form"/>
      <field name="arch" type="xml">
        <notebook position="inside">
          <page string="Method Triggers">
            <a href="https://www.zebroo.de/knowledge/article/259" target="_blank">Online Help for defining Triggers</a>
            <field name="method_trigger_ids">
              <list>
                <field name="domain"/>
                <field name="method"/>
                <field name="model_id"/>
                <field name="link_expression"/>
              </list>
            </field>
          </page>
          <page string="Field Triggers">
            <a href="https://www.zebroo.de/knowledge/article/259" target="_blank">Online Help for defining Triggers</a>
            <field name="field_trigger_ids">
              <list>
                <field name="model_id"/>
                <field name="domain"/>
                <field name="old_value"/>
                <field name="new_value"/>
                <field name="field_names"/>
                <field name="link_expression"/>
              </list>
            </field>
          </page>
        </notebook>
      </field>
    </record>
  </data>
</odoo>
