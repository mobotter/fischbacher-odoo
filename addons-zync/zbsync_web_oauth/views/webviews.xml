<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="view_zbs_connection_web_auth_form" model="ir.ui.view">
      <field name="model">zbs.connection.web.auth</field>
      <field name="inherit_id" ref="zbsync_web.zbs_connection_web_auth_form"/>
      <field name="arch" type="xml">
        <notebook position="inside">
          <page name="oauth_auth" colspan="2" invisible="auth_type not in ['oauth2', 'oauth1']" string="Auth">
            <group colspan="2">
              <field name="application_type" invisible="auth_type == 'oauth1'"/>
              <field name="client_id" required="auth_type in ['oauth2', 'oauth1']"/>
              <field name="client_secret" required="auth_type in ['oauth2', 'oauth1']"/>
              <field name="access_token" invisible="auth_type != 'oauth1'"/>
              <field name="access_secret" invisible="auth_type != 'oauth1'"/>
              <field name="username" invisible="auth_type in ['oauth1'] or application_type != 'legacy'"/>
              <field name="password" invisible="auth_type in ['oauth1'] or application_type != 'legacy'" password="True"/>
              <field name="token_url" invisible="auth_type == 'oauth1'" required="auth_type == 'oauth2'"/>
              <field name="scope" invisible="auth_type in ['oauth1'] or application_type != 'backend'" placeholder="https://graph.microsoft.com/.default"/>
            </group>
          </page>
        </notebook>
      </field>
    </record>
  </data>
</odoo>
