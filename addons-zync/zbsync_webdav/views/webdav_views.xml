<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="view_zbs_connection_soap_form" model="ir.ui.view">
      <field name="name">zbs.connection.webdav form</field>
      <field name="model">zbs.connection.webdav</field>
      <field name="inherit_id" eval="False"/>
      <field name="mode">primary</field>
      <field name="arch" type="xml">
        <form string="">
          <div class="oe_title">
            <h1>
              <field name="name" class="oe_inline" colspan="4"/>
            </h1>
          </div>
          <group col="2" string="">
            <field name="webdav_hostname" placeholder="https://dav-pocket.appspot.com"/>
            <field name="webdav_login"/>
            <field name="webdav_password" password="True"/>
            <field name="use_proxy"/>
            <field name="use_ssl"/>
            <field name="chunk_size"/>
          </group>
          <notebook string="Options">
            <page string="Transfer Options">
              <group colspan="2">
                <field name="recv_speed"/>
                <field name="send_speed"/>
                <field name="verbose"/>
                <field name="disable_check"/>
                <field name="chunk_size"/>
              </group>
            </page>
            <page invisible="use_proxy == False" string="Proxy Options">
              <group colspan="2" string="Options">
                <field name="cert_path"/>
                <field name="key_path"/>
              </group>
            </page>
            <page invisible="use_ssl == False" string="SSL Options">
              <group colspan="2" string="SSL Options">
                <field name="cert_path"/>
                <field name="key_path"/>
              </group>
            </page>
          </notebook>
          <chatter/>
        </form>
      </field>
    </record>
    <record id="view_zbs_grabber_webdav_form" model="ir.ui.view">
      <field name="name">zbs.grabber.webdav form</field>
      <field name="model">zbs.grabber.webdav</field>
      <field name="inherit_id" ref="zbsync.worker_form"/>
      <field name="mode">primary</field>
      <field name="arch" type="xml">
        <group position="after">
          <group col="2" string="">
            <field name="connection_id" required="1"/>
            <field name="content_path"/>
            <field name="content_type"/>
            <field name="local_path"/>
            <field name="glob"/>
            <field name="limit"/>
            <field name="encoding"/>
          </group>
        </group>
      </field>
    </record>
  </data>
</odoo>
