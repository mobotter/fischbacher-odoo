<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="view_zbs_import_pipeline_form" model="ir.ui.view">
      <field name="name">zbs.import.pipeline form</field>
      <field name="model">zbs.import.pipeline</field>
      <field name="arch" type="xml">
        <form string="">
          <sheet>
            <group col="2" string="">
              <field name="filecontent" filename="filename" invisible="0"/>
              <field name="pipeline_id" string="Update this pipeline or clear to import as a new one"/>
              <field name="newname" required="not pipeline_id"/>
            </group>
            <group col="1" string="Log">
              <field name="log" nolabel="1"/>
            </group>
            <group string="Diff">
              <field name="diffcontent" colspan="2" nolabel="1" widget="diff_view_deactivated"/>
            </group>
          </sheet>
          <footer>
            <button name="ok" data-hotkey="q" string="OK" type="object"/>
            <button class="oe_link" data-hotkey="z" special="cancel" string="Cancel"/>
          </footer>
        </form>
      </field>
    </record>
  </data>
</odoo>
