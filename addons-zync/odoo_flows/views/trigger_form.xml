<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="view_of_trigger_form" model="ir.ui.view">
            <field name="name">of.trigger form</field>
            <field name="model">of.trigger</field>
            <field name="inherit_id" ref="odoo_flows.base_item_form"/>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <group name="code" position="attributes">
                    <attribute name="invisible">1</attribute>
                </group>
                <xpath expr="//page[@name='item_content']" position="inside">
                    <group name="code">
                        <group>
                            <field name="trigger_by_code"/>
                        </group>
                        <notebook>
                            <page invisible="trigger_by_code == False" name="code" string="Code">
                                <newline/>
                                <field name="code" nolabel="1" options="{'mode': 'python'}" widget="ace"/>
                            </page>
                            <page name="events" string="Events">
                                <a href="https://www.zebroo.de/knowledge/article/259" target="_blank">
                                    Online Help for defining Methods
                                </a>
                                <field name="method_trigger_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="model_id"/>
                                        <field name="domain"/>
                                        <field name="method"/>
                                        <field name="link_expression"/>
                                        <field name="enabled"/>
                                    </list></field>
                            </page>
                            <page col="2" name="help" string="Help">
                                <div invisible="trigger_by_code == False">
                                    <span>
                                        Return odoo instances like e.g.
                                    </span>
                                    <pre>
                                        result = env.search([(...)])
                                    </pre>
                                    <br/>
                                </div>
                                <div>
                                    <span>
                                        If trigger is in front of start element, then it can start a new workflow.
									If trigger is in front of an element in between it may continue the flow there.
                                    </span>
                                </div>
                            </page>
                        </notebook>
                    </group>
                </xpath></field>
        </record>
    </data>
</odoo>
