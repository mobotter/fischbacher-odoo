<odoo>
	<data noupdate='0'>
		<record id="view_of_timer_form" model="ir.ui.view">
			<field name="name">of.timer form</field>
			<field name="model">of.timer</field>
			<field name="inherit_id" ref="odoo_flows.base_item_form"></field>
			<field name="mode">primary</field>
			<field name="arch" type="xml">
				<xpath expr="//page[@name='item_content']" position="inside">
					<group name="content">
						<field name="name"/>
						<field name="interval_number"/>
						<field name="interval_type"/>
					</group>
				</xpath>
			</field>
		</record>
	</data>
</odoo>