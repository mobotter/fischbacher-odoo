<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="view_of_mail_activity_form" model="ir.ui.view">
      <field name="name">of.mail_activity form</field>
      <field name="model">of.mail_activity</field>
      <field name="inherit_id" ref="odoo_flows.base_item_form"/>
      <field name="mode">primary</field>
      <field name="arch" type="xml">
        <xpath expr="//page[@name='item_content']" position="inside">
          <group name="content" position="inside">
            <field name="activity_type_id" required="True"/>
            <field name="due_days" required="True"/>
            <field name="summary" required="True"/>
            <field name="user_id"/>
          </group>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
