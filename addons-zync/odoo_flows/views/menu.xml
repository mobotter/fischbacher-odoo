<?xml version="1.0"?>
<odoo>
	<data noupdate='0'>

		<menuitem name="BPM" id="of_root" groups="odoo_flows.group_bpm_manager" web_icon="odoo_flows,static/img/logo.png" sequence="10000"/>
		<menuitem name="Configuration" parent="of_root" id="config_menu" sequence="9999"/>

		<record id='flows_action' model='ir.actions.act_window'>
			<field name='name'>Flows</field>
			<field name='res_model'>of.flow</field>
			<field name='view_mode'>list,form</field>
			<field name="help"><![CDATA[<p> Nothing found!  </p>]]></field>
		</record>
		<menuitem parent="of_root" id="menu_flows" action="flows_action"/>

		<record id='instances_action' model='ir.actions.act_window'>
			<field name='name'>Running Flows</field>
			<field name='res_model'>of.instance</field>
			<field name='view_mode'>list,form</field>
		</record>
		<menuitem parent="of_root" id="menu_instances" action="instances_action"/>

		<record id='roles_action' model='ir.actions.act_window'>
			<field name='name'>Roles</field>
			<field name='res_model'>of.role</field>
			<field name='view_mode'>list</field>
			<field name="help"><![CDATA[<p> Nothing found!  </p>]]></field>
		</record>
		<menuitem parent="config_menu" id="menu_roles" action="roles_action"/>

		<record id='flow_group_action' model='ir.actions.act_window'>
			<field name='name'>Flow Group</field>
			<field name='res_model'>of.flow.group</field>
			<field name='view_mode'>list</field>
			<field name="help"><![CDATA[<p> Nothing found!  </p>]]></field>
		</record>
		<menuitem parent="config_menu" id="menu_flow_group" action="flow_group_action"/>

	</data>
</odoo>
