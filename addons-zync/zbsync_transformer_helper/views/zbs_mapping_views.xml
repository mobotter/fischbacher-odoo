<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="view_zbs_mapping_form_inherit" model="ir.ui.view">
      <field name="model">zbs.mapping</field>
      <field name="inherit_id" ref="zbsync_mapper.view_zbs_mapping_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='code']" position="after">
          <span>
            <group colspan="2" string="Code Helpers">
              <field name="code_helper"/>
              <button name="append_code_helper" class="oe_highlight" colspan="2" string="Append Helper" type="object"/>
            </group>
          </span>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
