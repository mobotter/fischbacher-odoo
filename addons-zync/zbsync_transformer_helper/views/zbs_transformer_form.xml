<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="view_zbs_transformer_form1_inherit" model="ir.ui.view">
      <field name="name">zbs.transformer form inherit</field>
      <field name="model">zbs.transformer.python</field>
      <field name="inherit_id" ref="zbsync.view_zbs_transformer_form1"/>
      <field name="arch" type="xml">
        <xpath expr="//page[@name='code']" position="after">
          <page string="Helpers / Code Templates">
            <span colspan="2">
              <group colspan="2" string="Code Helpers">
                <field name="code_helper"/>
                <button name="append_code_helper" class="oe_highlight" colspan="2" string="Append Helper" type="object"/>
              </group>
            </span>
          </page>
        </xpath>
      </field>
    </record>
    <record id="view_zbs_transformer_helper_form" model="ir.ui.view">
      <field name="name">zbs.transformer.helper.form</field>
      <field name="model">zbs.transformer.helper</field>
      <field name="arch" type="xml">
        <form>
          <h1>
            <field name="name"/>
          </h1>
          <group>
            <field name="description"/>
            <field name="code" options="{'mode': 'python'}" widget="ace"/>
          </group>
        </form>
      </field>
    </record>
    <record id="view_zbs_transformer_helper_list" model="ir.ui.view">
      <field name="name">zbs.transformer.helper.list</field>
      <field name="model">zbs.transformer.helper</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="description"/>
          <field name="code" readonly="1"/>
        </list>
      </field>
    </record>
    <record id="download_transformer_helper_action" model="ir.actions.server">
      <field name="name">Download Helpers</field>
      <field name="model_id" ref="model_zbs_transformer_helper"/>
      <field name="binding_model_id" ref="model_zbs_transformer_helper"/>
      <field name="state">code</field>
      <field name="code">action=records.download()</field>
    </record>
    <record id="transformer_helper_action" model="ir.actions.act_window">
      <field name="name">Transformer Helpers</field>
      <field name="res_model">zbs.transformer.helper</field>
      <field name="view_mode">list,form</field>
      <field name="help">Nothing found!</field>
    </record>
    <menuitem id="menu_transformer_helper" action="transformer_helper_action" parent="zbsync.menu_config"/>
  </data>
</odoo>
