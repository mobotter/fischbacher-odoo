<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="view_zbs_transformer_form_key_value" model="ir.ui.view">
      <field name="name">zbs.transformer form key value</field>
      <field name="model">zbs.transformer.keyvaluepair</field>
      <field name="arch" type="xml">
        <form>
          <h1>
            <field name="name"/>
          </h1>
          <group colspan="4" string="Options">
            <field name="direction"/>
            <field name="fieldname"/>
            <field name="key_name"/>
            <field name="value_name"/>
          </group>
          <span colspan="4">
            <div invisible="direction == 'keyvaluetodict'">
              <p>
                                CAREFUL!
                            </p>
              <p>
                                DIRECTION DICT TO KEY VALUE PAIR NOT IMPLEMENTED YET!
                            </p>
            </div>
          </span>
          <span colspan="4">
            <details>
              <div colspan="4"><p>
                                    General Overview:
                                </p><p>
                                    We expect the values to arrive in the following structures:
                                </p><p>
                                    {
                                    ...,
                                        'ExampleField':{
                                        'KeyField': 'SomeValue',
                                            'ValueField': 'AnotherValue'
                                    }
                                   }
                                </p><p>
                                    Or as a List:
                                </p><p>
                                    {
                                        ...,
                                        'ExampleField':[{
                                            'KeyField': 'SomeValue',
                                            'ValueField': 'AnotherValue'
                                        },
                                </p><p>
                                    {
                                            'KeyField': 'SomeValue2',
                                            'ValueField': 'AnotherValue2'
                                        },


                                        ]
                                    }
                                </p><p>
                                    These Values set in the Transformer
                                    correspond to the following:
                                </p><ul><li>
                                        Field Name:
                                        <p>
                                            The Name of the under which the fields you want to Transfer
                                        are located. In the above Examples that would be 'ExampleField'
                                        </p>
                                    </li><li>
                                        Key Name:
                                        <p>
                                            The Name of the Field for the Key. In the above Example that would
                                        be 'KeyField'
                                        </p>
                                    </li><li>
                                        Value Name:
                                        <p>
                                            The Name of the Field for the Value. In the above Example that would
                                        be 'ValueField'
                                        </p>
                                    </li></ul><p>
                                    The result will be:
                                </p>
                                {
                                        ...,
                                        'ExampleFieldTransformed':{
                                            'SomeValue': 'AnotherValue'
                                            }
                                        }
                            </div>
            </details>
          </span>
        </form>
      </field>
    </record>
  </data>
</odoo>
