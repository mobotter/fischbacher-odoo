<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="webworker_form" model="ir.ui.view">
      <field name="model">zbs.web.worker</field>
      <field name="inherit_id" ref="zbsync.worker_form"/>
      <field name="mode">primary</field>
      <field name="arch" type="xml">
        <xpath expr="//group[@name='maingroup']" position="replace">
          <div class="o_row" colspan="2">
            <div class="o_col-6">
              <span>
                <group>
                  <field name="url_id" placeholder="docs.zebroo.de" required="1"/>
                  <field name="path" placeholder="/docs/web-apis"/>
                  <field name="method" required="1"/>
                  <field name="dont_send_body"/>
                  <field name="request_content_type" required="1"/>
                  <field name="response_content_type" required="1"/>
                  <field name="timeout"/>
                  <field name="retry_pattern"/>
                  <field name="return_response_headers"/>
                </group>
              </span>
            </div>
            <div class="o_col-6" style="text-align: right;">
              <a class="btn btn-link" href="https://docs.zebroo.de/docs/web-workers" role="button" target="_blank" title="View Documentation"><i class="fa fa-question-circle"/> Help
              </a>
            </div>
          </div>
          <span>
            <group colspan="2">
              <field name="post_process" options="{'mode': 'python'}" widget="ace"/>
              <field name="body" invisible="dont_send_body" options="{'mode': 'python'}" widget="ace"/>
              <field name="code_next_page" options="{'mode': 'python'}" placeholder="response.url_next_page" widget="ace"/>
              <field name="extract_path" options="{'mode': 'python'}" placeholder="response.value" widget="ace"/>
            </group>
          </span>
          <span colspan="4">
            <group>
              <group colspan="4">
                <group colspan="4">
                  <a href="https://www.zebroo.de/knowledge/article/286" target="_blank">Online Help for Web Worker</a>
                </group>
                <group colspan="4">
                  <field name="code_next_page" options="{'mode': 'python'}" placeholder="response.url_next_page" widget="ace"/>
                  <field name="extract_path" options="{'mode': 'python'}" placeholder="response.value" widget="ace"/>
                  <field name="path"/>
                </group>
              </group>
              <span colspan="4">
                <details colspan="4">
                  <summary>
                                        Available Objects:
                                    </summary>
                  <ul>
                    <li>
                                            index: int - number in record; 0 based
                                        </li>
                    <li>
                                            record: the currently processed source record
                                        </li>
                    <li>
                                            input: the complete input data to this worker
                                        </li>
                  </ul>
                  <h2>
                                        Examples
                                    </h2>
                  <ul>
                    <li>
                      <pre>
                                                /todos/{record.id}
                                            </pre>
                    </li>
                    <li>
                      <pre>
                                                /todos/{record.id}
                                            </pre>
                    </li>
                    <li>
                      <pre>
                                                path = "/todos/put"
if record.f1 == 'v1':
    path += "/addonstuff"
path
                                            </pre>
                    </li>
                  </ul>
                </details>
              </span>
            </group>
          </span>
          <span colspan="2">
            <group colspan="2" string="Request Headers">
              <field name="request_arg_ids" colspan="2" nolabel="1">
                <list colspan="2" editable="bottom">
                  <field name="type"/>
                  <field name="name"/>
                  <field name="value"/>
                </list>
              </field>
            </group>
          </span>
        </xpath>
      </field>
    </record>
    <record id="view_web_url_form" model="ir.ui.view">
      <field name="name">web.url form</field>
      <field name="model">zbs.web.url</field>
      <field name="arch" type="xml">
        <form string="URL Authentication">
          <header>
                    </header>
          <sheet>
            <group col="2" string="">
              <field name="identifier"/>
              <field name="name"/>
            </group>
            <group col="2" string="URL">
              <field name="url_ids" colspan="2" nolabel="1">
                <list editable="bottom">
                  <field name="name"/>
                  <field name="auth_id"/>
                  <field name="proxy_ids" widget="many2many_tags"/>
                  <field name="environment_ids" widget="many2many_tags"/>
                </list>
              </field>
            </group>
          </sheet>
        </form>
      </field>
    </record>
    <record id="view_zbs_web_url_list" model="ir.ui.view">
      <field name="model">zbs.web.url</field>
      <field name="arch" type="xml">
        <list default_order="" string="">
          <field name="name" optional="show"/>
          <field name="identifier" optional="show"/>
        </list>
      </field>
    </record>
    <record id="zbs_connection_web_auth_form" model="ir.ui.view">
      <field name="name">zbs.connection.web.auth form</field>
      <field name="model">zbs.connection.web.auth</field>
      <field name="arch" type="xml">
        <form string="">
          <header>
                    </header>
          <sheet>
            <group>
              <field name="name" required="1"/>
              <field name="auth_type" required="1"/>
            </group>
            <notebook>
              <page name="basic_auth" invisible="auth_type != 'basic_auth'" string="Basic Auth">
                <group col="2" string="">
                  <field name="username" required="auth_type == 'basic_auth'"/>
                  <field name="password" password="True" required="auth_type == 'basic_auth'"/>
                </group>
              </page>
              <page name="bearer_token" invisible="auth_type != 'bearer_token'" string="Bearer Token">
                <group col="2" string="">
                  <field name="token" required="auth_type == 'bearer_token'"/>
                </group>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>
    <record id="zbs_connection_web_auth_list" model="ir.ui.view">
      <field name="model">zbs.connection.web.auth</field>
      <field name="arch" type="xml">
        <list default_order="" string="">
          <field name="name"/>
          <field name="auth_type"/>
          <field name="username"/>
          <field name="password" password="True"/>
          <field name="token"/>
        </list>
      </field>
    </record>
    <record id="zbs_web_proxy_form" model="ir.ui.view">
      <field name="name">zbs.web.proxy form</field>
      <field name="model">zbs.web.proxy</field>
      <field name="arch" type="xml">
        <form string="">
          <header/>
          <sheet>
            <div class="oe_title">
              <h1>
                <field name="name" class="oe_inline" colspan="4"/>
              </h1>
            </div>
            <group col="4" string="">
              <field name="protocol"/>
              <field name="url" placeholder="http://proxy.example.com:8080"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>
  </data>
</odoo>
