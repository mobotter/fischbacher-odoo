<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="view_zbs_grabber_file_form" model="ir.ui.view">
      <field name="name">zbs.grabber.file form</field>
      <field name="model">zbs.grabber.file</field>
      <field name="inherit_id" ref="zbsync.worker_form"/>
      <field name="mode">primary</field>
      <field name="arch" type="xml">
        <xpath expr="//group[@name='maingroup']" position="inside">
          <notebook>
            <page string="Path">
              <group>
                <field name="filepath"/>
                <field name="recursive"/>
                <field name="limit"/>
              </group>
            </page>
            <page string="Filters">
              <group>
                <field name="create_date_before"/>
                <field name="create_date_after"/>
              </group>
            </page>
            <page string="Action After Read">
              <group>
                <field name="action_after_read"/>
                <field name="destination_path" invisible="action_after_read != 'move'"/>
              </group>
            </page>
            <page name="file_content" string="File Content">
              <group>
                <field name="content_type" required="1"/>
                <field name="encoding" required="content_type == 'text'"/>
              </group>
            </page>
          </notebook>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
