<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="view_ftpdumper_form" model="ir.ui.view">
      <field name="name">zbs.dumper.file.ftp.form</field>
      <field name="model">zbs.dumper.file.ftp</field>
      <field name="inherit_id" ref="zbsync.worker_form"/>
      <field name="mode">primary</field>
      <field name="arch" type="xml">
        <xpath expr="//group[@name='maingroup']" position="replace">
          <group col="2">
            <a href="https://www.zebroo.de/knowledge/article/238" target="_blank">Online Help</a>
            <field name="connection_id"/>
            <field name="encoding_id"/>
            <field name="filepath"/>
          </group>
          <group col="1">
            <details>
              <summary>Available variables/examples</summary>
              <ul>
                <li>record.content</li>
                <li>/path/path2/{record.filename}</li>
              </ul>
            </details>
          </group>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
