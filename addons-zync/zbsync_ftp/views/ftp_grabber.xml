<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="view_zbs_grabber_ftp_form" model="ir.ui.view">
      <field name="model">zbs.grabber.file.ftp</field>
      <field name="inherit_id" ref="zbsync.worker_form"/>
      <field name="mode">primary</field>
      <field name="arch" type="xml">
        <xpath expr="//group[@name='maingroup']" position="inside">
          <field name="connection_id"/>
          <field name="filepath"/>
          <field name="filter_type"/>
          <field name="regex_filter" invisible="filter_type != 'regex'"/>
          <field name="wildcard_filter" invisible="filter_type != 'wildcard'"/>
          <field name="recursive"/>
          <field name="action_after_read"/>
          <field name="destination_path" invisible="action_after_read == False"/>
          <field name="limit"/>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
