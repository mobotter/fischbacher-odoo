<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="create_mapping_wizard_form" model="ir.ui.view">
      <field name="model">zbs.create.mapping.wizard</field>
      <field name="arch" type="xml">
        <form create="0">
          <header>
            <h1>
              <field name="name"/>
            </h1>
          </header>
          <group>
            <field name="mapping_direction"/>
            <field name="odoo_model_id" invisible="mapping_direction == 'transfer'"/>
            <field name="backend_model_id"/>
            <field name="transfer_model_id" invisible="mapping_direction != 'transfer'"/>
          </group>
          <group colspan="2">
            <field name="from_field_ids">
              <list editable="bottom" no_create="1">
                <field name="model_name"/>
                <field name="name"/>
                <field name="action"/>
                <field name="allowed_field_ids" invisible="1"/>
                <field name="mapped_field_id"/>
              </list>
            </field>
            <field name="to_field_ids" invisible="1">
              <list editable="bottom" no_create="1">
                <field name="model_name"/>
                <field name="name"/>
                <field name="action"/>
              </list>
            </field>
          </group>
          <footer>
            <button name="wizard_confirm" class="btn-primary" data-hotkey="v" string="Confirm" type="object"/>
            <button class="btn-secondary" data-hotkey="z" special="cancel" string="Cancel"/>
          </footer>
        </form>
      </field>
    </record>
  </data>
</odoo>
