<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="view_zbs_mapper_form" model="ir.ui.view">
      <field name="name">zbs.mapper form</field>
      <field name="model">zbs.mapper</field>
      <field name="inherit_id" ref="zbsync.worker_form"/>
      <field name="mode">primary</field>
      <field name="arch" type="xml">
        <header position="inside">
          <button name="action_open_create_mapping_wizard" class="oe_highlight" data-hotkey="shift+c" string="Create New Mapping" type="object"/>
        </header>
        <xpath expr="//group[@name='maingroup']" position="replace">
          <group col="2">
            <a href="https://www.zebroo.de/knowledge/article/263" target="_blank">Help</a>
            <field name="mapping_ids" colspan="2" nolabel="1">
              <list editable="bottom" multi_edit="1">
                <field name="sequence" class="open_line" widget="handle"/>
                <field name="level" optional="hide" readonly="1"/>
                <button name="open_mapping" icon="fa-external-link" string="" title="Open Mapping" type="object"/>
                <field name="id" invisible="0" optional="hide"/>
                <field name="force_name" optional="hide"/>
                <field name="active" class="open_line" optional="hide"/>
                <field name="is_key" class="open_line" optional="hide"/>
                <field name="step_id" invisible="1"/>
                <field name="parent_id" domain="[('id','!=',id),('step_id', '=', step_id)]"/>
                <field name="field_source" class="open_line"/>
                <field name="action" class="open_line" optional="show"/>
                <field name="field_dest" class="open_line"/>
                <field name="skip_if_empty" optional="hide"/>
                <field name="default_value" optional="hide"/>
                <field name="filter_to_delta" optional="hide"/>
                <field name="skip_if" optional="hide"/>
                <field name="may_miss" optional="hide"/>
                <field name="format_value" optional="hide"/>
                <field name="no_create" optional="hide"/>
                <field name="no_update" optional="hide"/>
                <field name="output_stream" optional="hide"/>
                <field name="skip_record_expr" optional="hide"/>
                <field name="unlink_subrecords" optional="hide"/>
                <field name="comment" optional="hide"/>
                <field name="loop_records" optional="hide"/>
              </list>
            </field>
          </group>
          <button name="open_list_action" class="oe_highlight" data-hotkey="t" string="Open List" type="object"/>
          <button name="delete_all_mappings" class="btn-danger" confirm="Everything is lost." string="DELETE MAPPINGS" type="object"/>
          <notebook>
            <page string="Options">
              <group colspan="4">
                <field name="mapping_direction"/>
                <field name="can_keys"/>
                <field name="no_metadata"/>
              </group>
            </page>
          </notebook>
        </xpath>
      </field>
    </record>
    <record id="view_zbs_mapping_list" model="ir.ui.view">
      <field name="model">zbs.mapping</field>
      <field name="arch" type="xml">
        <list editable="bottom" multi_edit="1" string="">
          <field name="sequence" class="open_line" widget="handle"/>
          <field name="level" optional="hide" readonly="1"/>
          <button name="open_mapping" icon="fa-external-link" string="" title="Open Mapping" type="object"/>
          <field name="id" invisible="0" optional="hide"/>
          <field name="force_name" optional="hide"/>
          <field name="active" class="open_line" optional="hide"/>
          <field name="is_key" class="open_line" optional="hide"/>
          <field name="parent_id" domain="[('id', '!=', id), ('step_id', '=', context.get('default_step_id'))]"/>
          <field name="field_source" class="open_line"/>
          <field name="action" class="open_line" optional="show"/>
          <field name="field_dest" class="open_line"/>
          <field name="skip_if_empty" optional="hide"/>
          <field name="default_value" optional="hide"/>
          <field name="filter_to_delta" optional="hide"/>
          <field name="skip_if" optional="hide"/>
          <field name="may_miss" optional="hide"/>
          <field name="format_value" optional="hide"/>
          <field name="no_create" optional="hide"/>
          <field name="no_update" optional="hide"/>
          <field name="output_stream" optional="hide"/>
          <field name="skip_record_expr" optional="hide"/>
          <field name="unlink_subrecords" optional="hide"/>
          <field name="comment" optional="hide"/>
        </list>
      </field>
    </record>
    <record id="view_zbs_mapping_search" model="ir.ui.view">
      <field name="model">zbs.mapping</field>
      <field name="arch" type="xml">
        <search string="">
          <field name="name" filter_domain="['|', ('code', 'ilike', self), ('name', 'ilike', self)]"/>
          <searchpanel>
            <field name="parent_id" enable_counters="1" string="Mappings"/>
          </searchpanel>
        </search>
      </field>
    </record>
    <record id="view_zbs_mapping_form" model="ir.ui.view">
      <field name="name">zbs.mapping form</field>
      <field name="model">zbs.mapping</field>
      <field name="arch" type="xml">
        <form string="">
          <header>
            <button name="heartbeat" data-hotkey="h" string="Heartbeat" type="object"/>
          </header>
          <sheet>
            <a href="https://www.zebroo.de/knowledge/article/263" target="_blank">Help</a>
            <group col="4" colspan="4" string="Field Map">
              <field name="field_source" placeholder="source field"/>
              <newline/>
              <field name="action" colspan="1"/>
              <newline/>
              <field name="field_dest" colspan="1" placeholder="destination field"/>
              <hr/>
            </group>
            <group col="2" string="">
              <field name="force_name"/>
              <field name="comment"/>
              <field name="parent_id"/>
              <field name="level" readonly="1"/>
              <!-- <field name="pyfunc_id" attrs="{'required': [('action', '=', 'pyfunc')], 'invisible': [('action', '!=', 'pyfunc')]}"/>
                            <field name="code" widget="ace" options="{'model': 'python'}" attrs="{'required': [('action', '=', 'code)], 'invisible': [('action', '!=', 'code')]}"/> -->
            </group>
            <group invisible="action != 'lookup'" string="Lookup Settings">
              <field name="lookup_model" required="action == 'lookup'" string="Model"/>
              <newline/>
              <field name="lookup_field" required="action == 'lookup'" string="Field"/>
              <newline/>
              <field name="lookup_operator" required="action == 'lookup'" string="Operator"/>
              <newline/>
              <field name="lookup_use_cache"/>
              <newline/>
              <field name="lookup_action_on_no_match" required="action == 'lookup'"/>
            </group>
            <group invisible="action != 'lookup'">
              <field name="lookup_model" required="action == 'lookup'"/>
              <field name="lookup_field" required="action == 'lookup'"/>
              <field name="lookup_operator" required="action == 'lookup'"/>
              <field name="lookup_action_on_no_match" required="action == 'lookup'"/>
            </group>
            <group col="2" colspan="4" invisible="action != 'lookup'">
              <ul colspan="2">
                <li>
                                    If base data has several items in  the field separated by comm, then split the values in the
                                pre filter like "value.split(',')". Then the recordset is interpreted as several string values
                                and if destination is a many2many field, then those values are all set.
                                </li>
              </ul>
            </group>
            <separator/>
            <notebook>
              <page invisible="action != 'mapped_values'" string="Mapped Values">
                <group>
                  <field name="strict_mapped_types"/>
                </group>
                <field name="mapped_value_ids" nolabel="1">
                  <list editable="bottom">
                    <field name="source_value"/>
                    <field name="dest_value"/>
                    <field name="default_value"/>
                  </list>
                </field>
              </page>
              <page invisible="action != 'eval'" string="Code">
                <field name="code" nolabel="1" options="{'mode': 'python'}" widget="ace"/>
                <div>
                  <ul>
                    <li>
                                            record
                                        </li>
                    <li>
                                            mapped
                                        </li>
                    <li>
                                            value
                                        </li>
                    <li>
                                            raise SkipRecord()
                                        </li>
                  </ul>
                </div>
              </page>
              <page string="Skip Record">
                <group col="1">
                  <field name="skip_record_expr" nolabel="1" widget="ace"/>
                  <div>
                                        If condition is met, then the record is skipped.
                                    </div>
                  <div>
                    <ul>
                      <li>
                                                record
                                            </li>
                      <li>
                                                mapped
                                            </li>
                      <li>
                                                value
                                            </li>
                    </ul>
                  </div>
                </group>
              </page>
              <page string="Children">
                <field name="child_ids" context="{'active_test': False, 'no_js_click': True}" nolabel="1">
                  <list editable="bottom">
                    <field name="id" invisible="0"/>
                    <field name="force_name"/>
                    <field name="parent_id"/>
                    <field name="sequence" widget="handle"/>
                    <field name="active"/>
                    <field name="is_key" widget="toggle_boolean"/>
                    <field name="field_source"/>
                    <field name="action"/>
                    <field name="field_dest"/>
                    <field name="unlink_subrecords"/>
                  </list>
                </field>
              </page>
              <page string="Format Filter">
                <div>
                                    This filter is applied at getting the information from the source record sets.
                                </div>
                <field name="format_value" nolabel="1" placeholder="str(value).strip()" widget="ace"/>
                <details>
                  <summary>
                                        examples
                                    </summary>
                  <ul>
                    <li>
                      <pre>
                                                value = str(value)
if value == "None":
....value = False
value
                                            </pre>
                    </li>
                    <li>
                                            If you use multi-line, then the last statement should be 'value'
                                        </li>
                  </ul>
                </details>
              </page>
              <page string="Details">
                <group col="4">
                  <field name="is_key"/>
                  <field name="may_miss"/>
                  <field name="skip_if_empty"/>
                  <field name="filter_to_delta"/>
                  <field name="default_value"/>
                  <field name="skip_if"/>
                  <field name="no_create"/>
                  <field name="no_update"/>
                  <field name="output_stream"/>
                  <field name="unlink_subrecords"/>
                  <field name="loop_records"/>
                </group>
              </page>
            </notebook>
          </sheet>
          <chatter/>
        </form>
      </field>
    </record>
    <record id="list_map_values" model="ir.ui.view">
      <field name="model">zbs.mapping.mapvalues</field>
      <field name="arch" type="xml">
        <list editable="bottom">
          <field name="source_value"/>
          <field name="dest_value"/>
          <field name="strict_types"/>
          <field name="default_value"/>
        </list>
      </field>
    </record>
  </data>
</odoo>
