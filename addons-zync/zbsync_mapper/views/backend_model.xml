<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="backend_model_form" model="ir.ui.view">
      <field name="name">zbs.backend.model form</field>
      <field name="model">zbs.backend.model</field>
      <field name="arch" type="xml">
        <form>
          <header>
            <h1>
              <field name="name"/>
            </h1>
          </header>
          <sheet>
            <group colspan="4">
              <field name="group_id"/>
              <div>Please put valid JSON, XML or Yaml data into this field to generate access the Backend Model</div>
              <field name="backend_value"/>
              <div>Please Select the corresponding data type to allow for correct parsing</div>
              <field name="backend_value_type"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>
    <record id="backend_model_tree" model="ir.ui.view">
      <field name="name">zbs.backend.model tree</field>
      <field name="model">zbs.backend.model</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="group_id"/>
        </list>
      </field>
    </record>
  </data>
</odoo>
