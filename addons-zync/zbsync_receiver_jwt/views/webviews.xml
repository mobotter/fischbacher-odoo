<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="zbs_receive_authorizer_form" model="ir.ui.view">
      <field name="model">zbs.receive.authorizer</field>
      <field name="inherit_id" ref="zbsync_receiver.zbs_receive_authorizer_form"/>
      <field name="arch" type="xml">
        <header>
          <button name="make_rsa_keys" class="oe_stat_button" string="Make RSA Keys" type="object"/>
        </header>
        <notebook>
          <page name="jwt" colspan="2" invisible="auth_type != 'jwt'" string="JWT">
            <group colspan="2">
              <field name="private_key" password="True"/>
              <field name="pub_key"/>
            </group>
          </page>
        </notebook>
      </field>
    </record>
  </data>
</odoo>
