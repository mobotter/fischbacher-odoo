<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="view_zbs_connection_odoo_form" model="ir.ui.view">
      <field name="name">zbs.connection.odoo form</field>
      <field name="model">zbs.connection.odoo</field>
      <field name="arch" type="xml">
        <form string="">
          <header/>
          <sheet>
            <div class="oe_title">
              <h1>
                <field name="name" colspan="4" class="oe_inline"/>
              </h1>
            </div>
            <group string="" col="2">
              <field name="host"/>
              <field name="port"/>
              <field name="ssl"/>
              <field name="timeout"/>
              <field name="dbname"/>
              <field name="username"/>
              <field name="password" password="True"/>
              <field name="basic_auth_username"/>
              <field name="basic_auth_password" password="True"/>
              <field name="proxy_ids" widget="many2many_tags"/>
              <field name="lang_id"/>
              <field name="context"/>
              <field name="version"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>
    <record id="view_zbs_connection_odoo_list" model="ir.ui.view">
      <field name="model">zbs.connection.odoo</field>
      <field name="arch" type="xml">
        <list default_order="" string="">
          <field name="host"/>
          <field name="port"/>
          <field name="username"/>
        </list>
      </field>
    </record>
  </data>
</odoo>
