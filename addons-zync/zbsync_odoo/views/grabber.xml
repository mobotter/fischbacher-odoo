<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <record id="view_zbs_grabber_odoo_form" model="ir.ui.view">
      <field name="name">zbs.grabber.odoo form</field>
      <field name="model">zbs.grabber.odoo</field>
      <field name="inherit_id" ref="zbsync.worker_form"/>
      <field name="mode">primary</field>
      <field name="arch" type="xml">
        <xpath expr="//group[@name='maingroup']" position="inside">
          <group col="2" string="">
            <field name="connection_id"/>
            <field name="model"/>
            <field invisible="1" name="is_local_connection"/>
            <field name="odoo_as"/>
            <field invisible="odoo_as == 'browse'" name="fields_to_read"/>
            <field name="lang_id"/>
            <field name="context"/>
          </group>
          <separator string="Domain"/>
          <field name="domain_ids" nolabel="0">
            <list>
              <field name="name"/>
              <field name="usage"/>
              <field name="domain"/>
            </list>
          </field>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
