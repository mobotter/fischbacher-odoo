<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="view_of_zync_pipeline_form" model="ir.ui.view">
      <field name="name">of.zync.pipeline form</field>
      <field name="model">of.zync.pipeline</field>
      <field name="inherit_id" ref="odoo_flows.base_item_form"/>
      <field name="mode">primary</field>
      <field name="arch" type="xml">
        <xpath expr="//page[@name='item_content']" position="inside">
          <group>
            <field name="pipeline_id"/>
            <field name="zbs_instance_id"/>
            <field name="run_type"/>
          </group>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
