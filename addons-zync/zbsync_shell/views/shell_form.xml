<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="zbs_shell_form" model="ir.ui.view">
      <field name="name">zbs.shell form</field>
      <field name="model">zbs.shell</field>
      <field name="inherit_id" ref="zbsync.worker_form"/>
      <field name="mode">primary</field>
      <field name="arch" type="xml">
        <header position="inside">
          <button name="make_keys" confirm="Overwrite existing keys?" string="Make Keys" type="object"/>
        </header>
        <xpath expr="//group[@name='maingroup']" position="replace">
          <notebook>
            <page name="code" string="Code">
              <group col="4" string="">
                <field name="code" nolabel="1" required="1" widget="ace"/>
              </group>
              <details>
                <summary>Available Objects:</summary>
                <ul>
                  <li>index: int - number in record; 0 based</li>
                  <li>record: the currently processed source record</li>
                  <li>input: the complete input data to this worker</li>
                </ul>
                <h2>Examples</h2>
                <ul>
                  <li>
                    <pre>/todos/{record.id}</pre>
                  </li>
                  <li>
                    <pre>/todos/{record.id}</pre>
                  </li>
                  <li>
                    <pre>
path = "/todos/put"
if record.f1 == 'v1':
    path += "/addonstuff"
path
                                    </pre>
                  </li>
                </ul>
              </details>
            </page>
            <page name="settings" string="Settings">
              <group string="SSH">
                <field name="ssh_host"/>
                <field name="ssh_username"/>
                <field name="ssh_port"/>
                <field name="ssh_private_key"/>
                <field name="ssh_pubkey"/>
              </group>
              <group>
                <field name="cwd"/>
              </group>
            </page>
          </notebook>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
