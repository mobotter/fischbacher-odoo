<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="view_zbs_transformer_form1" model="ir.ui.view">
      <field name="name">zbs.transformer form</field>
      <field name="model">zbs.transformer.xml</field>
      <field name="inherit_id" ref="zbsync.worker_form"/>
      <field name="mode">primary</field>
      <field name="arch" type="xml">
        <xpath expr="//group[@name='maingroup']" position="replace">
          <group>
            <field name="ttype"/>
            <field name="show_ui_root_element" invisible="1"/>
            <field name="root_element_name" invisible="not show_ui_root_element"/>
            <div colspan="2">
              <h3>Some hints</h3>
              <ul>
                <li>If you leave the root element empty, then the content which is usually inbetween the enclosing tags, is written to the batch</li>
              </ul>
            </div>
          </group>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
