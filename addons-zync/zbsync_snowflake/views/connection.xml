<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="view_zbs_connection_snowflake_form" model="ir.ui.view">
      <field name="name">zbs.connection.snowflake form</field>
      <field name="model">zbs.connection.snowflake</field>
      <field name="arch" type="xml">
        <form string="">
          <header/>
          <sheet>
            <div class="oe_title">
              <h1>
                <field name="name" class="oe_inline" colspan="4"/>
              </h1>
            </div>
            <group col="2" string="">
              <field name="account"/>
              <field name="database"/>
              <field name="schema"/>
              <field name="warehouse"/>
              <field name="username"/>
              <field name="password" password="True"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>
    <record id="view_zbs_connection_snowflake_list" model="ir.ui.view">
      <field name="model">zbs.connection.snowflake</field>
      <field name="arch" type="xml">
        <list default_order="" string="">
          <field name="account"/>
          <field name="username"/>
          <field name="database"/>
          <field name="warehouse"/>
        </list>
      </field>
    </record>
  </data>
</odoo>
