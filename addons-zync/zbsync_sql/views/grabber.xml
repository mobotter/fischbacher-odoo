<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="view_zbs_grabber_grabber_form" model="ir.ui.view">
      <field name="name">zbs.grabber.grabber form</field>
      <field name="model">zbs.grabber.sql</field>
      <field name="inherit_id" ref="zbsync.worker_form"/>
      <field name="mode">primary</field>
      <field name="arch" type="xml">
        <xpath expr="//group[@name='maingroup']" position="replace">
          <group col="2" string="">
            <field name="connection_id"/>
          </group>
          <group col="2" string="SQL">
            <field name="sql" colspan="2" nolabel="1" widget="ace">

                        </field>
            <div colspan="2">
              <p>Usage:</p>
              <ul>
                <li>{where} - compiled where clause from domain like: 'SELECT * FROM x WHERE {where}'</li>
              </ul>
            </div>
          </group>
          <group string="Domains">
            <field name="domain_ids" colspan="2" nolabel="1">
              <list editable="bottom">
                <field name="name"/>
                <field name="usage"/>
                <field name="domain"/>
              </list>
            </field>
          </group>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
