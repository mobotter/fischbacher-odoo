<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="zbs_pipeline_fileupload_tree" model="ir.ui.view">
      <field name="model">zbs.pipeline.fileupload</field>
      <field name="arch" type="xml">
        <list default_order="" string="">
          <field name="pipeline_id"/>
        </list>
      </field>
    </record>
    <record id="zbs_pipeline_fileupload_form" model="ir.ui.view">
      <field name="name">zbs.pipeline.fileupload form</field>
      <field name="model">zbs.pipeline.fileupload</field>
      <field name="arch" type="xml">
        <form string="">
          <header>
            <button name="create_entry" string="Create Entry" type="object"/>
          </header>
          <sheet>
            <group colspan="2" string="File Upload Dialog">
              <field name="pipeline_id"/>
              <field name="parent_menu_id"/>
            </group>
            <group colspan="2" string="Menu Items">
              <field name="created_menu_item_ids" colspan="2" nolabel="1"/>
            </group>
            <group colspan="2" string="Window Actions">
              <field name="created_window_action_ids" colspan="2" nolabel="1"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>
  </data>
</odoo>
