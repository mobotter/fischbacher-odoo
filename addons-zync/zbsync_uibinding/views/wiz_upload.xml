<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="view_zbs_wiz_fileupload_form" model="ir.ui.view">
      <field name="name">zbs.wiz.fileupload form</field>
      <field name="model">zbs.wiz.fileupload</field>
      <field name="arch" type="xml">
        <form string="">
          <header/>
          <sheet>
            <group col="4" string="Upload">
              <field name="filecontent" filename="filename"/>
              <field name="filename" invisible="1"/>
            </group>
          </sheet>
          <footer>
            <button name="ok" data-hotkey="q" string="OK" type="object"/>
            <button class="oe_link" data-hotkey="z" special="cancel" string="Cancel"/>
          </footer>
        </form>
      </field>
    </record>
  </data>
</odoo>
