<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="view_zbs_mapper_form_inherit" model="ir.ui.view">
      <field name="name">zbs.mapper form</field>
      <field name="model">zbs.mapper</field>
      <field name="inherit_id" ref="zbsync_mapper.view_zbs_mapper_form"/>
      <field name="arch" type="xml">
        <xpath expr="//notebook" position="inside">
          <page string="Import Mappings">
            <span colspan="4">
              <group name="Import Mappings" colspan="4">
                <button name="import_mappings" class="oe_highlight" colspan="2" string="Import Mappings" type="object"/>
                <field name="example_value_type"/>
                <field name="example_value"/>
              </group>
            </span>
          </page>
        </xpath>
      </field>
    </record>
    <record id="zbs_instance_line_batch_form_inherit" model="ir.ui.view">
      <field name="name">zbs.instance.line.batch form inherit</field>
      <field name="model">zbs.instance.line.batch</field>
      <field name="inherit_id" ref="zbsync.zbs_instance_line_batch_form"/>
      <field name="arch" type="xml">
        <xpath expr="//details" position="before">
          <group colspan="4" string="Mapping Json">
            <span colspan="4">
              <button name="generate_mapping_json" class="oe_highlight" colspan="2" invisible="1" string="Generate Mapping JSON" type="object"/>
            </span>
            <span colspan="4">
              <field name="mapping_json" widget="ace"/>
            </span>
            <button name="copy_to_next_mapper" class="oe_highlight" colspan="2" string="Copy to next Mapper" type="object"/>
          </group>
        </xpath>
      </field>
    </record>
    <record id="view_zbs_mapper_list" model="ir.ui.view">
      <field name="name">zbs.mapper list</field>
      <field name="model">zbs.mapper</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="mapping_direction"/>
          <field name="no_metadata"/>
          <field name="comment"/>
          <field name="pipeline_ids" widget="many2many_tags"/>
          <field name="mapping_ids" widget="many2many_tags"/>
          <field name="example_value" optional="hide"/>
          <field name="example_value_type" optional="hide"/>
        </list>
      </field>
    </record>
  </data>
</odoo>
