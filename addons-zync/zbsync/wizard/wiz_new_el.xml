<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="view_zbs_wiz_new_el_form" model="ir.ui.view">
      <field name="name">zbs.wiz.new.el form</field>
      <field name="model">zbs.wiz.new.el</field>
      <field name="arch" type="xml">
        <form string="">
          <header/>
          <sheet>
            <group col="2" string="">
              <field name="pipeline_id" readonly="1"/>
              <field name="model_id" domain="[('id', 'in', filter_model_ids)]" options="{'no_create': True, 'no_quick_create': True}"/>
              <field name="filter_model_ids" invisible="1"/>
            </group>
          </sheet>
          <footer>
            <button name="ok" data-hotkey="q" string="OK" type="object"/>
            <button class="oe_link" data-hotkey="z" special="cancel" string="Cancel"/>
          </footer>
        </form>
      </field>
    </record>
  </data>
</odoo>
