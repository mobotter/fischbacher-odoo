<?xml version="1.0"?>
<odoo>
  <data>
    <record id="view_zbs_cronstart_tree" model="ir.ui.view">
      <field name="model">zbs.cronstart</field>
      <field name="arch" type="xml">
        <list>
          <field name="id" invisible="1"/>
          <field name="name"/>
          <field name="no_double_starts"/>
          <field name="cronstart_pipeline_ids" widget="many2many_tags"/>
          <button name="open_cronjobs" string="Cron-Jobs" type="object"/>
        </list>
      </field>
    </record>
    <record id="view_zbs_cronstart_form" model="ir.ui.view">
      <field name="name">zbs.cronstart form</field>
      <field name="model">zbs.cronstart</field>
      <field name="arch" type="xml">
        <form string="">
          <header/>
          <sheet>
            <group col="2" string="">
              <field name="name"/>
              <field name="cronstart_pipeline_ids" widget="many2many_tags"/>
              <field name="no_double_starts"/>
            </group>
            <field name="cronjob_ids" context="{                             'active_test': False,                             'default_interval_type': 'hours',                             'default_cronstart_id': id,                             'default_model_id': 'zbs.cronstart',                             'active_test': False,                         }" nolabel="1">
              <list editable="bottom">
                <field name="name" invisible="1"/>
                <field name="interval_number"/>
                <field name="interval_type"/>
                <field name="nextcall"/>
                <field name="active" invisible="1"/>
                <field name="model_id" invisible="1"/>
              </list>
            </field>
          </sheet>
        </form>
      </field>
    </record>
  </data>
</odoo>
