<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="zbs_env_xport_form" model="ir.ui.view">
      <field name="name">zbs.env.xport form</field>
      <field name="model">zbs.env.xport</field>
      <field name="arch" type="xml">
        <form string="">
          <header/>
          <sheet>
            <group col="2" string="Import/Export">
              <field name="mode"/>
              <field name="environment_ids" invisible="mode != 'export'" widget="many2many_tags"/>
              <field name="file_content" filename="filename"/>
              <field name="filename" invisible="1"/>
            </group>
          </sheet>
          <footer>
            <button name="do_import" invisible="mode != 'import'" string="Import (please upload file)" type="object"/>
            <button name="do_export" invisible="mode != 'export'" string="Export Data to file" type="object"/>
          </footer>
        </form>
      </field>
    </record>
  </data>
</odoo>
