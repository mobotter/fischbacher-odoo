<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="zbs_instance_logs_tree" model="ir.ui.view">
      <field name="model">zbs.instance.logs</field>
      <field name="arch" type="xml">
        <list default_order="" string="">
          <field name="instance_id"/>
          <field name="line_id"/>
          <field name="batch_id"/>
          <field name="date_start"/>
          <field name="date_stop"/>
          <field name="duration"/>
          <field name="last_exception"/>
        </list>
      </field>
    </record>
    <record id="view_zbs_instance_logs_form" model="ir.ui.view">
      <field name="name">zbs.instance.logs form</field>
      <field name="model">zbs.instance.logs</field>
      <field name="arch" type="xml">
        <form string="">
          <header/>
          <sheet>
            <group col="4" string="Details">
              <field name="instance_id"/>
              <field name="line_id"/>
              <field name="batch_id"/>
              <field name="date_start"/>
              <field name="date_stop"/>
              <field name="duration"/>
            </group>
            <notebook>
              <page invisible="last_exception == False" string="Exception">
                <field name="last_exception"/>
              </page>
              <page invisible="formatted_output in ['', False]" string="Formatted Output">
                <field name="formatted_output" options="{'mode': 'python'}" widget="ace"/>
              </page>
              <page string="Output">
                <field name="output_data"/>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>
  </data>
</odoo>
