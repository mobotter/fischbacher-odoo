<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="zbs_instance_line_batch_form" model="ir.ui.view">
      <field name="name">zbs.instance.line.batch form</field>
      <field name="model">zbs.instance.line.batch</field>
      <field name="arch" type="xml">
        <form string="">
          <header>
            <button name="heartbeat_ui" data-hotkey="p" string="Play" type="object"/>
            <button name="open_logs" data-hotkey="l" string="Open Logs" type="object"/>
            <field name="state" widget="statusbar"/>
          </header>
          <sheet>
            <group string="Batch Identification">
              <field name="id"/>
              <field name="instance_id"/>
              <field name="line_id"/>
              <field name="started_sub_instance_id"/>
            </group>
            <group groups="base.group_no_one" string="How to debug">
              <field name="how_to_debug" nolabel="1" readonly="1"/>
            </group>
            <notebook>
              <page name="error" invisible="not err_desc" string="Error">
                <field name="err_desc"/>
              </page>
              <page name="output" string="Output Data">
                <h3>
                                Output Data
                                </h3>
                <details>
                  <field name="output_data"/>
                </details>
              </page>
              <page name="input" string="Input Data">
                <field name="input_data"/>
              </page>
              <page col="4" string="Runtime">
                <group colspan="2">
                  <field name="duration" readonly="1"/>
                  <field name="started" readonly="1"/>
                  <field name="stopped" readonly="1"/>
                  <field name="start" readonly="1"/>
                  <field name="stop" readonly="1"/>
                  <field name="length" readonly="1"/>
                  <field name="processed_records" readonly="1"/>
                  <field name="done_tries" readonly="1"/>
                </group>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>
    <record id="zbs_instance_line_batch_tree" model="ir.ui.view">
      <field name="model">zbs.instance.line.batch</field>
      <field name="arch" type="xml">
        <list decoration-danger="state=='failed'" decoration-success="state == 'success'" default_order="id desc" string="">
          <button name="heartbeat_ui" string="Play" type="object"/>
          <field name="name"/>
          <field name="create_date"/>
          <field name="state"/>
          <field name="start"/>
          <field name="stop"/>
          <field name="length"/>
          <field name="duration"/>
          <field name="started"/>
          <field name="stopped"/>
          <field name="started_sub_instance_id"/>
        </list>
      </field>
    </record>
    <record id="zbs_instance_line_batch_tree" model="ir.ui.view">
      <field name="model">zbs.instance.line.batch</field>
      <field name="arch" type="xml">
        <list decoration-danger="state=='failed'" decoration-success="state == 'success'" default_order="" string="">
          <button name="heartbeat_ui" string="Play" type="object"/>
          <field name="name"/>
          <field name="state"/>
          <field name="start"/>
          <field name="stop"/>
          <field name="length"/>
        </list>
      </field>
    </record>
    <record id="zbs_instance_line_batch_tree" model="ir.ui.view">
      <field name="model">zbs.instance.line.batch</field>
      <field name="arch" type="xml">
        <list decoration-danger="state=='failed'" decoration-success="state == 'success'" default_order="" string="">
          <button name="heartbeat_ui" string="Play" type="object"/>
          <field name="name"/>
          <field name="state"/>
          <field name="start"/>
          <field name="stop"/>
          <field name="length"/>
        </list>
      </field>
    </record>
    <record id="zbs_instance_line_batch_tree" model="ir.ui.view">
      <field name="model">zbs.instance.line.batch</field>
      <field name="arch" type="xml">
        <list decoration-danger="state=='failed'" decoration-success="state == 'success'" default_order="" string="">
          <button name="heartbeat_ui" string="Play" type="object"/>
          <field name="name"/>
          <field name="state"/>
          <field name="start"/>
          <field name="stop"/>
          <field name="length"/>
        </list>
      </field>
    </record>
    <record id="zbs_instance_line_batch_tree" model="ir.ui.view">
      <field name="model">zbs.instance.line.batch</field>
      <field name="arch" type="xml">
        <list decoration-danger="state=='failed'" decoration-success="state == 'success'" default_order="" string="">
          <button name="heartbeat_ui" string="Play" type="object"/>
          <field name="name"/>
          <field name="state"/>
          <field name="start"/>
          <field name="stop"/>
          <field name="length"/>
        </list>
      </field>
    </record>
    <record id="zbs_instance_line_batch_tree" model="ir.ui.view">
      <field name="model">zbs.instance.line.batch</field>
      <field name="arch" type="xml">
        <list decoration-danger="state=='failed'" decoration-success="state == 'success'" default_order="" string="">
          <button name="heartbeat_ui" string="Play" type="object"/>
          <field name="name"/>
