      </field>
    </record>
    <record id="zbs_instance_line_batch_tree_extended" model="ir.ui.view">
      <field name="model">zbs.instance.line.batch</field>
      <field name="arch" type="xml">
        <list decoration-danger="state=='failed'" decoration-success="state == 'success'" default_order="" string="">
          <button name="heartbeat_ui" string="Play" type="object"/>
          <field name="instance_id"/>
          <field name="worker_id"/>
          <field name="name"/>
          <field name="state"/>
          <field name="start"/>
          <field name="stop"/>
          <field name="length"/>
          <field name="duration"/>
          <field name="started"/>
          <field name="stopped"/>
          <field name="started_sub_instance_id"/>
        </list>
      </field>
    </record>
    <record id="view_zbs_instance_line_batch_search" model="ir.ui.view">
      <field name="model">zbs.instance.line.batch</field>
      <field name="arch" type="xml">
        <search string="">
          <filter name="group_by_instance_id" context="{'group_by':'instance_id'}" domain="[]" string="Instance"/>
          <filter name="group_by_worker_id" context="{'group_by':'worker_id'}" domain="[]" string="Worker"/>
          <filter name="group_by_state" context="{'group_by':'state'}" domain="[]" string="State"/>
        </search>
      </field>
    </record>
  </data>
</odoo>
