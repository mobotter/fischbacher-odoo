<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="view_zbs_pipeline_instance_tree" model="ir.ui.view">
      <field name="model">zbs.instance</field>
      <field name="arch" type="xml">
        <list default_order="" string="">
          <field name="pipeline_id"/>
          <field name="environment_id"/>
          <field name="name"/>
          <field name="success_quote"/>
          <field name="state"/>
          <field name="next_line_id"/>
          <field name="origin"/>
          <field name="test_mode"/>
          <field name="effective_paused"/>
          <field name="date_start"/>
          <field name="date_stop"/>
          <field name="last_heartbeat"/>
          <field name="no_cron_start" optional="hide"/>
        </list>
      </field>
    </record>
    <record id="view_zbs_instance_form" model="ir.ui.view">
      <field name="name">zbs.instance form</field>
      <field name="model">zbs.instance</field>
      <field name="arch" type="xml">
        <form string="">
          <header>
            <button name="heartbeat_ui" data-hotkey="g" string="Go" type="object"/>
            <button name="clear_messages" string="Clear Wall" type="object"/>
            <field name="state" readonly="1" widget="statusbar"/>
            <button name="abort" data-hotkey="shift+a" invisible="state not in ['running', 'pending']" string="Abort" type="object"/>
            <button name="retry" data-hotkey="shift+r" invisible="state not in ['success', 'failed']" string="Retry" type="object"/>
            <field name="effective_paused" invisible="1"/>
            <field name="has_subinstances" invisible="1"/>
            <button name="open_sub_instances" invisible="not has_subinstances" string="Open Sub-Instances" type="object"/>
          </header>
          <div class="alert alert-info" invisible="not effective_paused" role="alertdialog">
                        Paused - all instances stopped
                    </div>
          <sheet>
            <group col="4">
              <field name="pipeline_id"/>
              <field name="environment_id"/>
              <field name="create_date"/>
              <field name="tag_ids" options="{'color_field': 'color'}" widget="many2many_tags"/>
              <label for="test_mode"/>
              <div>
                <field name="test_mode"/>
                <a href="https://www.zebroo.de/knowledge/article/269" target="_blank">
                                    Online Help
                                </a>
              </div>
              <field name="no_cron_start"/>
              <field name="paused"/>
            </group>
            <notebook>
              <page string="Flow">
                <group col="2">
                  <!-- <field name="pipeline_line_id" groups="base.group_no_one" domain="[('pipeline_id', '=', pipeline_id)]"/> -->
                  <field name="line_ids" colspan="2" context="{'zbs_instance_id': id}" nolabel="1">
                    <list create="0" decoration-bf="is_current" decoration-danger="has_failed" decoration-sucess="only_success">
                      <button name="make_current" icon="fa-play" string="" title="Make current line" type="object"/>
                      <field name="id" invisible="1"/>
                      <field name="can_open_worker_detail" invisible="1"/>
                      <field name="is_current" invisible="1"/>
                      <field name="sequence" widget="handle"/>
                      <field name="ttype_name"/>
                      <field name="worker_id"/>
                      <field name="keep_input_filter" class="open_line"/>
                      <field name="enabled"/>
                      <button name="open_logs" icon="fa-history" string="" title="Open Logs" type="object"/>
                      <button name="open_logs_list" icon="fa-list" string="" title="Open Logs in list-view" type="object"/>
                      <button name="open_line" string="Line Details" type="object"/>
                      <field name="processed_records" readonly="1"/>
                      <field name="batches" class="open_batches"/>
                      <field name="range" class="open_line" optional="hide"/>
                      <field name="output_range" class="open_line" optional="hide"/>
                      <field name="ffilter" class="open_line" optional="hide"/>
                      <field name="output_ffilter" class="open_line" optional="hide"/>
                      <field name="only_success" invisible="1"/>
                      <field name="has_failed" invisible="1"/>
                    </list>
                  </field>
                </group>
              </page>
              <page name="initial_data" string="Initial Data">
                <field name="initial_data"/>
              </page>
              <page name="environment" string="Environment">
                <field name="environment"/>
              </page>
            </notebook>
          </sheet>
          <chatter/>
        </form>
      </field>
    </record>
    <record id="view_zbs_instance_search" model="ir.ui.view">
      <field name="model">zbs.instance</field>
      <field name="arch" type="xml">
        <search string="">
          <field name="name"/>
          <field name="id"/>
          <field name="tag_ids"/>
          <filter name="error" domain="[('state', '=', 'failed')]" string="Error"/>
          <filter name="done" domain="[('state', '=', 'success')]" string="Success"/>
          <filter name="group_by_tags" context="{'group_by':'tag_ids'}" domain="[]" string="Tags"/>
          <filter name="group_by_state" context="{'group_by':'state'}" domain="[]" string="State"/>
          <filter name="group_by_pipeline" context="{'group_by':'pipeline_id'}" domain="[]" string="Pipeline"/>
          <filter name="group_by_start" context="{'group_by':'date_start'}" domain="[]" string="Date Started"/>
        </search>
      </field>
    </record>
    <record id="view_zbs_instance_line_form" model="ir.ui.view">
      <field name="name">zbs.instance.line form</field>
      <field name="model">zbs.instance.line</field>
      <field name="inherit_id" ref="view_zbs_pipeline_line_form"/>
      <field name="mode">primary</field>
      <field name="arch" type="xml">
        <data/>
      </field>
    </record>
  </data>
</odoo>
