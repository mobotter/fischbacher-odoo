<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="zbs_pipeline_pusher" model="ir.cron">
      <field name="name">zbs_pipeline_pusher</field>
      <field name="interval_number">1</field>
      <field name="interval_type">minutes</field>
      <field name="model_id" ref="model_zbs_instance"/>
      <field name="state">code</field>
      <field name="code">model.cron_heartbeat()</field>
      <field name="nextcall" eval="'2022-01-01 20:15:00'"/>
    </record>
    <record id="zbs_gc" model="ir.cron">
      <field name="name">zbs_gc</field>
      <field name="interval_number">1</field>
      <field name="interval_type">hours</field>
      <field name="model_id" ref="model_zbs_instance"/>
      <field name="state">code</field>
      <field name="code">model._cron_gc_cleanup()</field>
      <field name="nextcall" eval="'2022-01-01 20:15:00'"/>
    </record>
    <record id="zbs_gc_vacuum" model="ir.cron">
      <field name="name">zbs_gc_vacuum</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="model_id" ref="model_zbs_instance"/>
      <field name="state">code</field>
      <field name="code">model._cron_gc_vacuum()</field>
      <field name="nextcall" eval="'2022-01-01 22:15:00'"/>
    </record>
    <record id="call_home" model="ir.cron">
      <field name="name">zync:call_home</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="model_id" ref="model_zbs_call_base"/>
      <field name="state">code</field>
      <field name="code">model._call_base()</field>
      <field name="nextcall" eval="'2022-01-01 20:15:00'"/>
      <field name="active" eval="True"/>
    </record>
  </data>
</odoo>
